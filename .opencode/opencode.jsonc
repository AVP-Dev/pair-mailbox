{
  "$schema": "https://opencode.ai/config.json",

  "instructions": ["AGENTS.md", "docs/PROTOCOL.md"],

  // MCP pair-сервера здесь НЕТ — намеренно. Проектный конфиг читает ЛЮБОЙ CLI
  // с opencode-discovery (omp/pi), запущенный из корня репо, и ключ `pair`
  // с ролью внутри подменяет его собственную роль (живой случай 2026-10-07:
  // процесс omp поднял server.py --role opencode и потерял write authority).
  // Роль раздаёт только user-конфиг ~/.config/opencode/opencode.jsonc,
  // который ставит install.sh. Подробнее: docs/SETUP.md «Чужие CLI читают наши конфиги».

  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "ask"
  },

  "agent": {
    "plan": {
      "permission": {
        "edit": "deny"
      }
    }
  }
}