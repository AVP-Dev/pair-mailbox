{
  "$schema": "https://opencode.ai/config.json",

  "instructions": ["AGENTS.md", "docs/PROTOCOL.md"],

  "mcp": {
    "pair": {
      "type": "local",
      "command": ["sh", "mcp/pair_mailbox/serve.sh", "opencode"],
      "enabled": true,
      "timeout": 20000
    }
  },

  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "ask"
  },

  "agent": {
    "plan": {
      "permission": {
        "edit": "deny"
      }
    }
  }
}