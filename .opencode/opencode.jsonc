{
  "$schema": "https://opencode.ai/config.json",

  "instructions": ["AGENTS.md", "docs/PROTOCOL.md"],

  // No pair-server MCP here — on purpose. ANY CLI with opencode-discovery
  // (omp/pi) launched from the repo root reads the project config, and the
  // `pair` key with a role inside swaps its own role (live case 2026-10-07: the
  // omp process raised server.py --role opencode losing write authority).
  // Only the user config ~/.config/opencode/opencode.jsonc deals the role, placed
  // by install.sh. Details: docs/SETUP.md "Foreign CLIs read our configs".

  // The pair runs with no human (§7b auto): routine runs never ask.
  // The edge is deny the human sees and changes. A ready block from §13c.
  "permission": {
    "bash": {
      "*": "allow",
      "sudo *": "deny", "curl *": "deny", "wget *": "deny",
      "pip install *": "deny", "npm install *": "deny", "npm publish *": "deny",
      "ssh *": "deny", "docker *": "deny", "kubectl *": "deny",
      "terraform *": "deny", "helm *": "deny", "mkfs*": "deny", "killall *": "deny",
      "git push *main*": "deny", "git push *master*": "deny", "git push --force*": "deny",
      "git reset --hard *": "deny", "git clean -f*": "deny", "git filter-branch *": "deny"
    },
    "edit": "ask",
    "webfetch": "ask"
  },

  "agent": {
    "plan": {
      "permission": {
        "edit": "deny"
      }
    }
  }
}