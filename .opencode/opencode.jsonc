{
  "$schema": "https://opencode.ai/config.json",

  "instructions": ["AGENTS.md", "docs/PROTOCOL.md"],

  // MCP pair-сервера здесь НЕТ — намеренно. Проектный конфиг читает ЛЮБОЙ CLI
  // с opencode-discovery (omp/pi), запущенный из корня репо, и ключ `pair`
  // с ролью внутри подменяет его собственную роль (живой случай 2026-10-07:
  // процесс omp поднял server.py --role opencode и потерял write authority).
  // Роль раздаёт только user-конфиг ~/.config/opencode/opencode.jsonc,
  // который ставит install.sh. Подробнее: docs/SETUP.md «Чужие CLI читают наши конфиги».

  // Пара работает без человека (§7b auto): рутинные прогоны не спрашивают.
  // Граница — deny, который человек видит и меняет. Готовый блок из §13c.
  "permission": {
    "bash": {
      "*": "allow",
      "sudo *": "deny", "curl *": "deny", "wget *": "deny",
      "pip install *": "deny", "npm install *": "deny", "npm publish *": "deny",
      "ssh *": "deny", "docker *": "deny", "kubectl *": "deny",
      "terraform *": "deny", "helm *": "deny", "mkfs*": "deny", "killall *": "deny",
      "git push *main*": "deny", "git push *master*": "deny", "git push --force*": "deny",
      "git reset --hard *": "deny", "git clean -f*": "deny", "git filter-branch *": "deny"
    },
    "edit": "ask",
    "webfetch": "ask"
  },

  "agent": {
    "plan": {
      "permission": {
        "edit": "deny"
      }
    }
  }
}