#!/usr/bin/env bash
# bin/pair-duo — Launch a dual-instance (same-CLI) pair programming session in tmux.
#
# Usage:
#   bin/pair-duo [options] <cli> [task]
#   bin/pair-duo --swap-critic <cli> --state DIR --project DIR
#
# Options:
#   --worktree    Create an isolated git worktree for the critic pane
#   --vertical    Split panes vertically (top/bottom) instead of horizontally (left/right)
#   --autonomy L  observe | semi | auto. How far the pair goes on its own. Without it
#                 the launcher resolves in this order: a line in the task
#                 ("autonomy: semi"), then .pair/autonomy, then auto.
#   --auto --semi --observe   Shorthand for --autonomy
#   --swap-critic CLI  Replace the critic pane with another CLI (limits ran out).
#                 Writer untouched (PROTOCOL §2). Needs --state + --project.
#   --pilot       Ensure the supervisor runs on this state before launching.
#                 pairup passes it always; direct calls get the same guard.
#   -h, --help    Show this help
#
# Supported CLIs:
#   opencode, agy, claude, codex, pi, omp
#
# Examples:
#   bin/pair-duo opencode "refactor auth middleware"
#   bin/pair-duo --worktree claude "add integration tests for payments"
#   bin/pair-duo agy

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd -- "$HERE/.." && pwd)"
# Defined here, not below: the standing-assignment read happens above where this
# definition stood, and a silently empty variable would mean no assignment.
STATE_PATH="${PAIR_STATE:-$ROOT/.pair}"

USE_WORKTREE=0
SPLIT_OPT="-h"
AUTONOMY_OPT=""
SWAP_CRITIC=""
WANT_PILOT=0
FLAG_STATE=""
FLAG_PROJECT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --worktree)
      USE_WORKTREE=1
      shift
      ;;
    --vertical)
      SPLIT_OPT="-v"
      shift
      ;;
    --autonomy)
      # How far the pair goes alone. With no flag `pairctl launch-autonomy` decides: a
      # line in the task, the .pair/autonomy file, else auto.
      AUTONOMY_OPT="${2:-}"
      shift 2 || { echo "error: --autonomy needs a level" >&2; exit 2; }
      ;;
    --auto|--semi|--observe)
      AUTONOMY_OPT="${1#--}"
      shift
      ;;
    --swap-critic)
      # Swapping the critic-role runner at spent limits: the writer and write authority
      # stay untouched (PROTOCOL §2 — only the human moves).
      SWAP_CRITIC="${2:-}"
      shift 2 || { echo "error: --swap-critic needs a CLI" >&2; exit 2; }
      ;;
    --pilot)
      WANT_PILOT=1
      shift
      ;;
    --state)
      FLAG_STATE="${2:-}"
      shift 2 || { echo "error: --state needs a dir" >&2; exit 2; }
      ;;
    --project)
      FLAG_PROJECT="${2:-}"
      shift 2 || { echo "error: --project needs a dir" >&2; exit 2; }
      ;;
    -h|--help)
      sed -n '2,28p' "$0" | sed 's/^# //' | sed 's/^#//'
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

# Explicit state/project beat the default: pairup calls from the project dir, not
# the autonomy repo, carrying both paths along.
if [[ -n "$FLAG_STATE" ]]; then
  STATE_PATH="$FLAG_STATE"
fi
PROJECT_ROOT_DIR="${FLAG_PROJECT:-$ROOT}"

# Supervisor before agents (RUNBOOK §3): never doubling the live one — a second
# pilot on the same state would tick in parallel doubling wakes (agy seq-475 note).
if [[ "$WANT_PILOT" -eq 1 || -n "$SWAP_CRITIC" ]]; then
  pilot_alive=0
  if command -v pgrep >/dev/null 2>&1; then
    if pgrep -f "bin/pairpilot.*--state $STATE_PATH" >/dev/null 2>&1 \
      || pgrep -f "pairpilot.*$STATE_PATH" >/dev/null 2>&1; then
      pilot_alive=1
    fi
  fi
  if [[ "$pilot_alive" -eq 0 && -f "$STATE_PATH/pilot.pid" ]]; then
    old_pid="$(cat "$STATE_PATH/pilot.pid" 2>/dev/null || true)"
    if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
      pilot_alive=1
    else
      rm -f "$STATE_PATH/pilot.pid"
    fi
  fi
  if [[ "$pilot_alive" -eq 1 ]]; then
    echo "pair-duo: the supervisor already runs, leaving it"
  else
    if [[ ! -d "$STATE_PATH" ]]; then
      echo "pair-duo: no state at $STATE_PATH — nothing for the pilot to watch" >&2
      exit 1
    fi
    nohup python3 "$HERE/pairpilot" --state "$STATE_PATH" >>"$STATE_PATH/pairpilot.log" 2>&1 &
    echo "$!" >"$STATE_PATH/pilot.pid"
    echo "pair-duo: supervisor up (pid $(cat "$STATE_PATH/pilot.pid"))"
  fi
fi

# Swap mode: a new pane with another CLI as critic. The writer stays untouched, the
# old critic pane stays with the human (Ctrl-D) — killing a foreign window by script
# is banned: an unfinished verdict may sit there.
if [[ -n "$SWAP_CRITIC" ]]; then
  case "$SWAP_CRITIC" in
    opencode|agy|claude|codex|pi|omp) ;;
    *) echo "error: unsupported CLI '$SWAP_CRITIC'" >&2; exit 2 ;;
  esac
  if [[ -z "${TMUX:-}" ]]; then
    echo "pair-duo: --swap-critic runs inside the pair tmux session" >&2
    exit 1
  fi
  writer="$("$HERE/pairctl" --state "$STATE_PATH" status 2>/dev/null \
    | python3 -c 'import json,sys; print(json.load(sys.stdin).get("writer") or "")' 2>/dev/null || true)"
  critic_cmd="$SWAP_CRITIC"
  if [[ "$SWAP_CRITIC" == "opencode" ]]; then
    critic_cmd="opencode --standalone --auto"
  fi
  echo "pair-duo: writer $writer stays, critic -> $SWAP_CRITIC"
  tmux split-window $SPLIT_OPT -c "$PROJECT_ROOT_DIR" \
    "$SHELL -c \"export PAIR_STATE='$STATE_PATH'; cd '$PROJECT_ROOT_DIR'; echo '=== PAIR CRITIC: $SWAP_CRITIC (swap) ==='; $critic_cmd\""
  echo "pair-duo: new critic $SWAP_CRITIC in the next pane; close the old critic pane yourself (Ctrl-D)"
  echo "pair-duo: write authority with $writer, untouched (PROTOCOL §2)"
  exit 0
fi

if [[ $# -lt 1 ]]; then
  echo "error: CLI name required (opencode, agy, claude, codex, pi, omp)" >&2
  echo "usage: bin/pair-duo [--worktree] <cli> [task]" >&2
  exit 2
fi

CLI="$1"
TASK="${2:-}"

case "$CLI" in
  opencode|agy|claude|codex|pi|omp)
    ;;
  *)
    echo "error: unsupported CLI '$CLI'. Supported: opencode, agy, claude, codex, pi, omp" >&2
    exit 2
    ;;
esac

if ! command -v tmux >/dev/null 2>&1; then
  echo "error: tmux is required for pair-duo" >&2
  exit 1
fi

if ! command -v "$CLI" >/dev/null 2>&1; then
  echo "warning: binary '$CLI' was not found on PATH. Proceeding anyway..." >&2
fi

# Determine launch commands per CLI
WRITER_CMD="$CLI"
CRITIC_CMD="$CLI"
if [[ "$CLI" == "opencode" ]]; then
  # opencode defaults to a shared background daemon per account;
  # --standalone ensures each window has its own local instance and MCP configuration.
  # --auto: §13c demands it in launch — with no it the project-config allow block
  # never applies, every routine run halting on a prompt (round 33, P0).
  WRITER_CMD="opencode --standalone --auto"
  CRITIC_CMD="opencode --standalone --auto"
fi

WRITER_ROLE="${CLI}-writer"
CRITIC_ROLE="${CLI}-critic"

# Autonomy mode picks once, here, before agents took their instructions. The value
# checks BEFORE launch: a typo silently ignored past start would mean the pair runs
# a mode the human never thinks, learnable only by fact.
#
case "$AUTONOMY_OPT" in
  ""|observe|semi|auto) ;;
  *)
    echo "error: --autonomy takes observe, semi or auto (got '$AUTONOMY_OPT')" >&2
    exit 2
    ;;
esac

if [[ -n "$TASK" ]]; then
  "$HERE/pairctl" --state "$STATE_PATH" task "$TASK"
fi

if [[ -n "$AUTONOMY_OPT" || -n "$TASK" ]]; then
  "$HERE/pairctl" --state "$STATE_PATH" launch-autonomy ${AUTONOMY_OPT:+--flag "$AUTONOMY_OPT"} ${TASK:+--task "$TASK"}
fi

# Authority is the human's to move (PROTOCOL §2). This script used to run
# `pairctl assign` unconditionally, so every launch silently handed the role to
# <cli>-writer — a launcher rewriting the trust boundary, which is the exact thing
# the protocol exists to prevent. Observed live: `./finish.sh` left `opencode-writer`
# as the writer while the standing arrangement still said `opencode`.
#
# So: the standing arrangement wins. Only when there is none does this script
# appoint its own writer, and then it says so out loud rather than doing it quietly.
EXISTING_WRITER="$("$HERE/pairctl" --state "$STATE_PATH" status 2>/dev/null \
  | python3 -c 'import json,sys
try:
    print((json.load(sys.stdin).get("policy") or {}).get("writer") or "")
except Exception:
    print("")' 2>/dev/null)"
CURRENT_WRITER="$("$HERE/pairctl" --state "$STATE_PATH" status 2>/dev/null \
  | python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("writer") or "")
except Exception:
    print("")' 2>/dev/null)"

if [[ -n "$EXISTING_WRITER" ]]; then
  echo "pair-duo: standing arrangement says writer=$EXISTING_WRITER, leaving authority alone."
  echo "pair-duo: if you want two copies of one CLI to hold authority, run pairctl assign yourself."
elif [[ -n "$CURRENT_WRITER" ]]; then
  echo "pair-duo: ${CURRENT_WRITER} already holds authority, leaving it alone."
else
  "$HERE/pairctl" --state "$STATE_PATH" assign "$WRITER_ROLE"
  echo "pair-duo: no standing arrangement and no writer, so I appointed $WRITER_ROLE."
fi

CRITIC_DIR="$PROJECT_ROOT_DIR"
if [[ "$USE_WORKTREE" -eq 1 ]]; then
  WT_DIR="$PROJECT_ROOT_DIR/.pair/worktrees/${CRITIC_ROLE}"
  mkdir -p "$PROJECT_ROOT_DIR/.pair/worktrees"
  if [[ -d "$WT_DIR" ]]; then
    echo "pair-duo: using existing worktree at $WT_DIR"
  else
    BRANCH_NAME="duo/${CRITIC_ROLE}-$(date +%s)"
    echo "pair-duo: creating git worktree at $WT_DIR on branch $BRANCH_NAME"
    git -C "$PROJECT_ROOT_DIR" worktree add "$WT_DIR" -b "$BRANCH_NAME"
  fi
  CRITIC_DIR="$WT_DIR"
fi

# Check if we are already inside a tmux session
IN_TMUX=0
if [[ -n "${TMUX:-}" ]]; then
  IN_TMUX=1
fi

PROJ_NAME="$(basename -- "$PROJECT_ROOT_DIR")"
WRITER_INIT="export PAIR_STATE='${STATE_PATH}'; cd '${PROJECT_ROOT_DIR}'; echo '=== PAIR WRITER: ${WRITER_ROLE} ==='; ${WRITER_CMD}"
CRITIC_INIT="export PAIR_STATE='${STATE_PATH}'; cd '${CRITIC_DIR}'; echo '=== PAIR CRITIC: ${CRITIC_ROLE} ==='; ${CRITIC_CMD}"
TITLE_WRITER="$PROJ_NAME:${WRITER_ROLE} (writer)"
TITLE_CRITIC="$PROJ_NAME:${CRITIC_ROLE} (critic)"

if [[ "$IN_TMUX" -eq 1 ]]; then
  # Inside tmux: split current window
  tmux split-window $SPLIT_OPT -c "$CRITIC_DIR" "$SHELL -c \"$CRITIC_INIT\""
  tmux select-pane -T "$TITLE_CRITIC" -t '{last}' 2>/dev/null || true
  tmux select-pane -T "$TITLE_WRITER" 2>/dev/null || true
  tmux select-pane -L 2>/dev/null || tmux select-pane -U 2>/dev/null || true
  eval "$WRITER_INIT"
else
  # Outside tmux: create a new session
  SESSION_NAME="duo-${CLI}-$(date +%s)"
  echo "pair-duo: starting tmux session '$SESSION_NAME'..."
  tmux new-session -d -s "$SESSION_NAME" -n "pair" -c "$PROJECT_ROOT_DIR" "$SHELL -c \"$WRITER_INIT\""
  tmux split-window -t "$SESSION_NAME" $SPLIT_OPT -c "$CRITIC_DIR" "$SHELL -c \"$CRITIC_INIT\""
  tmux select-layout -t "$SESSION_NAME" even-horizontal 2>/dev/null || true
  tmux select-pane -T "$TITLE_WRITER" -t "$SESSION_NAME:0.0" 2>/dev/null || true
  tmux select-pane -T "$TITLE_CRITIC" -t "$SESSION_NAME:0.1" 2>/dev/null || true
  tmux attach-session -t "$SESSION_NAME"
fi
