#!/usr/bin/env python3
"""Live view of the dialogue between the two agents.

Message texts live in .pair/mailbox; events (refusals, authority moves,
notes) in .pair/transcript.jsonl and .pair/notes.

  bin/pairchat               watch the current project, Ctrl-C exits
  bin/pairchat --once        print the exchange and exit
  bin/pairchat --all --once  one table and the full exchange for all projects
  PAIR_STATE=path bin/pairchat --once    a concrete project

Why --once exists: "show me what happened" is a question that wants
an answer and an exit, not a window to close by hand.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "mcp" / "pair_mailbox"))

from pairctl_read import discover_projects, project_row  # noqa: E402

BOLD, DIM, RED, YELLOW, CYAN, MAGENTA, OFF = (
    "\033[1m", "\033[2m", "\033[31m", "\033[33m", "\033[36m", "\033[35m", "\033[0m",
)

WIDTH = 100
# Human work noise about pair-mailbox itself: code scraps with no place
# in the agent exchange. Hidden by prefix, not by a kind allowlist:
# otherwise every new \u00a79 kind (backlog, finding-<ID>) would silently vanish
# from the feed (pairchat-hides-prescribed-notes card). Hidden, not lost:
# `--all-notes` shows them.
NOISE_NOTE_PREFIXES = ("z",)
NOISE_NOTE_SUFFIXES = ("-wrap",)

KIND_COLOR = {
    "msg": BOLD,
    "refusal": RED,
    "control": YELLOW,
    "note_head": CYAN,
    "note_body": MAGENTA,
}


def clock(ts) -> str:
    text = str(ts or "")
    return text[11:19] if len(text) > 19 else text


class Feed:
    """One project: the .pair read forward from where we stopped.

    Each object keeps its own cursor: messages by file name, events by transcript
    line, notes by bytes read. So the same object can be drained in a loop
    with nothing printed twice.

    A block returns as (sort key, kind, project label, text): the label sits
    inside the block, never attached outside — otherwise two identical messages
    from different projects would glue into one.
    """

    def __init__(self, root: Path, label: str, *, notes: bool = True) -> None:
        self.root = root
        self.label = label
        self.want_notes = notes
        self.keep_noise = False
        self.messages_only = False
        self.label_width = 0
        self.seen_msgs: set[str] = set()
        self.seen_events: set[str] = set()
        self.note_pos: dict[str, int] = {}
        self.seen_note_stem = False
        # the note header prints once per file: when a note is overwritten we show
        # only the new content, not a second header of the same name
        self.heads: dict[str, str] = {}

    def _add(self, out: list, order, kind: str, text: str) -> None:
        out.append((order, kind, self.label, text))

    def body_prefix(self) -> str:
        """Indent for wrapped lines: the project label plus two spaces.

        Counted here, not in show(), because word wrap must know its real
        width. It used to count two spaces, print a 93-char line, and show()
        added 14 more on top — 107 columns, and the text still tore in the terminal.
        """
        return " " * (self.label_width + 2) if self.label_width else "  "

    def messages(self, out: list) -> None:
        mailbox = self.root / "mailbox"
        if not mailbox.is_dir():
            return
        for box in sorted(mailbox.iterdir()):
            if not box.is_dir():
                continue
            for path in sorted(box.glob("*.json")):
                if path.name in self.seen_msgs:
                    continue
                self.seen_msgs.add(path.name)
                try:
                    msg = json.loads(path.read_text(encoding="utf-8"))
                except Exception:
                    continue
                ts = str(msg.get("ts") or "")
                head = f"[{clock(ts)}] {msg.get('from')} → {msg.get('to')}"
                body = str(msg.get("text", ""))
                parts = [head]
                prefix = self.body_prefix()
                if body:
                    parts.append(reflow(body, prefix))
                # Wrap the subject only when it missed one line together with the header.
                # Part order: header, subject, body — reads as "who to whom, about what,
                # here are the details".
                if msg.get("subject"):
                    subject = str(msg["subject"])
                    # the project label is not printed yet, count its width too
                    overhead = self.label_width
                    if len(head) + len(subject) + overhead + 4 > WIDTH:
                        parts.insert(1, reflow(subject, prefix))
                    else:
                        parts[0] = head + f"  {DIM}({subject}){OFF}"
                self._add(out, (0, ts), "msg", "\n".join(parts))

    def events(self, out: list) -> None:
        transcript = self.root / "transcript.jsonl"
        if not transcript.exists():
            return
        for raw in transcript.read_text(errors="replace").splitlines():
            if not raw.strip():
                continue
            key = f"{raw[:60]}|{len(raw)}"
            if key in self.seen_events:
                continue
            self.seen_events.add(key)
            try:
                event = json.loads(raw)
            except Exception:
                continue
            self._event(out, event)

    def _event(self, out: list, event: dict) -> None:
        ts = str(event.get("ts") or "")
        kind = event.get("kind")
        if kind == "send":
            # the message text already showed from mailbox, no repeat; but silence on
            # it still counts, because the transcript measures quiet
            return
        if self.messages_only and kind != "refusal":
            # a refusal always stays: the most important thing quiet ever holds
            return
        if kind == "refusal":
            # "assign", "release" and other service words hide: the human needs the
            # refusal fact and what to do, not the inner event-kind name
            head = f"[{clock(ts)}] REFUSED  {event.get('role')} → {event.get('tool')}"
            self._add(out, (0, ts), "refusal",
                      head + "\n" + reflow(str(event.get("reason", "")), self.body_prefix()))
            return
        if kind in ("claim", "assign", "release", "advance"):
            if kind == "assign":
                self._add(out, (0, ts), "control",
                          f"[{clock(ts)}] AUTHORITY MOVED: {event.get('writer')}"
                          f"   (you, {event.get('role')})")
                return
            if kind == "release":
                self._add(out, (0, ts), "control",
                          f"[{clock(ts)}] AUTHORITY FREE   ({event.get('role')})")
                return
            if kind == "advance":
                self._add(out, (0, ts), "control",
                          f"[{clock(ts)}] PHASE: {event.get('phase')}   ({event.get('role')})")
                return
            self._add(out, (0, ts), "control",
                      f"[{clock(ts)}] WRITER: {event.get('writer')}   ({event.get('role')})")
            return
        if kind == "note":
            self._add(out, (0, ts), "note_head",
                      f"[{clock(ts)}] NOTE {event.get('note_kind')} "
                      f"({event.get('chars')} chars, {event.get('role')})")
            return

    def notes(self, out: list) -> None:
        if not self.want_notes:
            return
        notes_dir = self.root / "notes"
        if not notes_dir.is_dir():
            return
        for path in sorted(notes_dir.glob("*.md")):
            try:
                text = path.read_text(errors="replace")
            except Exception:
                continue
            stem = path.stem
            # Show everything except work noise (NOISE_* above): the kind allowlist
            # drifted from \u00a79 both ways — hid the backlog and finding-* kinds the
            # skills prescribe, and showed review, which \u00a79 never had.
            if not self.keep_noise and (stem.startswith(NOISE_NOTE_PREFIXES)
                                        or stem.endswith(NOISE_NOTE_SUFFIXES)):
                self.note_pos[path.name] = len(text)
                continue
            pos = self.note_pos.get(path.name, 0)
            # the file may be rewritten whole — then the old content no longer holds
            # and the new shows from the start, not the tail
            rewritten = len(text) < pos
            if len(text) == pos and not rewritten:
                continue
            # "new version" means the file already showed and now runs shorter than
            # before: it was rewritten, so print the mark and the content from the start
            fresh = rewritten and path.name in self.heads
            if rewritten:
                pos = 0
            self.note_pos[path.name] = len(text)
            # A note overwritten onto a note, and the second same-named file is usually
            # a new version of the same document, not another document. Print the mark
            # so two conversations never read as one unbroken one.
            lines = [
                line for line in text[pos:].splitlines()
                if line.strip() and not line.startswith("#") and "—" not in line[:4]
            ]
            if not lines:
                continue
            # notes last: they carry no timestamp of their own, and inserting them into
            # the chronology would invent one
            prefix = self.body_prefix()
            if path.name not in self.heads:
                # first time: one header, no mark
                head = f"── {stem} ──"
                self.heads[path.name] = head
                self._add(out, (1, path.name), "note_head", head)
            elif fresh:
                self._add(out, (1, path.name), "note_head", f"── {stem} (new version) ──")
            self._add(out, (1, path.name), "note_body",
                      reflow("\n".join(lines), prefix))

    def drain(self) -> list:
        out: list = []
        self.messages(out)
        self.events(out)
        self.notes(out)
        return out


def reflow(text: str, indent: str, width: int = WIDTH) -> str:
    """Wraps long lines by word.

    Agents write in 300-400 char paragraphs. Without wrapping the terminal
    tears them mid-word and reading is impossible. Width counts in chars, not
    bytes: Cyrillic in UTF-8 is two bytes, and byte counting would cut words.
    """
    out = []
    for line in text.splitlines():
        if len(line) <= width - len(indent):
            out.append(indent + line if line else "")
            continue
        # the project-label indent already sits inside prefix, so room counts from
        # the remaining space. A long word mid-line stays whole: it is a URL or a
        # path, and a break would make it uncopyable. Such lines run past the
        # terminal edge, a deliberate trade.
        room = max(20, width - len(indent))
        current = ""
        for word in line.split():
            if current and len(current) + 1 + len(word) > room:
                out.append(indent + current)
                current = word
            else:
                current = f"{current} {word}" if current else word
        if current:
            out.append(indent + current)
    return "\n".join(out)


def labels_for(roots: list[Path]) -> list[str]:
    """Short project names. Repeats are qualified by parent — otherwise the table
    holds two `app` rows and neither says which."""
    counts: dict[str, int] = {}
    for root in roots:
        counts[root.parent.name] = counts.get(root.parent.name, 0) + 1
    labels = []
    for root in roots:
        name = root.parent.name or str(root)
        if counts.get(name, 0) > 1 and root.parent.parent.name:
            name = f"{root.parent.parent.name}/{name}"
        labels.append(name)
    return labels


def show(blocks: list, width: int) -> None:
    """Prints blocks in order. The project label goes on the first line, the rest
    shifts under it so one block’s lines read as one block."""
    for _, kind, label, text in sorted(blocks, key=lambda block: block[0]):
        prefix = label.ljust(width) if width else ""
        colour = KIND_COLOR.get(kind, "")
        lines = text.splitlines()
        if colour:
            print(colour + prefix + lines[0] + OFF)
        else:
            print(prefix + lines[0])
        # continuations already indent to the full label width in reflow; empty lines
        # get no padding spaces — garbage the text never held
        for line in lines[1:]:
            print(line)


def overview(roots: list[Path], labels: list[str], stuck_min: int) -> None:
    """Header before the exchange. Widths count from the data: project names run
    different lengths, and a hard indent would skew the columns on line one."""
    header = ("project", "phase", "writer", "silence")
    table = [
        (
            label,
            row["phase"],
            row["writer"] or "—",
            "not started" if row["silence_seconds"] is None
            else row["silence"] + ("  STUCK" if row["stuck"] else ""),
        )
        for root, label in zip(roots, labels)
        for row in [project_row(root, stuck_min)]
    ]
    widths = [max([len(header[i])] + [len(r[i]) for r in table]) for i in range(len(header))]
    print("  ".join(header[i].ljust(widths[i]) for i in range(len(header))).rstrip())
    for record in table:
        print("  ".join(record[i].ljust(widths[i]) for i in range(len(record))).rstrip())


def pick_roots(args) -> list[Path]:
    """The default root is where you stand, and no --all.

    Guessing "let me show everything" harms here: five projects hold five
    exchanges in a mix, and you learn nothing about the one you work in.
    The all-view is a separate act, once the human chose it.
    """
    here = Path(os.environ.get("PAIR_STATE") or ".pair").expanduser()
    local = here.resolve() if (here / "state.json").is_file() else None

    if args.everywhere or args.paths:
        named = discover_projects(args.paths) if args.paths else discover_projects([])
        if not named:
            print("no project with pair state found")
            print("point the path:  bin/pairchat --all ~/work/foo")
        return named
    if local is None:
        print(f"no {here} — you are not in a project folder under work")
        print("  view one:   cd <project> && bin/pairchat --once")
        print("  view all:    bin/pairchat --all --once")
        return []
    return [local]


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="pairchat",
        description="Exchange between agents: one project or all at once.",
    )
    parser.add_argument("--once", action="store_true",
                        help="print and exit instead of a window till Ctrl-C")
    parser.add_argument("--all", dest="everywhere", action="store_true",
                        help="all projects at once, intermixed. Default — only the one "
                             "where you stand: mixed exchanges do not read")
    parser.add_argument("--stuck-min", type=int, default=30,
                        help="which silence counts the project stuck (default 30)")
    parser.add_argument("--messages-only", action="store_true",
                        help="only the exchange, no service events or notes")
    parser.add_argument("--no-notes", action="store_true", help="no notes")
    parser.add_argument("--all-notes", action="store_true",
                        help="notes too, including my debug ones (many)")
    parser.add_argument("--since", default="",
                        help="only events newer than N minutes ago, e.g. --since 60")
    parser.add_argument("paths", nargs="*", help="projects or .pair, unless --all")
    args = parser.parse_args()

    if args.all_notes:
        args.no_notes = False

    roots = pick_roots(args)
    if not roots:
        return 1

    labels = labels_for(roots)
    feeds = [Feed(root, label, notes=not args.no_notes) for root, label in zip(roots, labels)]
    for feed in feeds:
        feed.keep_noise = args.all_notes
    width = max((len(label) for label in labels), default=0) + 2 if len(feeds) > 1 else 0
    for feed in feeds:
        feed.label_width = width

    if len(feeds) > 1:
        overview(roots, labels, args.stuck_min)
        print()

    where = "projects: " + ", ".join(labels) if width else str(roots[0])
    tail = "printing and exiting" if args.once else "Ctrl-C to exit"
    print(f"watching {where}, {tail}\n")

    if args.messages_only:
        # events show who does what, but when the human reads the exchange itself
        # the service lines only distract
        for feed in feeds:
            feed.want_notes = False
            feed.messages_only = True

    floor = ""
    if args.since:
        try:
            minutes = float(args.since)
        except ValueError:
            print(f"--since: need a minute count, not {args.since!r}")
            return 1
        floor = (datetime.now(timezone.utc) - timedelta(minutes=minutes)).strftime("%Y-%m-%dT%H:%M:%S")

    def emit(feed) -> None:
        blocks = feed.drain()
        if floor:
            blocks = [b for b in blocks if str(b[0][1]) >= floor or b[0][0] == 1]
        show(blocks, width)

    if args.once:
        for feed in feeds:
            emit(feed)
        return 0

    try:
        while True:
            for feed in feeds:
                emit(feed)
            time.sleep(0.4)
    except KeyboardInterrupt:
        print("\nexit")
    return 0


if __name__ == "__main__":
    sys.exit(main())