#!/usr/bin/env python3
"""Pair-work diagnostics. Changes nothing, only checks and explains.

  bin/pairdoctor            everything
  bin/pairdoctor --project  also reconcile the working project state
"""
import json, os, shutil, subprocess, sys, tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PROFILES = json.loads((ROOT / "cli-profiles.json").read_text(encoding="utf-8"))

ok_n, bad_n, warn_n = 0, 0, 0


def ok(m):
    global ok_n
    ok_n += 1
    print("  \033[32mok\033[0m      " + m)


def bad(m):
    global bad_n
    bad_n += 1
    print("  \033[31merror\033[0m " + m)


def warn(m):
    global warn_n
    warn_n += 1
    print("  \033[33mwarning\033[0m " + m)


def argv_from_toml(text):
    """The minimum needed from the [mcp_servers.pair] block: command and args."""
    cmd, args, inside = None, [], False
    for line in text.splitlines():
        s = line.strip()
        if s.startswith("["):
            inside = s == "[mcp_servers.pair]"
            continue
        if not inside or "=" not in s:
            continue
        key, _, val = s.partition("=")
        key, val = key.strip(), val.strip().strip('"')
        if key == "command":
            cmd = val
        elif key == "args":
            args = [a.strip().strip('"') for a in val.strip("[]").split(",") if a.strip()]
    if not cmd:
        raise KeyError("command")
    return [cmd] + args

def unittest_tail(stdout: str, stderr: str) -> list:
    """unittest summary lines from the merged output.

    unittest writes Ran/OK to stderr, not stdout: reading stdout alone
    gave an empty tail forever (pairdoctor-reads-stdout card). The summary
    sometimes has a tail — `OK (skipped=1)`, `FAILED (failures=1)` — so match
    by prefix, not by exact equality.
    """
    combined = (stdout or "") + (stderr or "")
    out = []
    for line in combined.splitlines():
        stripped = line.strip()
        if line.startswith("Ran ") or stripped == "OK" or stripped.startswith("OK ") \
                or stripped == "FAILED" or stripped.startswith("FAILED "):
            out.append(line)
    return out


print("pairdoctor, root " + str(ROOT))

def freshness_lines(targets, code_dir=None):
    """Section [6] freshness lines as (level, text): ‘ok’/‘warn’.

    Moved out of the inline section (round 87): the section must be checked
    through its own call, not through the library — otherwise a substitution
    in the calling code stays invisible to the test. code_dir is tests-only
    (a sandbox instead of the server directory); live runs always pass None.
    """
    sys.path.insert(0, str(ROOT / "mcp" / "pair_mailbox"))
    import server_freshness as _fresh
    # Freshness counts from the MCP server start (pid from state.json),
    # not from the doctor start: the doctor just launched, its /proc/self is
    # newer than any .py, and comparing against itself is green by construction.
    _pids = []
    for _sd in targets:
        try:
            _sst = json.loads((_sd / "state.json").read_text(encoding="utf-8"))
        except Exception:
            continue
        for _rinfo in (_sst.get("roles") or {}).values():
            if isinstance(_rinfo, dict) and _rinfo.get("pid"):
                try:
                    _p = Path(f"/proc/{int(_rinfo['pid'])}")
                    if _p.is_dir():
                        _pids.append(_p.stat().st_mtime)
                except (OSError, ValueError):
                    continue
    _start = min(_pids) if _pids else None
    if _start is None:
        return [("warn", "freshness check skipped — no live server pid in state")]
    _stale = _fresh.list_stale_files(_fresh.server_code_dir() if code_dir is None else code_dir,
                                     process_start_ts=_start)
    if _stale:
        return [("warn", "server code newer than server start: " + ", ".join(_stale) +
                 " — restart MCP servers (serve.sh)")]
    return [("ok", "server code fresh: no .py newer than server start")]


def pilot_lines(targets):
    """Section [8] pilot lines as (level, text): 'ok'/'warn'.

    The supervisor dies undetected (round 92 C5): nothing re-raises it
    between rounds except pairup/finish.sh, and no check signalled.
    Match is on --state of OUR dir: a foreign project's live pilot
    (measured: nyx-system pid 2293899) must never read as ours.
    """
    import subprocess as _sp
    lines = []
    for _sd in targets:
        _sd = _sd.resolve()
        _alive = False
        try:
            _pid_text = (_sd / "pilot.pid").read_text(encoding="utf-8").strip()
            if _pid_text.isdigit():
                _os = __import__("os")
                try:
                    _os.kill(int(_pid_text), 0)
                    _alive = True
                except (OSError, ValueError):
                    _alive = False
        except OSError:
            pass
        if not _alive:
            try:
                _out = _sp.run(["pgrep", "-af", "pairpilot"],
                               capture_output=True, text=True, timeout=5).stdout or ""
                for _ln in _out.splitlines():
                    if str(_sd) in _ln:
                        _alive = True
                        break
            except Exception:
                pass
        if _alive:
            lines.append(("ok", "supervisor alive on " + str(_sd)))
        else:
            lines.append(("warn", "supervisor dead on " + str(_sd) +
                          " — raise it: python3 bin/pairpilot --state " + str(_sd) +
                          " (or bin/pairup / finish.sh)"))
    return lines


print("\n[1] server")
srv = ROOT / "mcp/pair_mailbox/server.py"
tests = ROOT / "mcp/pair_mailbox/test_protocol.py"
if not srv.exists():
    bad("missing mcp/pair_mailbox/server.py")
else:
    r = subprocess.run([sys.executable, str(tests)], cwd=str(ROOT),
                       capture_output=True, text=True)
    # unittest writes its summary to stderr: read the merged output via unittest_tail.
    tail = unittest_tail(r.stdout, r.stderr)
    if r.returncode == 0:
        ok("server tests: " + (tail[0] if tail else "OK"))
    else:
        bad("server tests failed: " + " ".join(tail) + r.stderr[-200:])

print("\n[2] CLI")
live = []
for name, prof in PROFILES.items():
    if name.startswith("_"):
        continue
    if not shutil.which(name):
        warn(name + ": not installed, skipping")
        continue

    spec = prof["mcp"]
    path = Path(spec["path"]).expanduser()
    if not path.exists():
        bad(name + ": binary present but config (" + path.name + ") missing — run ./install.sh")
        continue

    try:
        text = path.read_text(encoding="utf-8")
        if spec["format"] == "toml":
            argv = argv_from_toml(text)
        else:
            entry = json.loads(text)[spec["root_key"]][spec.get("server_key", "pair")]
            argv = (entry["command"] if isinstance(entry.get("command"), list)
                    else [entry.get("command")] + entry.get("args", []))
    except Exception as exc:
        bad(name + ": cannot read " + path.name + " — " + str(exc)[:120])
        continue

    req = json.dumps({"jsonrpc": "2.0", "id": 1, "method": "initialize",
                      "params": {"protocolVersion": "2024-11-05",
                                 "clientInfo": {"name": "pairdoctor"}}}) + "\n"
    # The handshake writes into state: `on_initialize` calls `_register` and
    # saves state.json, which records the diagnostic process pid and pane
    # into the roster alongside live agents. A check that promises to change
    # nothing would wipe a live neighbour’s pid and leave a dead one in
    # the roster, and `pair_state` would then report "neighbour dead" about the living.
    #
    # So the server rises on a separate empty state directory.
    # `serve.sh` takes it as the second argument, and the diagnostics `PAIR_STATE`
    # must not override that path.
    with tempfile.TemporaryDirectory(prefix="pairdoctor-") as sandbox:
        env = dict(os.environ)
        env.pop("PAIR_STATE", None)
        env.pop("PAIR_ROLE", None)
        try:
            p = subprocess.run(argv + [sandbox], input=req, capture_output=True,
                               text=True, timeout=15, env=env)
        except Exception as exc:
            bad(name + ": launch failed — " + str(exc)[:120])
            continue
        if any('"pair-mailbox"' in l for l in p.stdout.splitlines()):
            ok(name + ": MCP answers as pair-mailbox")
            live.append(name)
        else:
            bad(name + ": server present but not responding — " + (p.stderr[:120] or p.stdout[:120]))

print("\n[3] skills")
for name, prof in PROFILES.items():
    if name.startswith("_"):
        continue
    d = Path(prof["skills_dir"]).expanduser()
    if not d.exists():
        continue
    have = {p.parent.name for p in d.glob("*/SKILL.md")}
    want = {p.name for p in (ROOT / "skills").glob("*/")}
    missing = want - have
    if missing:
        warn(name + ": missing " + ", ".join(sorted(missing)))
    else:
        ok(name + ": skills in place")

print("\n[4] state")
targets = [Path(os.environ["PAIR_STATE"]).resolve()] if "PAIR_STATE" in os.environ else []
if "--project" in sys.argv:
    _proj = (Path.cwd() / ".pair").resolve()
    if _proj not in targets:
        targets.append(_proj)
if not targets:
    targets = [ROOT / ".pair"]

for sd in targets:
    print("  " + str(sd))
    if not sd.exists():
        warn("no state — this pair has not run yet")
        continue
    try:
        st = json.loads((sd / "state.json").read_text(encoding="utf-8"))
    except Exception as exc:
        bad("state.json unreadable: " + str(exc)[:100])
        continue
    roles = sorted(st.get("roles", {}))
    ok("roles: " + (", ".join(roles) or "nobody connected yet"))
    ok("writer: " + str(st.get("writer") or "nobody") + ", phase: " + str(st.get("phase")))
    if not st.get("writer"):
        warn("no writer assigned — nobody can edit files")
    if st.get("phase") == "done":
        warn("phase done: round closed, peer will not read new messages")
    if st.get("mode") == "audit":
        ok("mode: AUDIT — project is read-only, server will reject patches")
    tr = sd / "transcript.jsonl"
    if tr.exists():
        kinds = {}
        for line in tr.read_text(errors="replace").splitlines():
            if line.strip():
                try:
                    k = json.loads(line).get("kind")
                    kinds[k] = kinds.get(k, 0) + 1
                except Exception:
                    pass
        ok("events: " + str(sum(kinds.values())) +
           ", messages: " + str(kinds.get("send", 0)) +
           ", refusals: " + str(kinds.get("refusal", 0)))

print("\n[5] delivery")
try:
    sys.path.insert(0, str(ROOT / "mcp" / "pair_mailbox"))
    import composer as _composer
    # Condition (c): honour the project's socket instead of plain tmux (round 106
    # slice C). composer._tmux() is the ONE resolver; a second one here would be
    # the "most call sites" trap the critic named.
    sys.path.insert(0, str(__import__("pathlib").Path(__file__).resolve().parent.parent / "mcp" / "pair_mailbox"))
    try:
        from composer import _tmux as _ctmux
        _tmux = _ctmux()
    except Exception:
        _tmux = __import__("shutil").which("tmux")
    for _sd in targets:
        try:
            _st = json.loads((_sd / "state.json").read_text(encoding="utf-8"))
        except Exception:
            continue
        for _role, _info in (_st.get("roles") or {}).items():
            if not isinstance(_info, dict):
                continue
            _pane = _info.get("pane")
            if not _pane or not _tmux:
                continue
            try:
                _alive = _composer.pane_alive(_tmux, _pane)
            except Exception:
                _alive = False
            if not _alive:
                warn(_role + ": pane " + str(_pane) + " dead — pilot cannot reach it")
                continue
            try:
                _lines = _composer.capture(_tmux, _pane)
                _line = _composer.composer_line(_lines)
            except Exception as _exc:
                bad(_role + ": capture failed — " + str(_exc)[:100])
                continue
            if _line is None:
                warn(_role + ": pane " + str(_pane) + " alive but composer busy (not visible) — delivery deferred")
            elif _composer.is_composer_empty(_line):
                ok(_role + ": pane " + str(_pane) + " reachable, composer free")
            else:
                ok(_role + ": pane " + str(_pane) + " reachable, composer busy (" + _line.strip()[-40:] + ")")
except Exception as _exc:
    warn("delivery check skipped — " + str(_exc)[:100])

print("\n[6] freshness")
try:
    for _level, _msg in freshness_lines(targets):
        (ok if _level == "ok" else warn)(_msg)
    if not _fresh.proc_available():
        warn("no /proc on this platform (macOS): pane discovery, descendants and freshness degrade — see card proc-macos-degradation")
except Exception as _exc:
    warn("freshness check skipped — " + str(_exc)[:100])

print("\n[7] git")
if (ROOT / ".git").exists():
    r2 = subprocess.run(["git", "log", "--oneline", "-1"], cwd=str(ROOT),
                        capture_output=True, text=True)
    ok("repo: " + (r2.stdout.strip() or "no commits"))
    r3 = subprocess.run(["git", "status", "--porcelain"], cwd=str(ROOT),
                        capture_output=True, text=True)
    if r3.stdout.strip():
        warn("uncommitted files: " + str(len(r3.stdout.strip().splitlines())))
else:
    warn("not a git repo — git init to deploy on another machine")

print("\n[8] pilot")
try:
    for _level, _msg in pilot_lines(targets):
        (ok if _level == "ok" else warn)(_msg)
except Exception as _exc:
    warn("pilot check skipped — " + str(_exc)[:100])

print("\nsummary: " + str(ok_n) + " ok, " + str(bad_n) + " errors, " + str(warn_n) + " warnings")
sys.exit(1 if bad_n else 0)
