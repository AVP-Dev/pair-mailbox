#!/usr/bin/env python3
"""Сверхвизор пары: держит работу, когда на неё никто не смотрит.

Зачем он. Агенты пассивны по устройству: отработав шаг, они возвращаются в
состояние ожидания ввода. Пока оба не пишут друг другу — пара стоит, и разбудить
её может только человек. Именно это стоило нам ночи: поломался канал доставки,
оба агента остались свободны, а единственным работающим путём остался терминал
оператора.

Поэтому у пары обязан быть кто-то, кто смотрит на неё извне. Этот скрипт.
Он умеет ровно семь вещей и не умеет ни одной восьмой:

  1. доставить отложенное сообщение, когда композер соседа освободился
     (переживающая доставка: сообщение живёт в outbox, пока не долетело);
  2. подтолкнуть молчающего агента — молчание дольше порога это дефект, а не норма;
  3. подтвердить зависший запрос разрешения, но только из белого списка;
  4. перезапустить агента, процесс которого умер, а окно ещё живо;
  5. сказать про зависший sealed-патч обеим сторонам и не дать раунду закрыться;
  6. собрать дайджест для человека на чекпоинте semi;
  7. написать отчёт, когда раунд закрылся.

И принципиально НЕ умеет: двигать фазу, выдавать или забирать право записи,
коммитить, применять чужие патчи, трогать файлы проекта. Право записи перемещает
только человек, и если сверхвизор сможет его выдать, то он перестаёт быть
ограничением (PROTOCOL.md §2). Поэтому спор о том, кто пишет, он разрешает
только сообщением: «ты молчишь вот столько, вот твоя обязанность по последнему
событию».

Запуск:

    bin/pairpilot                 # следить
    bin/pairpilot --once          # один проход, для проверки вручную
    bin/pairpilot --silence 300   # порог молчания, секунд
    bin/pairpilot --launch agy=agy # как поднимать роль, если её процесс умер
    bin/pairpilot --allow 'r"^git status' # что ещё можно подтверждать само
"""
import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "mcp" / "pair_mailbox"))

try:
    from composer import (  # noqa: E402
        ComposerBusy,
        capture,
        composer_line,
        deliver,
        is_composer_empty,
        _tmux,
        find_pane_of_pid,
        load_allow_patterns,
        pane_alive,
        pane_key,
        pane_role_pid,
        resolve_permission_prompt,
    )
except Exception as error:  # noqa: BLE001 - причина должна быть видна сразу
    print(f"pairpilot: не удалось подключить composer: {error}", file=sys.stderr)
    raise SystemExit(1)

from server import (  # noqa: E402  - после sys.path
    Store,
    autonomy_of,
    done_blockers,
    is_pid_alive,
    open_tasks,
    permissions_path,
    tasks_of,
    utcnow,
    write_tasks_md,
)

DEFAULT_INTERVAL = 15.0
DEFAULT_SILENCE = 600.0
# Сколько ждать ответа на запрос, прежде чем дёрнуть получателя, и сколько —
# прежде чем сказать об этом автору запроса. 180с: затык «оба молчат +
# обязательство висит» будится пилотом за <5 мин без человека (раунд 33, P1).
DEFAULT_REPLY_GRACE = 180.0
# Срок жизни отложенного напоминания. Переживающая доставка полезна, пока
# вопрос жив: пока композер занят, минута-другая ожидания уместна. Но вопрос,
# провисевший дольше, уже не помогает — он только отвлекает. Наблюдалось
# вживую: напоминание ждало композер 22 минуты и было доставлено как свежее.
#
# Должно быть ЗАВЕДОМО больше WAKE_ESCALATE_REPEAT_SECONDS, и это условие
# работоспособности, а не вкус: при 600 против 900 эскалация протухала в очереди
# раньше, чем повтор в неё попадал. Соотношение проверяется тестом.
DEFAULT_OUTBOX_TTL = 1800.0
# Сколько молчит роль, прежде чем пробуждение печатью станет эскалацией.
#
# Порядок намеренно перевёрнут относительно прежнего: раньше печать в композер была
# ПЕРВЫМ шагом, и молчание означало «доставлю позже» — то есть почти всегда
# печать. Теперь печать это исключение, а не правило: сначала пишем факт в файл,
# затем опрашиваем, и если роль проснулась сама, не печатаем ничего.
DEFAULT_WAKE_GRACE = 240.0
# Как часто можно повторить эскалацию, если роль так и не проснулась. Не «один раз
# навсегда» — причина в may_escalate_again. Пауза заведомо больше wake_grace.
WAKE_ESCALATE_REPEAT_SECONDS = 900.0
DEFAULT_REPLY_HARD = 2400.0
# Сколько провисает sealed-патч, прежде чем это станет дефектом, а не делом,
# которое писатель возьмёт через минуту.
DEFAULT_PATCH_GRACE = 1800.0
# Потолок перезапусков на роль в скользящем окне. Нужен потому, что ключ по pid
# не спасает: команда может быть известна и неверна, pid будет каждый раз новый,
# и без потолка это цикл падения, а не восстановление.
DEFAULT_RESTART_LIMIT = 3
DEFAULT_RESTART_WINDOW = 600.0
PROMPT_MARKERS = (">", "›", "❯")
AUTONOMIES = ("observe", "semi", "auto")


def autonomy(state: dict) -> str:
    """Уровень самостоятельности из состояния, без выдуманных значений.

    Неизвестное значение читается как observe — тот уровень, который делает
    меньше всего. Состояние, записанное более новой сборкой, не должно выдать
    этой сборке больше прав, чем человек просил.
    """
    return autonomy_of(state)


def stable_tag(text: str) -> str:
    """Короткий стабильный отпечаток строки.

    Встроенный hash() для строк рандомизирован на каждый запуск процесса, а эти
    отметки должны переживать перезапуск: иначе после рестарта сверхвизор
    «забывает», что уже дёргал соседа, и пишет то же самое снова — всю ночь.
    """
    return hashlib.sha256(text.encode("utf-8", "replace")).hexdigest()[:8]


def stamp_name(key: str) -> str:
    """Имя файла-отметки для ключа.

    Ключи строятся из путей (например, пути патча), а путь в имени файла
    превращается в каталоги, которых нет: `remember()` падал с FileNotFoundError
    на первом же патче. Поэтому ключ сначала приводится к безопасному виду, а
    для уникальности к нему добавляется стабильный отпечаток.
    """
    safe = re.sub(r"[^A-Za-z0-9._-]+", "_", key).strip("_")[:80]
    return f"{safe}.{stable_tag(key)}"


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def parse_iso(value: str | None) -> datetime | None:
    if not value:
        return None
    try:
        return datetime.fromisoformat(value)
    except (TypeError, ValueError):
        return None


def log(message: str) -> None:
    print(f"[{datetime.now().strftime('%H:%M:%S')}] {message}", flush=True)


class Pilot:
    def __init__(self, state_dir: Path, silence: float, interval: float,
                 reply_grace: float = DEFAULT_REPLY_GRACE,
                 reply_hard: float = DEFAULT_REPLY_HARD,
                 patch_grace: float = DEFAULT_PATCH_GRACE,
                 launch: dict[str, str] | None = None,
                 allow: list[str] | None = None,
                 restart_limit: int = DEFAULT_RESTART_LIMIT,
                 restart_window: float = DEFAULT_RESTART_WINDOW,
                 outbox_ttl: float = DEFAULT_OUTBOX_TTL,
                 wake_grace: float = DEFAULT_WAKE_GRACE) -> None:
        self.state_dir = state_dir
        self.silence = silence
        self.interval = interval
        self.reply_grace = reply_grace
        self.reply_hard = reply_hard
        self.patch_grace = patch_grace
        self.allow = allow
        self.restart_limit = max(1, int(restart_limit))
        self.restart_window = max(1.0, float(restart_window))
        self.outbox_ttl = max(1.0, float(outbox_ttl))
        # Store умеет root — это сам каталог состояния: server.py делает ровно
        # то же. Со state_dir.parent мы бы читали несуществующий state.json.
        self.store = Store(state_dir)
        self.outbox = state_dir / "pilot"
        self.outbox.mkdir(parents=True, exist_ok=True)
        self.wake_root = state_dir / "wake"
        self.wake_root.mkdir(parents=True, exist_ok=True)
        self.wake_grace = max(1.0, float(wake_grace))
        self.reported: set[str] = set()
        self.skip: set[str] = set()
        self._default_list_named = False
        try:
            self.tmux: str | None = _tmux()
        except Exception:
            self.tmux = None
        # Панель, в которой живёт сам сверхвизор. Это, обычно, панель оператора,
        # а иногда и панель агента, который его запустил. Вбивать туда что-либо
        # нельзя: там ждёт ввод человека, и мы бы съели его текст.
        self.own_pane = os.environ.get("TMUX_PANE") or None
        self._explicit_launch = dict(launch or {})

    # ------------------------------------------------------------- restart map

    def _launch_commands(self, given: dict[str, str] | None = None) -> dict[str, str]:
        """Как запустить роль, если её процесс умер.

        Порядок источников от «явного» к «угаданному»: то, что человек написал
        сам, потом профиль в cli-profiles.json, потом переменная окружения.
        Ничего не угадываем по имени: команда, которой не существует, хуже
        отсутствия команды, потому что панель оживает и сразу падает.

        Карта пересобирается на каждом обращении (см. `launch_command`), а не
        морозится в `__init__`: иначе профиль, добавленный позже (как `pi`
        2026-10-06), и правка `restart.json` вступают в силу только после
        перезапуска пилота. Измерено: пилот от 05.10 не знал команду `pi` и
        писал `pilot_restart_impossible`, хотя профиль уже был на диске.
        """
        explicit = dict(getattr(self, "_explicit_launch", None)
                        if given is None else (given or {}))
        out: dict[str, str] = {}
        file_cmd = self.state_dir / "restart.json"
        try:
            if file_cmd.is_file():
                data = json.loads(file_cmd.read_text(encoding="utf-8"))
                if isinstance(data, dict):
                    out.update({str(k): str(v) for k, v in data.items()})
        except (OSError, json.JSONDecodeError):
            log("restart.json не читается, команды запуска беру из профилей")
        profiles = ROOT / "cli-profiles.json"
        try:
            data = json.loads(profiles.read_text(encoding="utf-8"))
            for name, profile in (data or {}).items():
                if not name.startswith("_") and isinstance(profile, dict) and profile.get("launch"):
                    out.setdefault(name, str(profile["launch"]))
        except (OSError, json.JSONDecodeError):
            pass
        out.update(explicit)
        for role in list(out):
            env_cmd = os.environ.get(f"PAIR_LAUNCH_{re.sub(r'[^A-Za-z0-9]', '_', role).upper()}")
            if env_cmd:
                out[role] = env_cmd
        return out

    def launch_command(self, role: str) -> str:
        return self._launch_commands().get(role, "").strip()

    # ------------------------------------------------------------ restart budget

    def restarts_file(self, role: str) -> Path:
        return self.outbox / f".restarts-{role}"

    def restart_history(self, role: str) -> list[float]:
        """Когда именно роль перезапускали. Один timestamp на строку."""
        try:
            raw = self.restarts_file(role).read_text(encoding="utf-8").split()
        except OSError:
            return []
        out = []
        for item in raw:
            try:
                out.append(float(item))
            except ValueError:
                continue
        return out

    def note_restart(self, role: str) -> None:
        """Записать попытку и сразу отбросить всё, что вышло за окно.

        Обрезание здесь, а не при чтении, нужно затем, что иначе файл с историей
        рос бы бесконечно по мере жизни проекта.
        """
        now = time.time()
        keep = [stamp for stamp in self.restart_history(role) if now - stamp < self.restart_window]
        keep.append(now)
        try:
            self.restarts_file(role).write_text(
                " ".join(f"{stamp:.0f}" for stamp in keep), encoding="utf-8")
        except OSError as error:
            log(f"{role}: не записал историю перезапусков ({error}) — ограничение может не сработать")

    def restart_allowed(self, role: str) -> bool:
        """Не превышен ли лимит перезапусков этой роли в окне.

        Считает попытки независимо от pid: скользящее окно останавливает и
        процесс, падающий сразу после старта, у которого pid каждый раз новый.
        """
        now = time.time()
        recent = [stamp for stamp in self.restart_history(role)
                  if now - stamp < self.restart_window]
        return len(recent) < self.restart_limit

    # ------------------------------------------------------------------ state

    def state(self) -> dict:
        return self.store._load()

    def remember(self, key: str) -> bool:
        """True, если этого раунда мы ещё не делали. Не даёт повторять запись."""
        stamp = self.state_dir / "pilot" / f".{stamp_name(key)}"
        if stamp.exists():
            return False
        stamp.write_text(now_iso(), encoding="utf-8")
        return True

    def forget(self, prefix: str) -> None:
        for stamp in (self.outbox / "." + prefix).glob("*"):
            stamp.unlink(missing_ok=True)

    def panes(self, state: dict) -> dict[str, list[str]]:
        """Кто на какой панели, без мёртвых.

        Мёртвая роль не делает панель общей. Проверено вживую: claude и codex
        держались в ростере с одной панелью %20, записи пережили их процессы, и
        `skip` содержал всех троих — включая живого agy. Сверхвизор переставал
        обслуживать проект из-за двух умерших соседей.

        Роль считается живой по process'у; панель без живого процесса — просто
        запись, а не окно, где кто-то сидит. Два независимых факта, как в
        `pane_exists`: имя панели не доказывает, что в ней кто-то есть.
        """
        table: dict[str, list[str]] = {}
        for role, info in (state.get("roles") or {}).items():
            pane = info.get("pane")
            if not pane:
                continue
            pid = info.get("pid")
            if isinstance(pid, int) and pid > 0 and not is_pid_alive(pid):
                continue
            table.setdefault(self.pane_key(pane), []).append(role)
        return table

    def pane_key(self, pane: str) -> str:
        """Ключ группировки панелей, одинаковый для обоих форматов ссылки.

        Группировка по самой строке перестала работать, как только в состоянии
        появились адреса сессий: `%1` и `mail:0.1` — одна панель, а таблица видела
        две. Дальше это ломало `ambiguous()`, а тот, не увидев двух ролей на одной
        панели, считал её свободной и бил в неё — то есть в чужой композер.
        """
        return pane_key(self.tmux, pane)

    def stale_roles(self, state: dict) -> dict[str, str]:
        """Роли с мёртвым процессом, но всё ещё числящиеся. Не удаляются молча:
        ростер — общая память, и решение очистить его принимает человек."""
        out = {}
        for role, info in (state.get("roles") or {}).items():
            pid = info.get("pid")
            if isinstance(pid, int) and pid > 0 and not is_pid_alive(pid):
                out[role] = f"pid {pid} is gone"
        return out

    def shared_panes(self, state: dict) -> dict[str, list[str]]:
        return {pane: names for pane, names in self.panes(state).items() if len(names) > 1}

    def pane_occupied_by_other(self, state: dict, role: str, pane: str) -> str | None:
        """Живая роль на этой панели, кроме самой `role`. None — панель свободна.

        Запись о мёртвом агенте не делает панель занятой: если в ней кто-то жив,
        перезапуск ушедшего роли ударит по живому соседу. Считаем только по
        процессам, потому что имя панели — это адрес, а не свидетельство."""
        key = self.pane_key(pane)
        for other, info in (state.get("roles") or {}).items():
            # Сравнение по ключу, а не по строке: сосед может быть записан адресом
            # сессии, а `pane` пришёл из `%N`, и это та же панель. При сравнении
            # строк сверхвизор решил бы, что панель свободна, и перезапустил в
            # ней чужого агента.
            if other == role or self.pane_key(info.get("pane")) != key:
                continue
            pid = info.get("pid")
            if isinstance(pid, int) and pid > 0 and is_pid_alive(pid):
                return other
        return None

    def pane_occupant(self, role: str, pane: str) -> int:
        """pid, который реально сидит в панели этой роли, или 0.

        Роль жива, если жив pid ИЛИ панель с процессом, но эти два факта могут
        расходиться, и важно в каком направлении. Мёртвый pid при живой панели —
        это не падение: pid в ростере протух, а агент на месте. Обратное, живой
        pid при отсутствующей панели, — уже настоящая беда, и она ловится в
        `dead_pane`.

        Панель, занятую чужой живой ролью, сюда не доходит: `restart_agent`
        проверяет `pane_occupied_by_other` ДО этого вызова, иначе мы записали бы
        pid соседа в запись этой роли. Проверять здесь ещё раз было бы вторым
        мнением об одном факте, а не страховкой.
        """
        if self.tmux is None or not pane:
            return 0
        occupant = pane_role_pid(self.tmux, pane, role)
        if not occupant or occupant == os.getpid():
            return 0
        return occupant if is_pid_alive(occupant) else 0

    def gone_roles(self, state: dict) -> None:
        """Роли, чей процесс умер, но запись в ростере осталась.

        Молчание здесь вреднее шума: из-за таких записей общая панель выглядела
        занятой, и сверхвизор переставал будить живого соседа. Говорим один раз
        за роль и оставляем решать человеку — молча чистить ростер нельзя.
        """
        for role, why in self.stale_roles(state).items():
            if not self.remember(f"gone-{role}"):
                continue
            log(f"{role}: {why}, но запись в ростере осталась и панель считалась общей. "
                f"Чистить ростер — `pairctl release` или новая сессия.")
            self.store.append_transcript("pilot_stale_role", "pairpilot", target=role, why=why)

    def ambiguous(self, state: dict) -> bool:
        """Две роли на одной панели — значит ростер врёт, и бить в неё нельзя.

        Так бывает: диагностика или чужой скрипт регистрирует роль, отметку не
        стирая, и в неё попадает текущая панель. Тогда «будим claude» ушло бы в
        окно agy. Лучше не будить вовсе, чем будить не того.
        """
        shared = self.shared_panes(state)
        if not shared:
            return False
        key = "shared-" + "-".join(f"{pane}:{','.join(sorted(names))}" for pane, names in sorted(shared.items()))
        if self.remember(key):
            for pane, names in sorted(shared.items()):
                log(f"панель {pane} указана сразу за {', '.join(sorted(names))} — не трогаю её")
                self.store.append_transcript("pilot_pane_shared", "pairpilot", pane=pane, roles=sorted(names))
        return True

    # -------------------------------------------------------------- пробуждение

    def mark_wake(self, state: dict, role: str, reason: str, text: str) -> None:
        """Записать, что роль надо разбудить — в файл, а не в композер.

        Печать в композер была единственным способом сказать соседу «у тебя
        письмо», и это плохой способ: он ломается о занятый TUI, требует угадать
        момент и оставляет след в чужом окне. Пробуждение по файлу не печатает
        ничего — роль увидит его сама, когда посмотрит состояние, — и даёт
        супервизору факт, по которому можно потом судить: будили или уже проснулся.

        Текущий снимок `last_seen` кладётся рядом с фактом намерения. Сравнение
        идёт с ним, а не с текущим временем: иначе роль, которая была awake в
        момент постановки вопроса, была бы признана «проснувшейся» следующим же
        тиком без единого своего действия.
        """
        path = self.wake_root / f"{role}.json"
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            info = (state.get("roles") or {}).get(role) or {}
            # Висящее пробуждение дополняется, а не перезаписывается.
            #
            # Поводов о пробуждении два (`unread_peers` и `stale_writer`), а файл
            # на роль один. Перезапись теряла `asked_at` — терпение начиналось
            # заново, — и признак `escalated`, то есть один и тот же факт
            # эскалировался дважды: сначала по первому поводу, потом, уже после
            # перезаписи, по второму. Снимок `seen_at_ask` берётся только при
            # первой постановке: он отвечает на вопрос «проснулся ли роль после
            # вопроса», и обновлять его — значит задавать вопрос заново.
            previous: dict = {}
            try:
                previous = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                previous = {}
            if not isinstance(previous, dict):
                previous = {}
            prior_reasons = previous.get("reasons")
            if not isinstance(prior_reasons, list):
                prior_reasons = [previous["reason"]] if previous.get("reason") else []
            seen = [str(r) for r in prior_reasons]
            if reason not in seen:
                seen.append(reason)
            payload = dict(previous)
            payload.update({
                "role": role,
                "reason": seen[-1],
                "reasons": seen,
                "asked_at": previous.get("asked_at") or utcnow(),
                "seen_at_ask": previous.get("seen_at_ask", info.get("last_seen")),
                "unread_at_ask": int(previous.get("unread_at_ask", self.unread(state, role))),
                "text": text,
            })
            payload.setdefault("asked_at", utcnow())
            path.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
        except OSError as error:
            # Не записали — значит, будить нечем, и это надо сказать, а не
            # сделать вид, что роль получила напоминание.
            self.store.append_transcript("pilot_wake_failed", "pairpilot",
                                         target=role, error=str(error)[:120])
            log(f"{role}: не смог записать пробуждение — {error}")
            return
        self.store.append_transcript("pilot_wake_pending", "pairpilot",
                                     target=role, reason=reason)
        log(f"{role}: {reason}, жду пробуждения молча (в печать не бью)")

    def poll_wakes(self, state: dict) -> None:
        """Опросить висящие пробуждения и решить по каждому: проснулся или нет.

        Три исхода, и каждый виден в журнале:
        - **проснулся** — `last_seen` сдвинулся или непрочитанных стало ноль.
          Ничего не печатаем: роль уже в работе, и будить её значило бы мешать.
        - **терпение кончилось** — роль молчит дольше `wake_grace`. Тогда печатаем,
          один раз, и это уже эскалация, а не первый шаг.
        - **всё ещё ждём** — тишина. Молчание, за которым смотрит супервизор,
          обходится в ноль токенов.
        """
        if not self.wake_root.is_dir():
            return
        now = time.time()
        for path in sorted(self.wake_root.glob("*.json")):
            try:
                wake = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                # Битый файл пробуждения нельзя чинить догадками: он удаляется,
                # потому что иначе он будет висеть вечно, а роль так и не услышит.
                path.unlink(missing_ok=True)
                self.store.append_transcript("pilot_wake_damaged", "pairpilot",
                                             file=path.name)
                continue
            role = str(wake.get("role") or "")
            info = (state.get("roles") or {}).get(role) or {}
            seen_now = info.get("last_seen")
            seen_ask = wake.get("seen_at_ask")
            unread_now = self.unread(state, role)
            woke = (seen_now != seen_ask) or (unread_now < int(wake.get("unread_at_ask", 0)))
            if woke:
                # Порядок обязателен: раньше файл сначала удалялся, и `stat`
                # потом всегда давал «нет файла», то есть since_seconds был
                # всегда 0 — поле, по которому судят, сколько роль молчала,
                # не сказало ничего.
                try:
                    since = int(now - path.stat().st_mtime)
                except OSError:
                    since = 0
                path.unlink(missing_ok=True)
                self.store.append_transcript("pilot_wake_acknowledged", "pairpilot",
                                             target=role, reason=wake.get("reason"),
                                             since_seconds=since)
                log(f"{role}: проснулся сам, печать не понадобилась")
                continue
            asked = parse_iso(wake.get("asked_at"))
            age = now - asked.timestamp() if asked else 0.0
            if age < self.wake_grace:
                continue
            # Пауза между повторами и причина — в may_escalate_again.
            if not self.may_escalate_again(wake, now):
                continue
            self.store.append_transcript("pilot_wake_escalated", "pairpilot",
                                         target=role, reason=wake.get("reason"),
                                         age_seconds=int(age),
                                         repeat=bool(wake.get("escalated")))
            log(f"{role}: молчит {int(age // 60)} мин после пробуждения — печатаю")
            self.enqueue(role, str(wake.get("text") or ""))
            wake["escalated"] = True
            wake["escalated_at"] = utcnow()
            path.write_text(json.dumps(wake, ensure_ascii=False, indent=2), encoding="utf-8")

    def may_escalate_again(self, wake: dict, now: float) -> bool:
        """Пора ли повторить эскалацию: роль молчит, а пауза с прошлой прошла.

        Прежний контракт был «ровно один раз за жизнь роли», и это ловушка без
        выхода: файл удаляется только когда роль ПРОСНУЛАСЬ, поэтому у молчащей
        роли вторая эскалация невозможна в принципе. Найдено вживую — pi молчал
        час, файл висел с escalated, супервизор писал «ждёт 40 мин» и не печатал.

        Пауза обязана быть меньше срока жизни отложенного, иначе повтор протухнет
        в очереди, не доехав до композера.
        """
        if not wake.get("escalated"):
            return True
        last = parse_iso(wake.get("escalated_at"))
        if last is None:
            return True
        return (now - last.timestamp()) >= WAKE_ESCALATE_REPEAT_SECONDS

    # --------------------------------------------------------------- outbox

    def enqueue(self, role: str, text: str) -> None:
        path = self.outbox / f"{role}.txt"
        path.write_text(text, encoding="utf-8")

    def mailbox_fallback(self, role: str, text: str) -> int | None:
        """Дублировать указатель в mailbox получателя как письмо от пилота.

        Outbox протухает, если композер занят дольше TTL: агент работает,
        печатать нельзя, указатель выбрасывается — и агент никогда не узнаёт,
        что его ждали. Mailbox не протухает: агент заберёт письмо через
        `pair_read`, когда сам решит. Измерено 2026-10-06: два nudge_expired
        подряд, оба агента живы, оба ничего не получили.
        Возвращает seq письма или None, если дублировать нечего/некуда.
        """
        if not text.strip():
            return None
        try:
            from server import atomic_write_json
        except Exception:
            return None
        def apply(state: dict) -> int | None:
            import uuid
            inbox = self.store.mailbox_root / role
            inbox.mkdir(parents=True, exist_ok=True)
            existing = [0]
            if self.store.mailbox_root.is_dir():
                for f in self.store.mailbox_root.glob("*/*.json"):
                    try:
                        existing.append(int(f.name.split("-")[0]))
                    except Exception:
                        pass
            seq = max(state.get("seq", 0), max(existing)) + 1
            state["seq"] = seq
            stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
            token = uuid.uuid4().hex[:6]
            body = {"seq": seq, "from": "pairpilot", "to": role,
                    "ts": utcnow(), "subject": "",
                    "label": "Chat from pairpilot: ", "text": text.strip()}
            atomic_write_json(inbox / f"{seq:06d}-{stamp}-pairpilot-{token}.json", body)
            return seq
        try:
            seq = self.store.mutate(apply)
        except Exception:
            return None
        self.store.append_transcript("pilot_mailbox_fallback", "pairpilot",
                                     to=role, seq=seq, text=text[:120])
        return seq

    def pending(self, role: str) -> str:
        path = self.outbox / f"{role}.txt"
        return path.read_text(encoding="utf-8").strip() if path.exists() else ""

    def outbox_file(self, role: str) -> Path:
        """Файл отложенного для роли. Метод, чтобы путь очереди не собирали руками."""
        return self.outbox / f"{role}.txt"

    def flush_outbox(self, state: dict) -> None:
        """Доставить отложенное. Пока композер занят, текст остаётся на месте —
        следующий проход попробует снова. Это и есть переживающая доставка.

        Но переживающая доставка без срока жизни становится доставкой
        протухшего: очередь переживала сессию, и человек получал вопрос, который
        уже не имел отношения к делу. Наблюдалось вживую — напоминание про
        обязательство, закрытое почти за три часа до того, как было составлено,
        лежало в очереди ещё 22 минуты и было доставлено как свежее.

        Поэтому у отложенного есть срок. Молчаливую выброску не делаем: она
        записывается в транскрипт, иначе выброшенное выглядит как «доставлено».
        """
        if self.tmux is None:
            return
        now = time.time()
        for role, info in state.get("roles", {}).items():
            text = self.pending(role)
            if not text or role in self.skip:
                continue
            path = self.outbox / f"{role}.txt"
            try:
                age = now - path.stat().st_mtime
            except OSError:
                continue
            if age > self.outbox_ttl:
                path.unlink(missing_ok=True)
                seq = self.mailbox_fallback(role, text)
                self.store.append_transcript(
                    "pilot_nudge_expired", "pairpilot", to=role,
                    age_seconds=int(age), text=text[:120],
                    fallback_seq=seq)
                log(f"отложенное для {role} протухло в композере "
                    f"{int(age // 60)} мин — дублирую в ящик (seq {seq})")
                continue
            pane = info.get("pane")
            try:
                result = deliver(pane, text, wait_for_empty=0)
            except ComposerBusy:
                continue
            if result.get("delivered"):
                path.unlink(missing_ok=True)
                self.store.append_transcript("pilot_deliver", "pairpilot", to=role, text=text[:120])
                log(f"доставил отложенное для {role}")

    def drop_stale_outbox(self, state: dict) -> None:
        """Снять протухшее в очереди до попытки печати (#18).

        Отдельно от `flush_outbox`, потому что тот без tmux выходит сразу
        и перепроверка не срабатывала бы ни в тестах, ни в проекте без
        tmux. Порядок в `tick` — после `stalled_patches`, до `flush_outbox`:
        свежее условие уже записано, протухшее снимается здесь.
        """
        now = time.time()
        for role in state.get("roles", {}):
            text = self.pending(role)
            if not text:
                continue
            path = self.outbox / f"{role}.txt"
            try:
                age = now - path.stat().st_mtime
            except OSError:
                continue
            if self.nudge_still_true(state, role, text):
                continue
            path.unlink(missing_ok=True)
            self.store.append_transcript(
                "pilot_nudge_stale", "pairpilot", to=role,
                age_seconds=int(age), text=text[:120])
            log(f"отложенное для {role} снято: условие протухло, пока ждало")

    def nudge_still_true(self, state: dict, role: str, text: str) -> bool:
        """Протухло ли условие отложенного, пока оно ждало композер (#18).

        Измерено 2026-10-06: напоминание про sealed-патч zmtcbrb9 легло в
        очередь до `patch_applied`, а доставлено после — агент получил
        ложный «висит неприменённым» при applied=true. Условие читается
        из свежего состояния здесь, а не из момента постановки.
        Неопознанный текст не трогаем: лучше доставить лишнее, чем молча
        выбросить то, чего не поняли.
        """
        low = text.lower()
        if "патч" not in low and "patch" not in low:
            return True
        for _path, record in (state.get("patches") or {}).items():
            if record.get("sealed") and not record.get("applied"):
                return True
        return False

    def visibly_busy(self, pane: str) -> bool:
        """Видно ли по панели, что агент работает прямо сейчас.

        Композер занят — агент печатает или ждёт. Композера не видно вовсе —
        TUI перерисовывается, и бить в этот момент тоже нельзя. Оба случая
        означают «не трогать».
        """
        if self.tmux is None or not pane_alive(self.tmux, pane):
            return False
        try:
            line = composer_line(capture(self.tmux, pane))
        except Exception:  # noqa: BLE001 - панель могла исчезнуть между проверками
            return False
        if line is None:
            return True
        return not is_composer_empty(line)

    def role_seen_age(self, info: dict) -> float:
        stamp = parse_iso(info.get("last_seen"))
        return (datetime.now(timezone.utc) - stamp).total_seconds() if stamp else float("inf")

    def unread(self, state: dict, role: str) -> int:
        return self.count_messages(role) - int(state.get("seen", {}).get(role, 0))

    def count_messages(self, role: str) -> int:
        inbox = self.state_dir / "mailbox" / role
        return len(list(inbox.glob("*.json"))) if inbox.exists() else 0

    def unread_peers(self, state: dict) -> list[str]:
        """Кого разбудить из-за непрочитанного. Молчание в этом случае НЕ дефект:
        агент не читает потому, что не знает, что есть письмо. Сообщаем один раз."""
        out = []
        for role in state.get("roles", {}):
            if role in self.skip:
                continue
            missing = self.unread(state, role)
            if missing <= 0:
                continue
            out.append(role)
            key = f"unread-{role}"
            if self.remember(key):
                text = (f"[pairpilot] У тебя {missing} непрочитанных сообщений. "
                        f"Вызови pair_read и ответь соседу. Если всё сделано — "
                        f"предложи следующий кусок работы через pair_note.")
                # Не печатаем: пишем факт пробуждения и ждём опроса. Раньше печать
                # в композер была первым шагом, и «не печатать» означало «не
                # знать», когда ещё можно. Теперь «не печатать» — это норма, и
                # вопрос «будил или проснулся сам» имеет наблюдаемый ответ.
                self.mark_wake(state, role, f"{missing} непрочитанных", text)
                # Напоминание попадает в журнал: §11 требует, чтобы по журналу
                # было видно, что происходило, а этот шаг раньше не оставлял следа.
                # Без записи повторяющийся поток был бы невидим, и «один раз» нечем
                # было бы проверить.
                self.store.append_transcript("pilot_unread_nudge", "pairpilot",
                                             target=role, unread=missing)
                log(f"{role}: {missing} непрочитанных, жду молча")
        return out

    def stale_writer(self, state: dict) -> None:
        """Писатель молчит дольше порога, а фаза не закрыта. Хуже всего это
        заканчивается ночью: двигать фазу может только он, поэтому её никто не
        сдвинет, и работа встанет до утра."""
        writer = state.get("writer")
        if not writer or state.get("phase") == "done":
            return
        if writer in self.skip:
            return
        info = (state.get("roles") or {}).get(writer)
        if not info:
            return
        pane = info.get("pane")
        if pane and self.visibly_busy(pane):
            # last_seen меряет участие в протоколе, а не работу. Писатель,
            # погружённый в длинную правку, не зовёт pair_* инструменты, и часы
            # у него сходят, хотя он работает. Видимая занятость — честнее часов.
            return
        age = self.role_seen_age(info)
        if age < self.silence:
            return
        key = f"stale-writer-{state.get('round')}"
        if not self.remember(key):
            return
        text = (f"[pairpilot] Ты молчишь {int(age // 60)} минут, а держишь право "
                f"записи в фазе {state.get('phase')!r}. Двигать фазу больше некому, "
                f"и работа встанет до утра. Продолжай свою часть, закрой фазу, "
                f"либо пиши в заметку, что заблокировано и чем. Помечать «делаю» "
                f"не считается: нужен реальный шаг или явная блокировка.")
        self.mark_wake(state, writer, f"молчит {int(age // 60)} мин и держит фазу", text)
        log(f"{writer} молчит {int(age // 60)} мин и держит фазу {state.get('phase')!r} "
            f"— жду молча")

    def pending_answers(self, state: dict) -> None:
        """Отправили запрос, ответа нет. Это хуже молчания: молчание может означать
        «работаю», а отсутствие ответа на конкретный вопрос — что вопрос умер в
        ящике. Сначала дёргаем того, кому отвечать: обычно он просто не дочитал.
        Потом, если молчит и автор, — того, кто ждёт."""
        root = self.state_dir / "obligations"
        if not root.is_dir():
            return
        now = datetime.now(timezone.utc)
        for path in sorted(root.glob("*.json")):
            try:
                record = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                path.unlink(missing_ok=True)
                continue
            opened = parse_iso(record.get("opened_at"))
            if opened is None:
                path.unlink(missing_ok=True)
                continue
            age = (now - opened).total_seconds()
            seq, sender, receiver = record.get("seq"), record.get("from"), record.get("to")
            subject = (record.get("subject") or "").strip()

            if receiver and age >= self.reply_grace and receiver not in self.skip:
                key = f"reply-{seq}-{receiver}"
                if self.remember(key):
                    text = (f"[pairpilot] {sender} ждёт ответа на запрос {seq} "
                            f"уже {int(age // 60)} мин{f': {subject}' if subject else ''}. "
                            f"Это запрос с expects_reply, а ответа в его почте нет. "
                            f"Ответь или скажи, что он больше не нужен.")
                    self.enqueue(receiver, text)
                    log(f"{receiver} не ответил на запрос {seq} от {sender} "
                        f"({int(age // 60)} мин)")

            if sender and age >= self.reply_hard and sender not in self.skip:
                key = f"waiting-{seq}-{sender}"
                if self.remember(key):
                    text = (f"[pairpilot] Ты ждёшь ответа на запрос {seq} от {receiver} "
                            f"уже {int(age // 60)} мин{f': {subject}' if subject else ''}. "
                            f"Ответа нет. Не жди вечно: сделай следующий шаг сам, "
                            f"запиши в заметку, что запрос завис без ответа, и двигайся дальше.")
                    self.enqueue(sender, text)
                    log(f"{sender} ждёт ответа на запрос {seq} уже {int(age // 60)} мин")

    def dead_pane(self, state: dict) -> None:
        """Окно агента исчезло. Подтолкнуть нечем — это тот случай, где человек
        нужен по-настоящему. Но сказать об этом надо громко и один раз, а не
        оставлять догадываться."""
        if self.tmux is None:
            return
        for role, info in (state.get("roles") or {}).items():
            pane = info.get("pane")
            if role in self.skip:
                continue
            if not pane:
                # Ростер без панели, но процесс роли может жить в панели:
                # TMUX_PANE в окружении MCP-сервера бывает пуст. Обратный путь
                # по pid из ростера — и запись чинится, будить снова есть куда.
                healed = ""
                pid = info.get("pid")
                if isinstance(pid, int) and pid > 0 and is_pid_alive(pid):
                    healed = find_pane_of_pid(self.tmux, pid)
                if healed:
                    def heal(st):
                        st.get("roles", {}).get(role, {})["pane"] = healed
                    self.store.mutate(heal)
                    self.store.append_transcript("pilot_pane_healed", "pairpilot",
                                                 target=role, pane=healed)
                    log(f"{role}: панель {healed} найдена по процессу — чиню ростер")
                    continue
                if self.remember(f"nopane-{role}"):
                    self.store.append_transcript("pilot_pane_missing", "pairpilot", target=role)
                    log(f"{role}: панели нет, он вне tmux — подтолкнуть нечем")
                continue
            if pane_alive(self.tmux, pane):
                continue
            key = f"deadpane-{role}-{pane}"
            if not self.remember(key):
                continue
            self.store.append_transcript("pilot_pane_dead", "pairpilot", target=role, pane=pane)
            log(f"{role}: панель {pane} мертва — нужно открыть окно")

    # -------------------------------------------------------------- restart

    def restart_agent(self, state: dict) -> None:
        """Перезапустить агента, процесс которого умер, а окно ещё живо.

        Именно этот случай стоил нам ночи: pid GONE, а запись в ростере живёт
        часами, потому что перезапускать некому и сказать некому.

        Чего перезапуск НЕ делает, хотя мог бы, и почему:

        - не трогает право записи. Роль возвращается с тем же именем из
          MCP-конфига, а писателем остаётся тот, кого назначил человек. Это и
          делает перезапуск безопасным: он чинит процесс, а не границу доверия
          (PROTOCOL.md §2). Авторитет по-прежнему двигает только человек;
        - не поднимает панель, которой нет. Окно, закрытое человеком, не
          resurrected'ится молча: это не зависание, это решение, и решение
          человека;
        - не трогает живой процесс, даже если тот молчит. Молчание лечится
          напоминанием, смерть — перезапуском. Смешивать их нельзя: убитый
          сосед не потеряет контекст, а занятый работой — потеряет.
        """
        if self.tmux is None or autonomy(state) == "observe":
            return
        for role, info in (state.get("roles") or {}).items():
            if role in self.skip:
                continue
            pid = info.get("pid")
            if not isinstance(pid, int) or pid <= 0 or is_pid_alive(pid):
                continue
            pane = info.get("pane")
            if not pane or not pane_alive(self.tmux, pane):
                if self.remember(f"restart-nopane-{role}"):
                    self.store.append_transcript("pilot_restart_impossible", "pairpilot",
                                                 target=role, pid=pid, why="нет живой панели")
                    log(f"{role}: процесс мёртв (pid {pid}), но окна нет — нужен человек")
                continue
            # Панель могла достаться роли по наследству: запись агента осталась, а
            # сидит там уже кто-то живой. Стучаться в чужое окно бессмысленно —
            # respawn без -k всё равно откажет, но лишний шум в журнале хуже.
            #
            # Проверка идёт ПЕРЕД обновлением pid, и порядок здесь не вкус: если
            # спросить про панель раньше, то у чужой роли найдётся её живой pid,
            # и мы запишем его в запись ЭТОЙ роли. Две записи об одном процессе —
            # это ровно то состояние, из которого ростер потом не разберётся, кто
            # где сидит.
            squatter = self.pane_occupied_by_other(state, role, pane)
            if squatter:
                if self.remember(f"restart-squat-{role}-{pane}"):
                    self.store.append_transcript("pilot_restart_impossible", "pairpilot",
                                                 target=role, pid=pid, pane=pane,
                                                 why=f"панель занята живой ролью {squatter}")
                    log(f"{role}: панель {pane} занята живой ролью {squatter} — не трогаю")
                continue
            # Панель жива, а роль в записи мертва — но это ещё не значит, что роль
            # упала. Номер `%N` и вообще адрес панели переживают смерть процесса,
            # который её занимал, а роль могла перезапуститься сама: тогда в панели
            # есть живой агент, а pid в ростере устарел. Пытаться в этом состоянии
            # поднять роль — значит убить живого агента вместе с его контекстом.
            #
            # Здесь была причина 21 попытки перезапуска живой панели за ночь: pid
            # протух, панель жива, а роль цела. Лечится не перезапуском, а
            # обновлением pid из панели — это и есть «живость по панели».
            #
            # Обновление идемпотентно и по гонке тоже: если роль перезапустилась
            # между чтением состояния и записью, `remember` уже отработал по старому
            # pid, а следующий тик увидит живой pid и ничего не сделает.
            occupant = self.pane_occupant(role, pane)
            if occupant:
                if self.remember(f"refresh-{role}-{pid}"):
                    self.store.append_transcript("pilot_pid_stale_pane_alive", "pairpilot",
                                                 target=role, pane=pane, pid=pid,
                                                 live_pid=occupant,
                                                 why="pid в ростере протух, в панели живой процесс")
                    self.store.mutate(lambda s, r=role, p=occupant: s.setdefault("roles", {})
                                      .setdefault(r, {}).update({"pid": p}))
                    log(f"{role}: pid {pid} протух, в панели {pane} живёт {occupant} — "
                        f"обновил запись, перезапуск не нужен")
                continue
            command = self.launch_command(role)
            if not command:
                if self.remember(f"restart-nocmd-{role}"):
                    self.store.append_transcript("pilot_restart_impossible", "pairpilot",
                                                 target=role, pid=pid, why="не знаю команды запуска")
                    log(f"{role}: процесс мёртв, а команды запуска я не знаю — скажи "
                        f"pairpilot --launch {role}='команда' или допиши в .pair/restart.json")
                continue
            # Два ограничения, и оба нужны. Отметка по pid не даёт трогать один
            # и тот же упавший процесс снова. Но её одной НЕ хватает: если
            # команда запуска неверна, процесс умирает с новым pid, отметка
            # каждый раз новая, и при интервале 15 секунд это бесконечный цикл.
            # Потолок в окне не зависит от pid вообще и останавливает именно его.
            if not self.remember(f"restart-{role}-{pid}-{state.get('round')}"):
                continue
            if not self.restart_allowed(role):
                self.store.append_transcript(
                    "pilot_restart_throttled", "pairpilot", target=role, pane=pane, pid=pid,
                    command=self.launch_command(role),
                    reason=f"{self.restart_limit} перезапусков за {int(self.restart_window / 60)} мин")
                log(f"{role}: перезапуск приостановлен — {self.restart_limit} попыток за "
                    f"{int(self.restart_window / 60)} мин. Похоже, команда запуска неверна: "
                    f"{self.launch_command(role)!r}. Ждёт человек.")
                continue
            self.note_restart(role)
            result = subprocess.run(
                # Без -k. tmux отказывается перезапускать живую панель, и это
                # ровно то, что нужно: если после смерти агента в панели открыт
                # шелл или отладчик, он принадлежит человеку, и -k его убивал бы.
                # Перезапуск срабатывает только там, где панель действительно мертва,
                # а занятую панель мы оставляем человеку с записью в транскрипт.
                [self.tmux, "respawn-pane", "-t", pane, command],
                capture_output=True, text=True, timeout=15)
            if result.returncode == 0:
                self.store.append_transcript("pilot_restart", "pairpilot", target=role,
                                             pane=pane, pid=pid, command=command)
                # Перезапуск поднимает процесс, а не память: у вернувшейся роли
                # нет ни задачи, ни истории раунда. Команда запуска в профилях —
                # «agy», «claude» — без --resume, и подробности того, как
                # продолжить сессию, не знает никто, кроме человека.
                #
                # Поэтому оставляем записку, а не угадываем флаг: она указывает
                # на журнал задач, где написано, что осталось. Работает с любым
                # CLI и не требует от профиля знания протокола.
                note = self.state_dir / "notes" / f"pilot-restart-{role}.md"
                try:
                    note.parent.mkdir(parents=True, exist_ok=True)
                    note.write_text(
                        f"# Перезапуск роли {role}\n\n"
                        f"Процесс {pid} был мёртв, роль поднята заново в {pane}.\n"
                        f"Контекста раунда у тебя нет — это цена перезапуска.\n\n"
                        f"Что делать: прочитай `.pair/tasks.md`. Там список задач, что\n"
                        f"сделано, чем доказано и что осталось за открытыми пунктами.\n"
                        f"Фаза раунда и писатель — в `pairctl status`.\n",
                        encoding="utf-8")
                except OSError as error:
                    self.store.append_transcript("pilot_restart_note_failed", "pairpilot",
                                                 target=role, error=str(error)[:120])
                log(f"{role}: процесс {pid} был мёртв, перезапустил в {pane} ({command})")
                writer = " — это писатель, фаза продолжится" if role == state.get("writer") else ""
                if writer:
                    log(writer)
            else:
                # Панель занята — почти всегда это человек или его шелл после
                # падения агента. Говорим прямо, что это не зависание.
                detail = (result.stderr or result.stdout or "").strip()[:120]
                self.store.append_transcript("pilot_restart_failed", "pairpilot", target=role,
                                             pane=pane, pid=pid, command=command, why=detail)
                log(f"{role}: перезапуск не удался — {detail or 'причина не названа'}")

    def stalled_patches(self, state: dict) -> None:
        """Sealed-патч, который никто не применил и не отклонил.

        Дыра была структурной: `applied` записывался при резервировании и больше
        никогда не менялся, так что «применён» и «лежит с прошлой ночи» выглядели
        одинаково. Теперь применение фиксирует писатель, закрытие раунда требует
        разобраться с каждым патчем, а сверхвизор говорит обеим сторонам.

        Сам патч сверхвизор не применяет. Это правка файлов проекта не писателем,
        то есть ровно тот обход §1, ради которого схема и выглядит надёжной.
        """
        if state.get("phase") == "done" or state.get("mode") == "audit":
            return
        writer = state.get("writer")
        now = datetime.now(timezone.utc)
        for path, record in (state.get("patches") or {}).items():
            if not record.get("sealed") or record.get("applied"):
                continue
            sealed_at = parse_iso(record.get("sealed_at"))
            if sealed_at is None or (now - sealed_at).total_seconds() < self.patch_grace:
                continue
            owner = record.get("owner")
            names = [name for name in (writer, owner) if name and name not in self.skip]
            for name in names:
                key = f"stalled-{path}-{name}"
                if not self.remember(key):
                    continue
                if name == writer:
                    text = (f"[pairpilot] Патч {path} запечатан {owner}, sha256 "
                            f"{record.get('sha256')} и до сих пор не применён. Проверь его "
                            f"pair_patch_verify и либо примени и запиши pair_patch_applied, "
                            f"либо отпусти через pair_patch_release с причиной: раунд не "
                            f"закроется, пока это не решено.")
                else:
                    text = (f"[pairpilot] Твой патч {path} запечатан и висит неприменённым. "
                            f"Скажи соседу: он применён или отклонён, и запиши это через "
                            f"pair_patch_applied либо pair_patch_release. Молчание здесь "
                            f"выглядит как готовность, а её нет.")
                self.enqueue(name, text)
                log(f"патч {path} висит неприменённым, {name} поставлен в известность")

    def allowlist(self) -> list[str]:
        """Белый список разрешений: явный аргумент, потом файл человека.

        Файла нет — список по умолчанию, и это граница, которую задал человек:
        внутри проекта можно всё, что нужно для работы, запрещено то, что вредит
        системе, чужому проекту или необратимо стирает. Запреты проверяются первыми
        и не отменяются настройкой.

        Раньше здесь был пустой список, а пустой значил «не подтверждать ничего».
        Файла `.pair/permissions.json` при этом не существовало, так что сверхвизор
        не подтверждал ни одного промпта — и снаружи это выглядело как молчание
        соседа, а не как отказ по настройке.
        """
        if self.allow is not None:
            return self.allow
        try:
            patterns, on_default = load_allow_patterns(str(permissions_path(self.state_dir)))
        except Exception:  # noqa: BLE001
            return []
        if on_default:
            self.note_default_allowlist()
        return patterns

    def note_default_allowlist(self) -> None:
        """Сказать в журнал, что работа идёт на списке по умолчанию.

    Один раз за процесс. Молча работать на дефолтном списке нельзя: человек,
    читая журнал, должен видеть, каким правилом подтверждались его команды.
    """
        if self._default_list_named:
            return
        self._default_list_named = True
        from composer import DEFAULT_ALLOW_PATTERNS
        self.store.append_transcript(
            "pilot_default_allowlist", "pairpilot",
            patterns=len(DEFAULT_ALLOW_PATTERNS),
            file=str(permissions_path(self.state_dir)),
            note="permissions.json не найден, работаю на списке по умолчанию; "
                 "запреты §12 действуют независимо от него")
        log("permissions.json не найден — работаю на списке по умолчанию "
            f"({len(DEFAULT_ALLOW_PATTERNS)} шаблонов). Запреты §12 действуют всегда.")

    def unblock(self, state: dict) -> None:
        """Агент стоит на [y/N]. До утра это выглядит как зависание, хотя всего
        один Enter всё решил бы.

        Но «один Enter» — это ещё и «y» на вопросе «rm -rf?». Поэтому
        подтверждается только то, что попало в белый список, а по умолчанию он
        состоит из чтения. Отказ — не ошибка, а результат: панель остаётся
        заблокированной, и об этом должен узнать человек."""
        if self.tmux is None or autonomy(state) == "observe":
            return
        allow = self.allow
        for role, info in (state.get("roles") or {}).items():
            pane = info.get("pane")
            if not pane or role in self.skip or not pane_alive(self.tmux, pane):
                continue
            try:
                result = resolve_permission_prompt(self.tmux, pane, allow=allow)
            except Exception:  # noqa: BLE001 - сверхвизор не должен падать из-за панели
                continue
            prompt = result.get("prompt") or ""
            if result.get("approved"):
                if self.remember(f"unblock-{role}-{stable_tag(prompt)}"):
                    self.store.append_transcript("pilot_unblock", "pairpilot", target=role,
                                                 prompt=prompt[:120], matched=result.get("matched"))
                    log(f"{role}: подтвердил запрос разрешения — {prompt[:60]}")
            elif result.get("verdict") == "refuse":
                if self.remember(f"unblock-refused-{role}-{stable_tag(prompt)}"):
                    self.store.append_transcript("pilot_unblock_refused", "pairpilot", target=role,
                                                 prompt=prompt[:120], why=result.get("why"))
                    log(f"{role}: НЕ подтвердил «{prompt[:50]}» — {result.get('why')}. Нужен человек.")

    # ---------------------------------------------------------------- report

    def checkpoint(self, state: dict) -> None:
        """Человеку нужен дайджест, а не вопрос из пустоты.

        В autonomy=semi закрыть раунд нельзя без `bin/pairctl ok`. Значит,
        если этого слова нет, а раунд дошёл до проверки, человек должен получить
        всё, что нужно для решения, и команду, которой это решается. Иначе
        «полуавтомат» — это способность остановиться и ждать, ничего не говоря.
        """
        if autonomy(state) != "semi" or state.get("phase") != "verify":
            return
        round_number = state.get("round")
        if not self.remember(f"checkpoint-{round_number}"):
            return
        blockers = _done_blockers(state)
        if not blockers:
            return
        path = self.outbox / f"checkpoint-{round_number}.md"
        lines = [
            f"# Чекпоинт раунда {round_number}",
            "",
            f"- задача: {state.get('task') or 'НЕ ЗАДАЧЕНА'}",
            f"- писатель: {state.get('writer') or 'НЕ НАЗНАЧЕН'}",
            f"- режим раунда: {state.get('mode')}   автономность: semi",
            "",
            "## Что мешает закрыть раунд",
            "",
        ]
        lines += [f"- {item}" for item in blockers]
        lines += [
            "",
            "## Что сделать",
            "",
            "Прочитай это и одно слово в ответ:",
            "",
            f"    bin/pairctl ok",
            "",
            "Либо, если работа должна идти дальше без тебя до утра:",
            "",
            "    bin/pairctl autonomy auto",
            "",
        ]
        path.write_text("\n".join(lines), encoding="utf-8")
        self.store.append_transcript("pilot_checkpoint", "pairpilot", round=round_number,
                                     path=str(path), blockers=len(blockers))
        log(f"раунд {round_number} ждёт одного слова человека: {path}")

    def report_once(self, state: dict) -> None:
        """Человек должен получить результат, а не молчание. Пишем отчёт в файл,
        когда раунд закрыт; в консоль выводим путь."""
        if state.get("phase") != "done" or not state.get("closed_at"):
            return
        key = f"report-{state.get('round')}"
        if not self.remember(key):
            return
        path = write_report(self.state_dir, state)
        # Журнал сессии пишется рядом с отчётом: раунд закрыт — значит человек
        # вернётся и захочет одним взглядом увидеть, что было заказано, что
        # сделано и что осталось за открытыми задачами.
        journal = write_tasks_md(self.state_dir, state)
        self.store.append_transcript("pilot_report", "pairpilot", path=str(path),
                                     journal=str(journal))
        log(f"раунд {state.get('round')} закрыт, отчёт: {path}, журнал: {journal}")

    # ------------------------------------------------------------------ tick

    def tick(self) -> dict:
        state = self.state()
        # Роли, сидящие на общей панели, неразличимы: в них не тыкаем.
        self.skip = {role for names in self.shared_panes(state).values() for role in names}
        # Свою панель не трогаем никогда: там ввод человека.
        if self.own_pane:
            own_key = self.pane_key(self.own_pane)
            for role, info in (state.get("roles") or {}).items():
                # Своя панель приходит из окружения как `%N`, а роль записана
                # адресом сессии. Сравнение строк перестаёт срабатывать, и
                # сверхвизор начинает вбивать сообщения в панель человека.
                if self.pane_key(info.get("pane")) == own_key:
                    self.skip.add(role)
                    if self.remember(f"ownpane-{role}-{self.own_pane}"):
                        log(f"{role} сидит в моей же панели {self.own_pane} — не трогаю её")
                        self.store.append_transcript("pilot_own_pane", "pairpilot",
                                                     target=role, pane=self.own_pane)
        self.ambiguous(state)
        self.gone_roles(state)
        self.unblock(state)
        self.restart_agent(state)
        self.dead_pane(state)
        self.unread_peers(state)
        # Опрос идёт ДО постановки новых пробуждений и до печати: у кого роль уже
        # проснулась, пробуждение снимается молча, и в очередь печати не попадает
        # ничего. Если бы опрос шёл после flush_outbox, то тик, в котором роль
        # только что проснулась, всё равно напечатал бы в её композер.
        self.poll_wakes(state)
        self.pending_answers(state)
        self.stalled_patches(state)
        self.drop_stale_outbox(state)
        self.flush_outbox(state)
        self.stale_writer(state)
        self.checkpoint(state)
        self.report_once(state)
        return state


def _done_blockers(state: dict) -> list[str]:
    """Что мешает закрыть раунд — тем же кодом, что и сервер.

    Правило принадлежит серверу, и вторая его копия рано или поздно разошлась бы
    с первой: человек получил бы отчёт «всё хорошо» от одной стороны и отказ от
    другой. Поэтому сверхвизор не переписывает правило, а спрашивает его у того,
    кто его применяет.
    """
    return done_blockers(state)


def write_report(state_dir: Path, state: dict) -> Path:
    """Один экран для человека: что сделано, чем это доказано и что НЕ покрыто."""
    transcript = state_dir / "transcript.jsonl"
    events: list[dict] = []
    if transcript.exists():
        for raw in transcript.read_text(encoding="utf-8", errors="replace").splitlines():
            if raw.strip():
                try:
                    events.append(json.loads(raw))
                except json.JSONDecodeError:
                    pass
    kinds: dict[str, int] = {}
    for event in events:
        kinds[event.get("kind", "?")] = kinds.get(event.get("kind", "?"), 0) + 1
    refused = sum(v for k, v in kinds.items() if k in ("refuse", "refused", "deliver_busy"))
    denied = kinds.get("pilot_unblock_refused", 0) + kinds.get("unblock_refused", 0)
    restarted = kinds.get("pilot_restart", 0)
    dropped = [event for event in events if event.get("kind") == "patch_dropped"]
    restarts_blocked = [event for event in events if event.get("kind") == "pilot_restart_impossible"]
    evidence = [item for item in (state.get("evidence") or [])
                if item.get("round") == int(state.get("round", 0))]
    stalled = [path for path, record in (state.get("patches") or {}).items()
               if record.get("sealed") and not record.get("applied")]

    notes = []
    notes_dir = state_dir / "notes"
    if notes_dir.exists():
        for path in sorted(notes_dir.glob("*.md"), key=lambda p: p.stat().st_mtime)[-12:]:
            head = next((ln.strip("# ").strip() for ln in
                         path.read_text(encoding="utf-8", errors="replace").splitlines()
                         if ln.startswith("#")), path.stem)
            notes.append(f"- {path.stem}: {head}")

    lines = [
        f"# Отчёт по раунду {state.get('round')}",
        "",
        f"- задача: {state.get('task') or 'НЕ ЗАДАЧЕНА'}",
        f"- фаза: {state.get('phase')}   режим: {state.get('mode')}   автономность: {autonomy(state)}",
        f"- писатель: {state.get('writer') or 'НЕ НАЗНАЧЕН'}",
        "",
        "## Задачи: готово / не готово",
        "",
    ]
    task_items = tasks_of(state)
    if task_items:
        marks = {"open": "НЕ СДЕЛАНО", "done": "сделано", "dropped": "брошено"}
        for item in task_items:
            line = f"- #{item.get('id')} {marks.get(item.get('status'), '?')}: " \
                   f"{str(item.get('text'))[:90]}"
            if item.get("status") == "dropped" and item.get("reason"):
                line += f" — {str(item.get('reason'))[:60]}"
            lines.append(line)
        unclosed = [i["id"] for i in task_items if i.get("status") == "open"]
        if unclosed:
            lines += ["", f"РАУНД НЕ ЗАКРЫТ: открытые задачи {', '.join(f'#{i}' for i in unclosed)}"]
    else:
        lines.append("- задач не заведено")
    lines += [
        "",
        "## Доказательства этого раунда",
        "",
    ]
    if evidence:
        for item in evidence:
            mark = "OK " if item.get("ok") else "FAIL"
            lines.append(f"- {mark} {item.get('kind')} [{item.get('role')}] {item.get('value')}")
    else:
        lines.append("- НИ ОДНОГО. Раунд закрыт без единого машинного факта.")
    lines += [
        "",
        "## Что в транскрипте",
        "",
    ]
    for kind, count in sorted(kinds.items(), key=lambda kv: -kv[1]):
        lines.append(f"- {kind}: {count}")
    lines += [
        "",
        f"Отказов и потерянных доставок: {refused}.",
        f"Разрешений НЕ подтверждено автоматически: {denied}.",
        f"Перезапущено упавших агентов: {restarted}.",
        "",
        "## Чего этот отчёт НЕ доказывает",
        "",
        "- что код правильный: доказывают тесты, а не заметки;",
        "- что всё в задаче сделано: сверхвизор видит события, а не смысл работы.",
        "",
        "## НЕ ПОКРЫТО",
        "",
    ]
    if stalled:
        lines.append("Sealed-патчи без применения и без отклонения:")
        lines += [f"- {path}" for path in stalled]
    else:
        lines.append("- sealed-патчей без применения нет.")
    if dropped:
        lines.append(f"Отклонённые патчи (сознательно снятые): {len(dropped)}")
    if restarts_blocked:
        lines.append("Перезапуск не состоялся, нужен человек:")
        lines += [f"- {event.get('target')}: {event.get('why')}" for event in restarts_blocked]
    if denied:
        lines.append("Запросы разрешения, оставленные человеку:")
        lines += [f"- {event.get('target')}: {event.get('why')}"
                  for event in events if event.get("kind") in ("pilot_unblock_refused", "unblock_refused")]
    if state.get("phase") != "done":
        blockers = _done_blockers(state)
        lines.append("Что мешает закрыть раунд:")
        lines += [f"- {item}" for item in blockers] or ["- ничего"]
    lines += [
        "",
        "## Последние заметки",
        "",
    ]
    lines += notes or ["- нет"]
    lines += [""]
    out = state_dir / "REPORT.md"
    out.write_text("\n".join(lines), encoding="utf-8")
    return out


def main() -> int:
    parser = argparse.ArgumentParser(description="Сверхвизор парной работы")
    parser.add_argument("--state", default=os.environ.get("PAIR_STATE", ".pair"))
    parser.add_argument("--interval", type=float, default=DEFAULT_INTERVAL)
    parser.add_argument("--silence", type=float, default=DEFAULT_SILENCE)
    parser.add_argument("--outbox-ttl", type=float, default=DEFAULT_OUTBOX_TTL,
                        help="сколько секунд отложенное напоминание может ждать композер")
    parser.add_argument("--reply-grace", type=float, default=DEFAULT_REPLY_GRACE,
                        help="seconds before the recipient of a request is poked")
    parser.add_argument("--reply-hard", type=float, default=DEFAULT_REPLY_HARD,
                        help="seconds before the author of a request is told it went unanswered")
    parser.add_argument("--patch-grace", type=float, default=DEFAULT_PATCH_GRACE,
                        help="seconds before a sealed patch nobody applied becomes a defect")
    parser.add_argument("--restart-limit", type=int, default=DEFAULT_RESTART_LIMIT,
                        help="max restarts per role per window, whatever the pid. A launch "
                             "command that is known but wrong otherwise loops forever.")
    parser.add_argument("--restart-window", type=float, default=DEFAULT_RESTART_WINDOW,
                        help="seconds the restart limit applies over")
    parser.add_argument("--launch", action="append", default=[], metavar="ROLE=CMD",
                        help="how to start a role if its process dies, e.g. --launch agy=agy. "
                             "Repeatable. Also PAIR_LAUNCH_<ROLE>, or .pair/restart.json.")
    parser.add_argument("--allow", default=os.environ.get("PAIR_PERMISSIONS"),
                        help="permission allowlist: a file of patterns, or a comma-separated "
                             "list. Empty means confirm nothing.")
    parser.add_argument("--once", action="store_true", help="один проход и выход")
    args = parser.parse_args()

    launch: dict[str, str] = {}
    for item in args.launch:
        role, _, command = item.partition("=")
        if role.strip() and command.strip():
            launch[role.strip()] = command.strip()
        else:
            print(f"pairpilot: --launch ждёт ROLE=CMD, получено {item!r}", file=sys.stderr)
            return 2
    allow = load_allow_patterns(args.allow)[0] if args.allow else None

    state_dir = Path(args.state).resolve()
    pilot = Pilot(state_dir, silence=args.silence, interval=args.interval,
                  reply_grace=args.reply_grace, reply_hard=args.reply_hard,
                  patch_grace=args.patch_grace, launch=launch, allow=allow,
                  restart_limit=args.restart_limit, restart_window=args.restart_window,
                  outbox_ttl=args.outbox_ttl)

    if args.once:
        state = pilot.tick()
        log(f"проход сделан: фаза={state.get('phase')} писатель={state.get('writer')}")
        return 0

    log(f"сверхвизор на {state_dir}, порог молчания {int(args.silence)} с, Ctrl-C выход")
    try:
        while True:
            pilot.tick()
            time.sleep(args.interval)
    except KeyboardInterrupt:
        log("выход")
    return 0


if __name__ == "__main__":
    sys.exit(main())
