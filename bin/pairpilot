#!/usr/bin/env python3
"""Pair supervisor: keeps the work moving when nobody watches it.

Why it exists. Agents are passive by design: after a step they return to
waiting for input. While neither writes to the other, the pair stands still,
and only a human can wake it. That is what cost us a night: the delivery
channel broke, both agents stayed idle, and the only working path left was
the operator terminal.

So the pair needs someone watching it from the outside. This script.
It does exactly seven things, and not an eighth:

  1. deliver a queued message once the peer composer frees up
     (surviving delivery: the message lives in outbox until it lands);
  2. nudge a silent agent — silence past the threshold is a defect, not normal;
  3. confirm a stuck permission request, but only from the allowlist;
  4. restart an agent whose process died while its pane is still alive;
  5. report a stuck sealed patch to both sides and hold the round open;
  6. assemble a digest for the human at the semi checkpoint;
  7. write a report when the round closes.

And on principle it does NOT: move phases, grant or take write authority,
commit, apply someone else’s patches, touch project files. Only a human moves
write authority, and if the supervisor could grant it, it would stop being a
constraint (PROTOCOL.md §2). So it settles disputes about who writes
with a message only: "you have been silent this long, here is your duty
from the last event".

Run:

    bin/pairpilot                 # watch
    bin/pairpilot --once          # single pass, for manual checks
    bin/pairpilot --silence 300   # silence threshold, seconds
    bin/pairpilot --launch agy=agy # how to raise a role whose process died
    bin/pairpilot --allow 'r"^git status' # what else may be self-confirmed
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "mcp" / "pair_mailbox"))

try:
    from composer import (  # noqa: E402
        ComposerBusy,
        capture,
        composer_line,
        deliver,
        is_composer_empty,
        _tmux,
        find_pane_of_pid,
        load_allow_patterns,
        pane_alive,
        pane_key,
        pane_role_pid,
        resolve_permission_prompt,
    )
    from panes import pane_belongs_to_project  # noqa: E402 - the pane's project membership
except Exception as error:  # noqa: BLE001 - the reason must stay visible
    print(f"pairpilot: could not attach composer: {error}", file=sys.stderr)
    raise SystemExit(1)

from server import (  # noqa: E402  - after sys.path
    Store,
    autonomy_of,
    done_blockers,
    is_pid_alive,
    open_tasks,
    permissions_path,
    tasks_of,
    utcnow,
    write_tasks_md,
)

DEFAULT_INTERVAL = 15.0
DEFAULT_SILENCE = 600.0
# How long to wait for a request answer before nudging its recipient, and
# how long before telling the request author. 180s: the “both silent +
# obligation hanging” stall wakes via pilot in <5 min with no human (round 33, P1).
DEFAULT_REPLY_GRACE = 180.0
# Lifetime of a queued nudge. Surviving delivery helps while the question
# is alive: with the composer busy, a minute or two of waiting is fine. But a
# question that hung longer stops helping — it only distracts. Observed
# live: a nudge waited 22 minutes for the composer and landed as if fresh.
#
# Must be KNOWINGLY above WAKE_ESCALATE_REPEAT_SECONDS, and this is a
# health condition, not taste: at 600 vs 900 the escalation went stale in queue
# before the repeat reached it. A test pins the ratio.
DEFAULT_OUTBOX_TTL = 1800.0
# How long a role stays silent before a printed wake-up becomes escalation.
#
# The order is deliberately flipped from before: printing into the composer was
# the FIRST step, and silence meant “deliver later” — which almost always meant
# printing. Now printing is the exception, not the rule: first write the fact to a file,
# then poll, and if the role woke on its own, print nothing.
DEFAULT_WAKE_GRACE = 240.0
# How often an escalation may repeat while the role still sleeps. Not “once
# forever” — see may_escalate_again for why. The pause is knowingly above wake_grace.
WAKE_ESCALATE_REPEAT_SECONDS = 900.0
DEFAULT_REPLY_HARD = 2400.0
# How often to re-nudge a stuck request while its obligation hangs.
# Not "once forever": a reply stamp with no TTL woke exactly once per
# project lifetime (round 43), and the stuck request died in silence.
DEFAULT_REPLY_REPEAT = 7200.0
# How long a sealed patch hangs before it becomes a defect, not business
# the writer will pick up in a minute.
DEFAULT_PATCH_GRACE = 1800.0
# Restart ceiling per role in a sliding window. Needed because the pid key
# does not save us: the command may be known and wrong, the pid will be new
# every time, and without a ceiling that is a crash loop, not recovery.
DEFAULT_RESTART_LIMIT = 3
DEFAULT_RESTART_WINDOW = 600.0
DEFAULT_STALL_TIMEOUT = 300.0
PROMPT_MARKERS = (">", "›", "❯")
AUTONOMIES = ("observe", "semi", "auto")


def autonomy(state: dict) -> str:
    """Autonomy level from state, with no invented values.

    An unknown value reads as observe — the level that does the least.
    State written by a newer build must not grant this build more rights
    than the human asked for.
    """
    return autonomy_of(state)


def stable_tag(text: str) -> str:
    """Short stable fingerprint of a string.

    The builtin hash() for strings is randomized per process run, but these
    marks must survive restarts: otherwise after a restart the supervisor
    "forgets" it already nudged the peer and writes the same thing again — all night.
    """
    return hashlib.sha256(text.encode("utf-8", "replace")).hexdigest()[:8]


def stamp_name(key: str) -> str:
    """Mark-file name for a key.

    Keys are built from paths (a patch path, say), and a path inside a file
    name turns into directories that do not exist: `remember()` died with
    FileNotFoundError on the very first patch. So the key is first made safe,
    and a stable fingerprint is appended for uniqueness.
    """
    safe = re.sub(r"[^A-Za-z0-9._-]+", "_", key).strip("_")[:80]
    return f"{safe}.{stable_tag(key)}"


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def parse_iso(value: str | None) -> datetime | None:
    if not value:
        return None
    try:
        return datetime.fromisoformat(value)
    except (TypeError, ValueError):
        return None


def log(message: str) -> None:
    print(f"[{datetime.now().strftime('%H:%M:%S')}] {message}", flush=True)


class Pilot:
    def __init__(self, state_dir: Path, silence: float, interval: float,
                 reply_grace: float = DEFAULT_REPLY_GRACE,
                 reply_hard: float = DEFAULT_REPLY_HARD,
                 reply_repeat: float = DEFAULT_REPLY_REPEAT,
                 patch_grace: float = DEFAULT_PATCH_GRACE,
                 launch: dict[str, str] | None = None,
                 allow: list[str] | None = None,
                 restart_limit: int = DEFAULT_RESTART_LIMIT,
                 restart_window: float = DEFAULT_RESTART_WINDOW,
                 outbox_ttl: float = DEFAULT_OUTBOX_TTL,
                 wake_grace: float = DEFAULT_WAKE_GRACE,
                 stall_timeout: float = DEFAULT_STALL_TIMEOUT) -> None:
        self.state_dir = state_dir
        self.silence = silence
        self.interval = interval
        self.reply_grace = reply_grace
        self.reply_hard = reply_hard
        self.reply_repeat = max(1.0, float(reply_repeat))
        self.patch_grace = patch_grace
        self.allow = allow
        self.restart_limit = max(1, int(restart_limit))
        self.restart_window = max(1.0, float(restart_window))
        self.outbox_ttl = max(1.0, float(outbox_ttl))
        self.stall_timeout = max(1.0, float(stall_timeout))
        self._screen_hashes: dict[str, tuple[str, float]] = {}
        # Store knows root — the state directory itself: server.py does exactly
        # the same. With state_dir.parent we would read a missing state.json.
        self.store = Store(state_dir)
        self.outbox = state_dir / "pilot"
        self.outbox.mkdir(parents=True, exist_ok=True)
        self.wake_root = state_dir / "wake"
        self.wake_root.mkdir(parents=True, exist_ok=True)
        self.wake_grace = max(1.0, float(wake_grace))
        self.reported: set[str] = set()
        self.skip: set[str] = set()
        self._default_list_named = False
        try:
            self.tmux: str | None = _tmux()
        except Exception:
            self.tmux = None
        # The pane the supervisor itself lives in. Usually the operator pane,
        # sometimes the pane of the agent that launched it. Typing anything there
        # is forbidden: human input waits there, and we would eat its text.
        # The daemon must start WITHOUT TMUX_PANE in the environment: an inherited
        # agent-pane address turns its role into "ours" and silently drops it from
        # service (measured 2026-10-07: a pilot with TMUX_PANE=%3332 kept
        # skipping omp via own_pane-skip). Launching from an agent pane without
        # scrubbing the environment quietly stops supervision of that role.
        self.own_pane = os.environ.get("PAIR_PILOT_PANE") or None
        self._explicit_launch = dict(launch or {})

    # ------------------------------------------------------------- restart map

    def _launch_commands(self, given: dict[str, str] | None = None) -> dict[str, str]:
        """How to launch a role when its process died.
        Source order from "explicit" to "guessed": what the human wrote
        themselves, then the profile in cli-profiles.json, then the environment.
        Nothing is guessed by name: a command that does not exist is worse than
        no command, because the pane comes alive and dies at once.

        The map is rebuilt on every access (see `launch_command`), not frozen
        in `__init__`: otherwise a later-added profile (like `pi` on
        2026-10-06) and a `restart.json` edit take effect only after a pilot
        restart. Measured: a 10-05 pilot did not know the `pi` command and wrote
        `pilot_restart_impossible` while the profile was already on disk.
        """
        explicit = dict(getattr(self, "_explicit_launch", None)
                        if given is None else (given or {}))
        out: dict[str, str] = {}
        file_cmd = self.state_dir / "restart.json"
        try:
            if file_cmd.is_file():
                data = json.loads(file_cmd.read_text(encoding="utf-8"))
                if isinstance(data, dict):
                    out.update({str(k): str(v) for k, v in data.items()})
        except (OSError, json.JSONDecodeError):
            log("restart.json is unreadable, taking launch commands from profiles")
        profiles = ROOT / "cli-profiles.json"
        try:
            data = json.loads(profiles.read_text(encoding="utf-8"))
            for name, profile in (data or {}).items():
                if not name.startswith("_") and isinstance(profile, dict) and profile.get("launch"):
                    out.setdefault(name, str(profile["launch"]))
        except (OSError, json.JSONDecodeError):
            pass
        out.update(explicit)
        for role in list(out):
            env_cmd = os.environ.get(f"PAIR_LAUNCH_{re.sub(r'[^A-Za-z0-9]', '_', role).upper()}")
            if env_cmd:
                out[role] = env_cmd
        return out

    def launch_command(self, role: str) -> str:
        return self._launch_commands().get(role, "").strip()

    def supports_compact(self, role: str) -> bool:
        """Whether the role CLI understands /compact (flag in cli-profiles.json).

        pi, omp, opencode. Read on every access, like `_launch_commands`:
        a profile edit takes effect without a pilot restart. An unknown role
        and an unreadable file mean False (default-deny: better to leave
        someone else's input alone than to send garbage there).
        """
        profiles = ROOT / "cli-profiles.json"
        try:
            data = json.loads(profiles.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            return False
        if not isinstance(data, dict):
            return False
        profile = data.get(role)
        return isinstance(profile, dict) and profile.get("supports_compact") is True
    # ------------------------------------------------------------ restart budget

    def restarts_file(self, role: str) -> Path:
        return self.outbox / f".restarts-{role}"

    def restart_history(self, role: str) -> list[float]:
        """When exactly the role was restarted. One timestamp per line."""
        try:
            raw = self.restarts_file(role).read_text(encoding="utf-8").split()
        except OSError:
            return []
        out = []
        for item in raw:
            try:
                out.append(float(item))
            except ValueError:
                continue
        return out

    def note_restart(self, role: str) -> None:
        """Record the attempt and drop everything past the window at once.

        Trimming happens here, at write time, not at read time: otherwise the history
        file would grow without bound over the project lifetime.
        """
        now = time.time()
        keep = [stamp for stamp in self.restart_history(role) if now - stamp < self.restart_window]
        keep.append(now)
        try:
            self.restarts_file(role).write_text(
                " ".join(f"{stamp:.0f}" for stamp in keep), encoding="utf-8")
        except OSError as error:
            log(f"{role}: did not record the restart history ({error}) — the ceiling may not hold")

    def restart_allowed(self, role: str) -> bool:
        """Whether this role is over its restart ceiling inside the window.

        Attempts count regardless of pid: the sliding window also stops a
        process that dies right after start, whose pid is new every time.
        """
        now = time.time()
        recent = [stamp for stamp in self.restart_history(role)
                  if now - stamp < self.restart_window]
        return len(recent) < self.restart_limit

    # ------------------------------------------------------------------ state

    def state(self) -> dict:
        return self.store._load()

    def remember(self, key: str, ttl: float | None = None) -> bool:
        """True if we have not done this yet. Stops repeat writes.

        Without ttl a stamp lives forever: a second event of the same kind
        never wakes again (the unread stamp leaked exactly like that through
        round 43). With ttl a stamp older than ttl refreshes and returns True
        again — a nudge repeats at most once per ttl while the cause hangs.
        """
        stamp = self.state_dir / "pilot" / f".{stamp_name(key)}"
        if stamp.exists():
            if ttl is None:
                return False
            try:
                if time.time() - stamp.stat().st_mtime < ttl:
                    return False
            except OSError:
                pass
        stamp.write_text(now_iso(), encoding="utf-8")
        return True

    def unremember(self, key: str) -> None:
        """Drop the stamp: the event closed, the next one starts clean."""
        stamp = self.state_dir / "pilot" / f".{stamp_name(key)}"
        stamp.unlink(missing_ok=True)

    def panes(self, state: dict) -> dict[str, list[str]]:
        """Who sits on which pane, minus the dead.

        A dead role does not make a pane shared. Seen live: claude and codex
        lingered in the roster on one pane %20, the records outlived their
        processes, and `skip` held all three — including the live agy. The
        supervisor stopped serving the project over two dead neighbours.

        A role counts as live by its process; a pane with no live process is
        just a record, not a window someone sits in. Two independent facts, as
        in `pane_exists`: a pane name does not prove anyone is inside.
        """
        table: dict[str, list[str]] = {}
        for role, info in (state.get("roles") or {}).items():
            pane = info.get("pane")
            if not pane:
                continue
            pid = info.get("pid")
            if isinstance(pid, int) and pid > 0 and not is_pid_alive(pid):
                continue
            table.setdefault(self.pane_key(pane), []).append(role)
        return table

    def pane_key(self, pane: str) -> str:
        """Pane-grouping key, identical for both reference formats.

        Grouping by the raw string broke as soon as session addresses appeared
        in state: `%1` and `mail:0.1` are one pane, but the table saw two.
        Past that it broke `ambiguous()`, which — missing two roles on one
        pane — called it free and struck it: into another agent’s composer.
        """
        return pane_key(self.tmux, pane)

    def stale_roles(self, state: dict) -> dict[str, str]:
        """Roles with a dead process that still linger. Never deleted quietly:
        the roster is shared memory, and the human decides when to clear it."""
        out = {}
        for role, info in (state.get("roles") or {}).items():
            pid = info.get("pid")
            if isinstance(pid, int) and pid > 0 and not is_pid_alive(pid):
                out[role] = f"pid {pid} is gone"
        return out

    def shared_panes(self, state: dict) -> dict[str, list[str]]:
        return {pane: names for pane, names in self.panes(state).items() if len(names) > 1}

    def pane_occupied_by_other(self, state: dict, role: str, pane: str) -> str | None:
        """Live role on this pane, besides `role` itself. None — the pane is free.

        A dead-agent record does not make a pane busy: if someone live is in
        it, restarting the departed role would hit the live neighbour. Count
        by processes only, because a pane name is an address, not evidence.
        """
        key = self.pane_key(pane)
        for other, info in (state.get("roles") or {}).items():
            # Compare by key, not by string: the neighbour may be recorded as a session
            # address while `pane` arrived as `%N`, and it is the same pane. On string
            # comparison the supervisor would call the pane free and restart into it
            # another agent’s agent.
            if other == role or self.pane_key(info.get("pane")) != key:
                continue
            pid = info.get("pid")
            if isinstance(pid, int) and pid > 0 and is_pid_alive(pid):
                return other
        return None

    def pane_occupant(self, role: str, pane: str) -> int:
        """The pid actually sitting in this role’s pane, or 0.

        A role is alive if its pid is alive OR its pane runs a process, but the two
        facts can diverge, and the direction matters. A dead pid on a live pane
        is not a crash: the roster pid went stale while the agent is in place.
        The reverse — a live pid with no pane — is real trouble, and it is
        caught in `dead_pane`.

        A pane held by another live role never reaches here: `restart_agent`
        checks `pane_occupied_by_other` BEFORE this call, otherwise we would
        record the neighbour’s pid into this role’s entry. Checking again here
        would be a second opinion on one fact, not insurance.
        """
        if self.tmux is None or not pane:
            return 0
        occupant = pane_role_pid(self.tmux, pane, role)
        if not occupant or occupant == os.getpid():
            return 0
        return occupant if is_pid_alive(occupant) else 0

    def gone_roles(self, state: dict) -> None:
        """Roles whose process died but whose roster entry stayed.

        Silence is costlier than noise here: such entries made a shared pane
        look busy, and the supervisor stopped waking the live neighbour. Say it
        once per role and leave the call to the human — never clear the roster quietly.
        """
        for role, why in self.stale_roles(state).items():
            if not self.remember(f"gone-{role}"):
                continue
            log(f"{role}: {why}, but the roster entry stayed and the pane counted as shared. "
                f"Clear the roster — `pairctl release` or a new session.")
            self.store.append_transcript("pilot_stale_role", "pairpilot", target=role, why=why)

    def ambiguous(self, state: dict) -> bool:
        """Two roles on one pane means the roster lies, and striking it is forbidden.

        It happens: diagnostics or another script registers a role without wiping
        the mark, and the current pane lands in it. Then "wake claude" would go
        to agy’s window. Better to wake nobody than to wake the wrong one.
        """
        shared = self.shared_panes(state)
        if not shared:
            return False
        key = "shared-" + "-".join(f"{pane}:{','.join(sorted(names))}" for pane, names in sorted(shared.items()))
        if self.remember(key):
            for pane, names in sorted(shared.items()):
                log(f"pane {pane} is listed right after {', '.join(sorted(names))} — leaving it alone")
                self.store.append_transcript("pilot_pane_shared", "pairpilot", pane=pane, roles=sorted(names))
        return True

    # ------------------------------------------------------- wake-up

    def mark_wake(self, state: dict, role: str, reason: str, text: str) -> None:
        """Record that a role must be woken — in a file, not in the composer.

        Printing into the composer was the only way to tell a neighbour "you
        have mail", and it is a bad way: it breaks on a busy TUI, needs the
        moment guessed, and leaves a mark in another window. A file wake-up prints
        nothing — the role sees it itself when it looks at state — and gives the
        supervisor a fact to judge by later: did we wake it, or was it awake.

        The current `last_seen` snapshot goes next to the intent fact. Comparison
        runs against it, not against now: otherwise a role that was awake when
        the question was raised would count as "woken" on the very next tick
        without a single action of its own.
        """
        path = self.wake_root / f"{role}.json"
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            info = (state.get("roles") or {}).get(role) or {}
            # A hanging wake-up is amended, not overwritten.
            #
            # Two wake-up reasons (`unread_peers` and `stale_writer`), but one file
            # per role. Overwriting lost `asked_at` — patience restarted from zero
            # — and the `escalated` flag, so the same fact escalated
            # twice: first for one reason, then, after the overwrite, for the second.
            # The `seen_at_ask` snapshot is taken only at the first raise: it answers
            # "did the role wake after the question", and refreshing it means asking
            # the question anew.
            previous: dict = {}
            try:
                previous = json.loads(path.read_text(encoding="utf-8"))
            except FileNotFoundError:
                previous = {}
            except (OSError, json.JSONDecodeError):
                # Same class as poll_wakes: the file was there but unreadable,
                # and this write heals it by overwrite. Without a record nobody
                # can ever answer "were there damaged wake files".
                self.store.append_transcript("pilot_wake_damaged", "pairpilot",
                                             file=path.name)
                previous = {}
            prior_reasons = previous.get("reasons")
            if not isinstance(prior_reasons, list):
                prior_reasons = [previous["reason"]] if previous.get("reason") else []
            seen = [str(r) for r in prior_reasons]
            if reason not in seen:
                seen.append(reason)
            payload = dict(previous)
            payload.update({
                "role": role,
                "reason": seen[-1],
                "reasons": seen,
                "asked_at": previous.get("asked_at") or utcnow(),
                "seen_at_ask": previous.get("seen_at_ask", info.get("last_seen")),
                "unread_at_ask": int(previous.get("unread_at_ask", self.unread(state, role))),
                "text": text,
            })
            payload.setdefault("asked_at", utcnow())
            path.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
        except OSError as error:
            # Not recorded means nothing to wake with, and that must be said, not
            # faked as if the role got its nudge.
            self.store.append_transcript("pilot_wake_failed", "pairpilot",
                                         target=role, error=str(error)[:120])
            log(f"{role}: could not record the wake-up — {error}")
            return
        self.store.append_transcript("pilot_wake_pending", "pairpilot",
                                     target=role, reason=reason)
        log(f"{role}: {reason}, waiting for the wake-up silently (no printing)")
        self.ring(state, role, reason)

    # Role -> wake module (was `if role == "opencode"`; new = string + wake_<cli>.py).
    WAKE_ADAPTERS = {"opencode": "wake_opencode"}

    def ring(self, state: dict, role: str, reason: str) -> None:
        """Ring the role’s pane: display-message, not composer printing.

        Printing into a busy TUI is garbage in the input line; a ring is a popup
        the agent sees from the corner of its eye and decides itself when to look.
        Throttle by the rung_at field in the wake file: at most once per 5 min,
        otherwise it is the same spam, just without text.

        After the ring — the wake adapter from WAKE_ADAPTERS (fail-closed, shared throttle).
        """
        if self.tmux is None or role in self.skip:
            return
        path = self.wake_root / f"{role}.json"
        if time.time() - self._last_ring(path) < 300:
            return
        pane = ((state.get("roles") or {}).get(role) or {}).get("pane")
        if not pane or not pane_alive(self.tmux, pane):
            return
        pointer = f"[pair] {reason} — pick it up from mailbox via pair_read"
        try:
            subprocess.run([self.tmux, "display-message", "-t", pane,
                            "-d", "4000", pointer],
                           capture_output=True, timeout=5)
        except Exception:
            return
        adapter = self.WAKE_ADAPTERS.get(role)
        if adapter:
            try:
                result = __import__(adapter).wake(self.store.project_root, pointer)
                self.store.append_transcript("pilot_wake_api", "pairpilot",
                                             target=role, woken=result.get("woken"),
                                             why=(result.get("why") or "")[:120])
            except Exception as error:  # noqa: BLE001 - the adapter must not drop the ring
                self.store.append_transcript("pilot_wake_api_failed", "pairpilot",
                                             target=role, error=str(error)[:120])
        else:
            self.store.append_transcript("pilot_wake_no_adapter", "pairpilot", target=role)
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
            payload["rung_at"] = time.time()
            path.write_text(json.dumps(payload, ensure_ascii=False, indent=2),
                            encoding="utf-8")
        except (OSError, ValueError):
            pass
        self.store.append_transcript("pilot_ring", "pairpilot", target=role, reason=reason)

    @staticmethod
    def _last_ring(path) -> float:
        try:
            return float(json.loads(path.read_text(encoding="utf-8")).get("rung_at") or 0)
        except (OSError, ValueError):
            return 0.0

    def poll_wakes(self, state: dict) -> None:
        """Poll hanging wake-ups and decide each: awake or not.

        Three outcomes, each visible in the journal:
        - **awake** — `last_seen` moved or unread dropped to zero.
          Print nothing: the role is already working, waking it would disturb.
        - **patience spent** — the role is silent past `wake_grace`. Then print,
          once, and that is escalation, not the first step.
        - **still waiting** — silence. Silence watched by the supervisor
          costs zero tokens.
        """
        if not self.wake_root.is_dir():
            return
        now = time.time()
        for path in sorted(self.wake_root.glob("*.json")):
            try:
                wake = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                # A damaged wake file cannot be fixed by guessing: it is removed,
                # because otherwise it would hang forever and the role would never hear.
                path.unlink(missing_ok=True)
                self.store.append_transcript("pilot_wake_damaged", "pairpilot",
                                             file=path.name)
                continue
            role = str(wake.get("role") or "")
            info = (state.get("roles") or {}).get(role) or {}
            seen_now = info.get("last_seen")
            seen_ask = wake.get("seen_at_ask")
            unread_now = self.unread(state, role)
            woke = (seen_now != seen_ask) or (unread_now < int(wake.get("unread_at_ask", 0)))
            if woke:
                # The order is mandatory: the file used to be removed first, and `stat`
                # afterwards always said “no file”, so since_seconds stayed
                # at 0 forever — the field that tells how long the role was silent
                # said nothing.
                try:
                    since = int(now - path.stat().st_mtime)
                except OSError:
                    since = 0
                path.unlink(missing_ok=True)
                self.store.append_transcript("pilot_wake_acknowledged", "pairpilot",
                                             target=role, reason=wake.get("reason"),
                                             since_seconds=since)
                log(f"{role}: woke on its own, no printing needed")
                continue
            if self.is_done_parked(state):
                # In done phase the pilot is parked: do not escalate wake files into the composer.
                continue
            asked = parse_iso(wake.get("asked_at"))
            age = now - asked.timestamp() if asked else 0.0
            if age < self.wake_grace:
                continue
            # The pause between repeats and its reason live in may_escalate_again.
            if not self.may_escalate_again(wake, now):
                continue
            self.store.append_transcript("pilot_wake_escalated", "pairpilot",
                                         target=role, reason=wake.get("reason"),
                                         age_seconds=int(age),
                                         repeat=bool(wake.get("escalated")))
            log(f"{role}: silent {int(age // 60)} min past the wake-up — printing")
            self.enqueue(role, str(wake.get("text") or ""))
            wake["escalated"] = True
            wake["escalated_at"] = utcnow()
            path.write_text(json.dumps(wake, ensure_ascii=False, indent=2), encoding="utf-8")

    def may_escalate_again(self, wake: dict, now: float) -> bool:
        """Whether an escalation repeat is due: the role is silent and the pause passed.

        The old contract was "exactly once per role lifetime", and that is a trap
        with no exit: the file is removed only when the role WAKES UP, so a silent
        role can never get a second escalation. Found live — pi was silent an
        hour, the file hung with escalated, the supervisor wrote "waiting 40 min"
        and never printed.

        The pause must be shorter than the queued item’s lifetime, otherwise the
        repeat goes stale in queue before reaching the composer.
        """
        if not wake.get("escalated"):
            return True
        last = parse_iso(wake.get("escalated_at"))
        if last is None:
            return True
        return (now - last.timestamp()) >= WAKE_ESCALATE_REPEAT_SECONDS

    # --------------------------------------------------------------- outbox

    def enqueue(self, role: str, text: str) -> None:
        path = self.outbox / f"{role}.txt"
        if path.exists():
            try:
                old = path.read_text(encoding="utf-8")
            except OSError:
                old = ""
            if old.strip() and old != text:
                # Eviction without a trace is an audit hole: the nudge looks like it
                # "never was". Write the replacement into the journal (round 43).
                self.store.append_transcript("pilot_outbox_replaced", "pairpilot",
                                             to=role, old=old[:120], new=text[:120])
        path.write_text(text, encoding="utf-8")

    def mailbox_fallback(self, role: str, text: str) -> int | None:
        """Mirror the pointer into the recipient mailbox as a pilot letter.

        Outbox goes stale when the composer stays busy past TTL: the agent works,
        printing is forbidden, the pointer is dropped — and the agent never learns
        it was waited for. Mailbox never goes stale: the agent picks the letter up
        via `pair_read` when it chooses. Measured 2026-10-06: two nudge_expired in
        a row, both agents alive, both got nothing.
        Returns the letter seq or None when there is nothing/nowhere to mirror.
        """
        if not text.strip():
            return None
        try:
            from server import atomic_write_json
        except Exception:
            return None
        def apply(state: dict) -> int | None:
            import uuid
            inbox = self.store.mailbox_root / role
            inbox.mkdir(parents=True, exist_ok=True)
            existing = [0]
            if self.store.mailbox_root.is_dir():
                for f in self.store.mailbox_root.glob("*/*.json"):
                    try:
                        existing.append(int(f.name.split("-")[0]))
                    except Exception:
                        pass
            seq = max(state.get("seq", 0), max(existing)) + 1
            state["seq"] = seq
            stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
            token = uuid.uuid4().hex[:6]
            body = {"seq": seq, "from": "pairpilot", "to": role,
                    "ts": utcnow(), "subject": "",
                    "label": "Chat from pairpilot: ", "text": text.strip()}
            atomic_write_json(inbox / f"{seq:06d}-{stamp}-pairpilot-{token}.json", body)
            return seq
        try:
            seq = self.store.mutate(apply)
        except Exception:
            return None
        self.store.append_transcript("pilot_mailbox_fallback", "pairpilot",
                                     to=role, seq=seq, text=text[:120])
        return seq

    def pending(self, role: str) -> str:
        path = self.outbox / f"{role}.txt"
        return path.read_text(encoding="utf-8").strip() if path.exists() else ""

    def outbox_file(self, role: str) -> Path:
        """The queued-item file for a role. A method so the queue path is never hand-built."""
        return self.outbox / f"{role}.txt"

    def flush_outbox(self, state: dict) -> None:
        """Deliver the queued item. While the composer is busy the text stays put —
        the next pass tries again. That is surviving delivery.

        But surviving delivery with no lifetime becomes stale delivery: the queue
        outlived the session, and the human got a question that no longer meant
        anything. Observed live — a nudge about an obligation closed almost three
        hours before it was composed sat in queue 22 more minutes and landed as fresh.

        So a queued item has a lifetime. Silent drops are forbidden: a drop is
        recorded in the transcript, otherwise a dropped item looks "delivered".
        """
        if self.tmux is None:
            return
        now = time.time()
        for role, info in state.get("roles", {}).items():
            text = self.pending(role)
            if not text or role in self.skip:
                continue
            path = self.outbox / f"{role}.txt"
            try:
                age = now - path.stat().st_mtime
            except OSError:
                continue
            if age > self.outbox_ttl:
                path.unlink(missing_ok=True)
                seq = self.mailbox_fallback(role, text)
                self.store.append_transcript(
                    "pilot_nudge_expired", "pairpilot", to=role,
                    age_seconds=int(age), text=text[:120],
                    fallback_seq=seq)
                log(f"queued for {role} went stale in the composer "
                    f"{int(age // 60)} min — mirroring into the mailbox (seq {seq})")
                continue
            pane = info.get("pane")
            try:
                alive = pane_alive(self.tmux, pane)
            except Exception:
                alive = False
            check_failed = False
            try:
                ours, why = pane_belongs_to_project(
                    self.tmux, pane, self.store.project_root)
            except Exception:
                ours, why, check_failed = False, "ownership check unavailable", True
            if not ours and alive and not check_failed:
                # Proven foreign: the pane is alive AND the check itself ran
                # and refused. Never print into it; drop with a record.
                path.unlink(missing_ok=True)
                self.store.append_transcript(
                    "pilot_pane_foreign", "pairpilot", to=role,
                    pane=pane, reason=why, text=text[:120])
                log(f"not delivering for {role} into foreign pane {pane}: {why}")
                continue
            if not ours:
                # Unproven: dead pane or a failed check is NOT proven foreign
                # (panes.py forbids mixing the two facts). Keep the file for
                # the next tick; record once per outbox content.
                if self.remember(f"unproven-{role}-{stable_tag(text)}", ttl=self.outbox_ttl):
                    self.store.append_transcript(
                        "pilot_pane_unproven", "pairpilot", to=role,
                        pane=pane, reason=why, text=text[:120])
                log(f"ownership of pane {pane} unproven ({why}) — keeping for next tick")
                continue
            try:
                result = deliver(pane, text, wait_for_empty=0)
            except ComposerBusy:
                continue
            if result.get("delivered"):
                path.unlink(missing_ok=True)
                self.store.append_transcript("pilot_deliver", "pairpilot", to=role, text=text[:120])
                log(f"delivered the queued item for {role}")

    def drop_stale_outbox(self, state: dict) -> None:
        """Drop what went stale in queue before trying to print (#18).

        Separate from `flush_outbox` because that one exits early without tmux,
        and the re-check would never fire in tests or in a tmux-less project.
        Order in `tick` — after `stalled_patches`, before `flush_outbox`:
        the fresh condition is already recorded, the stale one drops here.
        """
        now = time.time()
        for role in state.get("roles", {}):
            text = self.pending(role)
            if not text:
                continue
            path = self.outbox / f"{role}.txt"
            try:
                age = now - path.stat().st_mtime
            except OSError:
                continue
            if self.nudge_still_true(state, role, text):
                continue
            path.unlink(missing_ok=True)
            self.store.append_transcript(
                "pilot_nudge_stale", "pairpilot", to=role,
                age_seconds=int(age), text=text[:120])
            log(f"queued for {role} dropped: its condition went stale while waiting")

    def nudge_still_true(self, state: dict, role: str, text: str) -> bool:
        """Whether the queued item’s condition went stale while it waited (#18).

        Measured 2026-10-06: a nudge about sealed patch zmtcbrb9 queued before
        `patch_applied` but delivered after — the agent got a false "hangs
        unapplied" at applied=true. The condition reads from fresh state here,
        not from the moment of queueing.
        Measured 2026-10-07 (backlog pilot-nudge-about-closed-obligation):
        a nudge about request 370 left after its obligation file closed.
        So request/seq text checks against the file obligations/<seq>-*.json:
        no file — the condition went stale. Unrecognized text stays untouched:
        better to deliver extra than to silently drop what we did not parse.
        """
        low = text.lower()
        # Bilingual: old RU pointers ("непрочитанных") and new EN ones ("unread").
        if "непрочитанных" in low or "непрочитанн" in low or "unread" in low:
            # Unread-pointer: the condition is checked against state, not text.
            # Measured 2026-10-13 (finding-round87): a pointer raised at unread=1
            # was delivered 62s later at unread=0. Stale — drop it, otherwise
            # every fast reply round-trips a bogus nudge.
            return self.unread(state, role) > 0
        match = re.search(r"(?:запрос|seq)\s+(\d+)", text, re.IGNORECASE)
        if match:
            prefix = f"{int(match.group(1)):06d}-"
            root = self.store.obligations_root
            if root.is_dir() and any(p.name.startswith(prefix) for p in root.glob("*.json")):
                return True
            return False
        if "патч" not in low and "patch" not in low:
            return True
        for _path, record in (state.get("patches") or {}).items():
            if record.get("sealed") and not record.get("applied"):
                return True
        return False

    def visibly_busy(self, pane: str) -> bool:
        """Whether the panel shows the agent working right now.

        Composer busy means the agent types or waits. No composer visible at
        all means the TUI redraws, and striking then is forbidden too. Both mean
        "hands off".
        """
        if self.tmux is None or not pane_alive(self.tmux, pane):
            return False
        try:
            line = composer_line(capture(self.tmux, pane))
        except Exception:  # noqa: BLE001 - the pane may vanish between checks
            return False
        if line is None:
            return True
        return not is_composer_empty(line)

    def role_seen_age(self, info: dict) -> float:
        stamp = parse_iso(info.get("last_seen"))
        return (datetime.now(timezone.utc) - stamp).total_seconds() if stamp else float("inf")

    def unread(self, state: dict, role: str) -> int:
        return self.count_messages(role) - int(state.get("seen", {}).get(role, 0))

    def count_messages(self, role: str) -> int:
        inbox = self.state_dir / "mailbox" / role
        return len(list(inbox.glob("*.json"))) if inbox.exists() else 0

    def is_done_parked(self, state: dict) -> bool:
        """Parked in done phase with no open tasks or obligations.
        Silence escalation and nudge spam are banned in this state to save tokens.
        """
        if state.get("phase") != "done":
            return False
        if open_tasks(state):
            return False
        root = self.state_dir / "obligations"
        if root.is_dir() and any(root.glob("*.json")):
            return False
        key = f"parked-{state.get('round')}"
        if self.remember(key, ttl=3600):
            self.store.append_transcript("pilot_parked", "pairpilot", round=state.get("round"))
            log(f"round {state.get('round')} in done: pilot parked, spam off")
        return True

    def unread_peers(self, state: dict) -> list[str]:
        """Who to wake over unread mail. The postman on watch: a letter in the box
        never sits without a push — memory (wake) and push (outbox) are written together.
        Memory shows who was woken and when; push lets the sleeper learn it
        now: the next flush (this same tick) drives it into the composer.
        """
        out = []
        if self.is_done_parked(state):
            # In done phase with no open tasks or obligations the pilot is parked:
            # no spamming agents with “suggest the next chunk” pushes.
            return out
        for role in state.get("roles", {}):
            if role in self.skip:
                continue
            missing = self.unread(state, role)
            if missing <= 0:
                # Read once — the stamp resets: the next letter wakes anew.
                # Without it the second letter never woke (round 43).
                self.unremember(f"unread-{role}")
                continue
            out.append(role)
            key = f"unread-{role}"
            if self.remember(key):
                text = (f"[pairpilot] You have {missing} unread messages. "
                        f"Call pair_read and answer your neighbour. If all is done — "
                        f"suggest the next chunk via pair_note.")
                self.mark_wake(state, role, f"{missing} unread", text)
                self.enqueue(role, text)
                self.store.append_transcript("pilot_unread_nudge", "pairpilot",
                                             target=role, unread=missing)
                log(f"{role}: {missing} unread, pushing at once")
        return out

    def stale_writer(self, state: dict) -> None:
        """The writer is silent past the threshold while the phase stays open. Its
        worst ending is at night: only it may move the phase, so nobody moves
        it, and the work stands till morning."""
        writer = state.get("writer")
        if not writer or state.get("phase") == "done":
            return
        if writer in self.skip:
            return
        info = (state.get("roles") or {}).get(writer)
        if not info:
            return
        pane = info.get("pane")
        if pane and self.visibly_busy(pane):
            # last_seen measures protocol participation, not work. A writer
            # deep in a long edit never calls pair_* tools, and its clock
            # runs out while it works. Visible busyness is fairer than clocks.
            return
        age = self.role_seen_age(info)
        if age < self.silence:
            return
        key = f"stale-writer-{state.get('round')}"
        if not self.remember(key):
            return
        text = (f"[pairpilot] You are silent {int(age // 60)} minutes while holding write "
                f"rights in phase {state.get('phase')!r}. Nobody else can move the phase, "
                f"and the work will stand till morning. Continue your part, close the phase, "
                f"or write to the note what blocks and how. Marking “doing” "
                f"does not count: a real step or an explicit block is needed.")
        self.mark_wake(state, writer, f"silent {int(age // 60)} min holding the phase", text)
        self.enqueue(writer, text)
        log(f"{writer} silent {int(age // 60)} min holding phase {state.get('phase')!r} "
            f"— pushing at once")

    def idle_roles(self, state: dict) -> None:
        """A silent role with no incoming is not "nothing to say" but lost contact.

        The pilot triggers used to be reactive: unread mail (`unread_peers`),
        obligations (`pending_answers`) and the silent WRITER (`stale_writer`,
        with self.silence applied to it alone). A passive critic in a new session
        has no incoming events at all: the task is written only to state.json,
        the mailbox is empty. Measured 2026-10-11 from the transcript: in 2 of 8
        rounds the writer sent the neighbour not a single message before the
        phase moved, and nobody woke the critic — the human symptom of "one
        agent works, the other is silent".

        So the silence threshold applies symmetrically to a role with no
        incoming: neither unread mail nor a visible work source. One push per
        round (`remember` with a two-threshold TTL) — otherwise it is the same
        spam banned in `ring`. A closed round is never woken: there silence is
        normal. The writer stays untouched: `stale_writer` owns it.
        """
        writer = state.get("writer")
        if not writer or state.get("phase") == "done":
            return
        for role, info in (state.get("roles") or {}).items():
            if role == writer or role in self.skip or not isinstance(info, dict):
                continue
            pane = info.get("pane")
            if pane and self.visibly_busy(pane):
                # A busy composer is work, not silence: the same rule as the writer’s
                # in stale_writer.
                continue
            if self.unread(state, role) > 0:
                # Mail wakes its own path (unread_peers); a second push with
                # the same text is spam.
                continue
            age = self.role_seen_age(info)
            if age < self.silence:
                continue
            key = f"stale-role-{state.get('round')}-{role}"
            if not self.remember(key, ttl=self.silence * 2):
                continue
            text = (f"[pairpilot] You are silent {int(age // 60)} minutes with no "
                    f"incoming, phase {state.get('phase')!r}, writer {writer}. "
                    f"Call pair_digest: the round task and what is done live there. "
                    f"Take the next chunk or write to the note what blocks you — "
                    f"“doing” does not count, a step or an explicit block is needed.")
            self.mark_wake(state, role, f"silent {int(age // 60)} min with no incoming", text)
            self.enqueue(role, text)
            self.store.append_transcript("pilot_idle_role", "pairpilot", target=role,
                                         minutes=int(age // 60))
            log(f"{role} silent {int(age // 60)} min with no incoming — pushing at once")

    def check_stalled_busy(self, state: dict) -> None:
        """Stuck-agent detection in ‘Working...’ state (> stall_timeout zero-delta).

        An agent stuck on an API stream (timeout) or a bloated context (>75%)
        shows the spinner, so visibly_busy() counts it as working. If the screen
        stays unchanged past stall_timeout, send Escape, wait for input,
        and run /compact, logging to the journal and notes.
        """
        if self.tmux is None:
            return
        # No compacting amid sealed patches (risk of interrupting review/apply)
        for _p, rec in (state.get("patches") or {}).items():
            if rec.get("sealed") and not rec.get("applied"):
                return

        now = time.time()
        for role, info in (state.get("roles") or {}).items():
            if role in self.skip or not isinstance(info, dict):
                continue
            pane = info.get("pane")
            if not pane or not pane_alive(self.tmux, pane):
                self._screen_hashes.pop(role, None)
                continue
            if not self.visibly_busy(pane):
                self._screen_hashes.pop(role, None)
                continue

            try:
                raw_lines = capture(self.tmux, pane)
                screen_hash = hashlib.sha256("\n".join(raw_lines).encode("utf-8")).hexdigest()[:16]
            except Exception:  # noqa: BLE001
                continue

            last_hash, first_seen = self._screen_hashes.get(role, ("", now))
            if screen_hash != last_hash:
                self._screen_hashes[role] = (screen_hash, now)
                continue

            stalled_duration = now - first_seen
            if stalled_duration < self.stall_timeout:
                continue

            key = f"auto-compact-stall-{role}-{state.get('round')}-{screen_hash}"
            if not self.remember(key, ttl=self.stall_timeout * 2):
                continue

            compact_ok = self.supports_compact(role)
            log(f"{role}: stuck in Working... {int(stalled_duration)}with (zero-delta) — sending Escape" + (" and /compact" if compact_ok else " (CLI has no /compact — Escape only)"))
            try:
                subprocess.run([self.tmux, "send-keys", "-t", pane, "Escape"],
                               capture_output=True, text=True, timeout=5)
                time.sleep(1.0)
                if compact_ok:
                    deliver(pane, "/compact", wait_for_empty=3.0, submit=True)
            except Exception as exc:  # noqa: BLE001
                log(f"{role}: auto-compact failed: {exc}")
                continue

            self._screen_hashes.pop(role, None)
            if not compact_ok:
                continue
            self.store.append_transcript("pilot_auto_compact", "pairpilot",
                                         target=role, reason="stalled_busy",
                                         duration_seconds=int(stalled_duration))
            # Recording the incident in notes
            try:
                notes_dir = self.state_dir / "notes"
                notes_dir.mkdir(parents=True, exist_ok=True)
                note_file = notes_dir / "fix.md"
                with note_file.open("a", encoding="utf-8") as f:
                    f.write(f"\n## {now_iso()} — pairpilot\n\n"
                            f"Smart Auto-Compact: {role} stuck in ‘Working...’ for "
                            f"{int(stalled_duration)}with no screen change. Sent Escape + /compact.\n")
            except OSError:
                pass

    def preventive_compact(self, state: dict) -> None:
        """Preventive /compact for live roles at phase == ‘done’."""
        if state.get("phase") != "done" or self.tmux is None:
            return
        round_num = state.get("round", 0)
        key = f"preventive-compact-round-{round_num}"
        if not self.remember(key):
            return

        for role, info in (state.get("roles") or {}).items():
            if role in self.skip or not isinstance(info, dict):
                continue
            pane = info.get("pane")
            if not pane or not pane_alive(self.tmux, pane):
                continue
            try:
                if not self.supports_compact(role):
                    log(f"{role}: preventive /compact skipped — the CLI has none")
                    continue
                line = composer_line(capture(self.tmux, pane))
                if line is not None and is_composer_empty(line):
                    deliver(pane, "/compact", wait_for_empty=1.0, submit=True)
                    self.store.append_transcript("pilot_auto_compact", "pairpilot",
                                                 target=role, reason="preventive_done",
                                                 round=round_num)
                    log(f"{role}: preventive /compact at done phase")
            except Exception as exc:  # noqa: BLE001
                log(f"{role}: preventive compact failed: {exc}")

    def check_server_freshness(self, state: dict) -> None:
        """Check MCP server freshness and log to the transcript when stale.

        Deliberately runs in parked done too: a stale server freezes phase
        transitions (assert_server_fresh), and silence about it would cost more
        than the saved tokens. No auto-reset: MCP servers are spawned by the
        client (`opencode serve --service`); the pilot can only warn.
        """
        try:
            import server_freshness
            verdict = server_freshness.check_server_freshness()
            if not verdict.get("fresh"):
                key = f"server-stale-{verdict.get('newest_code_file')}"
                if self.remember(key, ttl=300.0):
                    self.store.append_transcript(
                        "pilot_server_stale", "pairpilot",
                        newest_file=verdict.get("newest_code_file"),
                        lag_seconds=int(verdict.get("lag_seconds", 0)),
                        note="MCP server in memory runs stale code; restart required"
                    )
                    log(f"WARNING: MCP server is stale ({verdict.get('why')})")
        except Exception:  # noqa: BLE001
            pass

    def pending_answers(self, state: dict) -> None:
        """A request was sent, no answer came. Worse than silence: silence may mean
        "working", but no answer to a concrete question means the question died
        in the box. First nudge the one who owes the answer: usually it just
        went unread. Then, if the author is silent too — the one who waits."""
        root = self.state_dir / "obligations"
        if not root.is_dir():
            return
        now = datetime.now(timezone.utc)
        for path in sorted(root.glob("*.json")):
            try:
                record = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                path.unlink(missing_ok=True)
                continue
            opened = parse_iso(record.get("opened_at"))
            if opened is None:
                path.unlink(missing_ok=True)
                continue
            age = (now - opened).total_seconds()
            seq, sender, receiver = record.get("seq"), record.get("from"), record.get("to")
            subject = (record.get("subject") or "").strip()

            if receiver and age >= self.reply_grace and receiver not in self.skip:
                key = f"reply-{seq}-{receiver}"
                if self.remember(key, ttl=self.reply_repeat):
                    text = (f"[pairpilot] {sender} waits for an answer to request {seq} "
                            f"already {int(age // 60)} min{f': {subject}' if subject else ''}. "
                            f"This is a request with expects_reply, and its mailbox holds no answer. "
                            f"Answer it or say it is no longer needed.")
                    self.enqueue(receiver, text)
                    log(f"{receiver} did not answer request {seq} from {sender} "
                        f"({int(age // 60)} min)")

            if sender and age >= self.reply_hard and sender not in self.skip:
                key = f"waiting-{seq}-{sender}"
                if self.remember(key, ttl=self.reply_repeat):
                    text = (f"[pairpilot] You wait for an answer to request {seq} from {receiver} "
                            f"already {int(age // 60)} min{f': {subject}' if subject else ''}. "
                            f"No answer. Do not wait forever: take the next step yourself, "
                            f"note that the request hung unanswered, and move on.")
                    self.enqueue(sender, text)
                    log(f"{sender} waits for an answer to request {seq} already {int(age // 60)} min")

    def live_project_panes(self, state: dict, role: str = "") -> list[str]:
        """Live panes of this project, unclaimed by roles — wake candidates.

        The roster knows only recorded panes, but an agent may open a terminal
        inside the project past it (critic seq 381: pane None in the roster with
        live project-cwd panes). Search directly via list-panes and prove
        membership via the panes module, not by string.

        Adopt only a pane with the role’s live server.py (first factor),
        cwd second: otherwise the pilot would register the role into the human’s
        shell open in the project (round-33 verdict). A pane from pane_provisional
        of the role goes first in line: the server already saw it, factors rechecked.
        """
        if self.tmux is None:
            return []
        try:
            out = subprocess.run([self.tmux, "list-panes", "-a", "-F", "#{pane_id}"],
                                 capture_output=True, text=True, timeout=5).stdout
        except Exception:
            return []
        taken = {self.pane_key(info.get("pane")) for info in (state.get("roles") or {}).values()
                 if info.get("pane")}
        live = {pane.strip() for pane in out.splitlines() if pane.strip()}
        ordered: list[str] = []
        if role:
            prov = ((state.get("roles") or {}).get(role) or {}).get("pane_provisional") or ""
            if prov and prov in live and self.pane_key(prov) not in taken:
                ordered.append(prov)
        ordered.extend(p for p in sorted(live) if p not in ordered)
        found = []
        for pane in ordered:
            if self.pane_key(pane) in taken:
                continue
            if role and not pane_role_pid(self.tmux, pane, role):
                continue
            try:
                ours, _why = pane_belongs_to_project(self.tmux, pane,
                                                     self.store.project_root)
            except Exception:
                continue
            if ours:
                found.append(pane)
        return found

    def dead_pane(self, state: dict) -> None:
        """The agent window is gone. Nothing to push with — the case where a human
        is truly needed. But say it loudly and once, not left to guess."""
        if self.tmux is None:
            return
        for role, info in (state.get("roles") or {}).items():
            pane = info.get("pane")
            if role in self.skip:
                continue
            if not pane:
                # A roster with no pane, but the role process may live in a pane:
                # TMUX_PANE in the MCP server environment is sometimes empty. The reverse path
                # by roster pid — and the record heals, somewhere to wake again.
                healed = ""
                pid = info.get("pid")
                if isinstance(pid, int) and pid > 0 and is_pid_alive(pid):
                    healed = find_pane_of_pid(self.tmux, pid)
                if not healed:
                    # pid did not help, but the agent may have opened a terminal inside the project
                    # past the roster: the first free pane running its server.py.
                    live = self.live_project_panes(state, role)
                    healed = live[0] if live else ""
                if healed:
                    def heal(st):
                        st.get("roles", {}).get(role, {})["pane"] = healed
                    self.store.mutate(heal)
                    self.store.append_transcript("pilot_pane_healed", "pairpilot",
                                                 target=role, pane=healed)
                    log(f"{role}: pane {healed} found in the project — healing the roster")
                    continue
                if self.remember(f"nopane-{role}"):
                    self.store.append_transcript("pilot_pane_missing", "pairpilot", target=role)
                    log(f"{role}: no pane, it is outside tmux — nothing to push with")
                continue
            if pane_alive(self.tmux, pane):
                continue
            key = f"deadpane-{role}-{pane}"
            if not self.remember(key):
                continue
            self.store.append_transcript("pilot_pane_dead", "pairpilot", target=role, pane=pane)
            log(f"{role}: pane {pane} is dead — a window must be opened")

    # -------------------------------------------------------------- restart

    def restart_agent(self, state: dict) -> None:
        """Restart an agent whose process died while its window stays alive.

        Exactly this case cost us a night: pid GONE, but the roster entry lives
        for hours because nobody restarts and nobody tells.

        What a restart does NOT do, though it could, and why:

        - never touches write authority. The role returns with the same name from
          the MCP config, and the writer stays whoever the human named. That is
          what makes restarts safe: they fix the process, not the trust boundary
          (PROTOCOL.md §2). Only a human still moves authority;
        - never raises a pane that is gone. A window closed by the human is not
          resurrected quietly: that is not a hang, that is a decision, and the human's
          decision;
        - never touches a live process, even a silent one. Silence is cured by
          a nudge, death by a restart. Never mix them: a killed neighbour loses
          no context, a busy one does.
        """
        if self.tmux is None or autonomy(state) == "observe":
            return
        for role, info in (state.get("roles") or {}).items():
            if role in self.skip:
                continue
            pid = info.get("pid")
            if not isinstance(pid, int) or pid <= 0 or is_pid_alive(pid):
                continue
            pane = info.get("pane")
            if not pane or not pane_alive(self.tmux, pane):
                if self.remember(f"restart-nopane-{role}"):
                    self.store.append_transcript("pilot_restart_impossible", "pairpilot",
                                                 target=role, pid=pid, why="no live pane")
                    log(f"{role}: process dead (pid {pid}), but no window — a human is needed")
                continue
            # The pane may have reached the role by inheritance: the agent record stayed, but
            # someone live already sits there. Knocking on another window is pointless —
            # respawn without -k refuses anyway, but extra journal noise is worse.
            #
            # The check runs BEFORE the pid update, and the order is not taste: if the
            # pane were asked about first, another role would yield its live pid,
            # and we would record it into THIS role’s entry. Two entries on one process —
            # exactly the state the roster later cannot resolve into who sits where.
            # sits where.
            squatter = self.pane_occupied_by_other(state, role, pane)
            if squatter:
                if self.remember(f"restart-squat-{role}-{pane}"):
                    self.store.append_transcript("pilot_restart_impossible", "pairpilot",
                                                 target=role, pid=pid, pane=pane,
                                                 why=f"pane held by live role {squatter}")
                    log(f"{role}: pane {pane} held by live role {squatter} — leaving alone")
                continue
            # A live pane with a dead record role does not yet mean the role fell.
            # A `%N` number — or any pane address — outlives the death of the process
            # that held it, and the role may have restarted itself: then the pane holds
            # a live agent while the roster pid is stale. Trying to raise the role in
            # this state means killing a live agent with its context.
            #
            # This was the cause of 21 restarts of a live pane in one night: the pid
            # went stale, the pane stayed alive, the role unharmed. Cured not by restart
            # but by refreshing the pid from the pane — that is “liveness by pane”.
            #
            # The refresh is idempotent, and under races too: if the role restarted
            # between the state read and the write, `remember` already fired on the old
            # pid, and the next tick sees a live pid and does nothing.
            occupant = self.pane_occupant(role, pane)
            if occupant:
                if self.remember(f"refresh-{role}-{pid}"):
                    self.store.append_transcript("pilot_pid_stale_pane_alive", "pairpilot",
                                                 target=role, pane=pane, pid=pid,
                                                 live_pid=occupant,
                                                 why="roster pid went stale, the pane runs a live process")
                    self.store.mutate(lambda s, r=role, p=occupant: s.setdefault("roles", {})
                                      .setdefault(r, {}).update({"pid": p}))
                    log(f"{role}: pid {pid} went stale, the pane runs {pane} live: {occupant} — "
                        f"record refreshed, no restart needed")
                continue
            command = self.launch_command(role)
            if not command:
                if self.remember(f"restart-nocmd-{role}"):
                    self.store.append_transcript("pilot_restart_impossible", "pairpilot",
                                                 target=role, pid=pid, why="no launch command known")
                    log(f"{role}: process dead, and I know no launch command — tell "
                        f"pairpilot --launch {role}='command' or append to .pair/restart.json")
                continue
            # Two limits, and both are needed. The pid mark stops touching the same
            # fallen process again. But it alone is NOT enough: if the launch
            # command is wrong, the process dies with a new pid, the mark is
            # new every time, and at a 15-second interval that is an endless loop.
            # The window ceiling ignores pid entirely and stops exactly that.
            if not self.remember(f"restart-{role}-{pid}-{state.get('round')}"):
                continue
            if not self.restart_allowed(role):
                self.store.append_transcript(
                    "pilot_restart_throttled", "pairpilot", target=role, pane=pane, pid=pid,
                    command=self.launch_command(role),
                    reason=f"{self.restart_limit} restarts in {int(self.restart_window / 60)} min")
                log(f"{role}: restart paused — {self.restart_limit} attempts in "
                    f"{int(self.restart_window / 60)} min. The launch command looks wrong: "
                    f"{self.launch_command(role)!r}. Waiting on the human.")
                continue
            self.note_restart(role)
            result = subprocess.run(
                # Without -k. tmux refuses to restart a live pane, and that is
                # exactly what is wanted: if the dead agent’s pane holds a shell
                # or a debugger, it belongs to the human, and -k would kill it.
                # A restart fires only where the pane is truly dead, and a held
                # pane is left to the human with a transcript record.
                [self.tmux, "respawn-pane", "-t", pane, command],
                capture_output=True, text=True, timeout=15)
            if result.returncode == 0:
                self.store.append_transcript("pilot_restart", "pairpilot", target=role,
                                             pane=pane, pid=pid, command=command)
                # A restart raises a process, not memory: the returned role has
                # neither the task nor the round history. The launch command in profiles —
                # "agy", "claude" — with no --resume, and how to continue the
                # session nobody knows but the human.
                #
                # So leave a note, not a guessed flag: it points at the task journal,
                # where the remainder is written. Works with any CLI and needs no
                # protocol knowledge from the profile.
                note = self.state_dir / "notes" / f"pilot-restart-{role}.md"
                try:
                    note.parent.mkdir(parents=True, exist_ok=True)
                    note.write_text(
                        f"# Restarting role {role}\n\n"
                        f"Process {pid} was dead, the role is raised anew in {pane}.\n"
                        f"You have no round context — that is the price of a restart.\n\n"
                        f"What to do: read `.pair/tasks.md`. It lists the tasks, what\n"
                        f"is proven done, and what stays behind the open items.\n"
                        f"Round phase and writer live in `pairctl status`.\n",
                        encoding="utf-8")
                except OSError as error:
                    self.store.append_transcript("pilot_restart_note_failed", "pairpilot",
                                                 target=role, error=str(error)[:120])
                log(f"{role}: process {pid} was dead, restarted in {pane} ({command})")
                writer = " — it is the writer, the phase continues" if role == state.get("writer") else ""
                if writer:
                    log(writer)
            else:
                # A held pane is almost always the human or its shell after the
                # agent fell. Say plainly that this is not a hang.
                detail = (result.stderr or result.stdout or "").strip()[:120]
                self.store.append_transcript("pilot_restart_failed", "pairpilot", target=role,
                                             pane=pane, pid=pid, command=command, why=detail)
                log(f"{role}: restart failed — {detail or 'reason unnamed'}")

    def stalled_patches(self, state: dict) -> None:
        """A sealed patch nobody applied or rejected.

        The hole was structural: `applied` was written at reservation and never
        changed again, so "applied" and "lying since last night" looked identical.
        Now the writer records the application, round close requires settling
        every patch, and the supervisor tells both sides.

        The supervisor never applies the patch itself. That edits project files
        as a non-writer — exactly the §1 bypass the scheme looks sound for.
        """
        if state.get("phase") == "done" or state.get("mode") == "audit":
            return
        writer = state.get("writer")
        now = datetime.now(timezone.utc)
        for path, record in (state.get("patches") or {}).items():
            if not record.get("sealed") or record.get("applied"):
                continue
            sealed_at = parse_iso(record.get("sealed_at"))
            if sealed_at is None or (now - sealed_at).total_seconds() < self.patch_grace:
                continue
            owner = record.get("owner")
            names = [name for name in (writer, owner) if name and name not in self.skip]
            for name in names:
                key = f"stalled-{path}-{name}"
                if not self.remember(key):
                    continue
                if name == writer:
                    text = (f"[pairpilot] Patch {path} sealed {owner}, sha256 "
                            f"{record.get('sha256')} and still unapplied. Check it "
                            f"with pair_patch_verify and either apply and record pair_patch_applied, "
                            f"or release via pair_patch_release with a reason: the round "
                            f"will not close until this is settled.")
                else:
                    text = (f"[pairpilot] Your patch {path} is sealed and hangs unapplied. "
                            f"Tell the neighbour: applied or rejected, and record it via "
                            f"pair_patch_applied or pair_patch_release. Silence here "
                            f"reads as readiness, and there is none.")
                self.enqueue(name, text)
                log(f"patch {path} hangs unapplied, {name} is notified")

    def allowlist(self) -> list[str]:
        """Permission allowlist: explicit argument first, then the human file.

        No file means the default list, and that is a boundary the human set:
        inside the project everything the work needs is allowed; what harms the
        system, another project or wipes irreversibly is banned. Bans check first
        and no setting overrides them.

        This used to be an empty list, and empty meant "confirm nothing".
        But no `.pair/permissions.json` existed then, so the supervisor confirmed
        not a single prompt — and from outside that looked like neighbour
        silence, not a settings refusal.
        """
        if self.allow is not None:
            return self.allow
        try:
            patterns, on_default = load_allow_patterns(str(permissions_path(self.state_dir)))
        except Exception:  # noqa: BLE001
            return []
        if on_default:
            self.note_default_allowlist()
        return patterns

    def note_default_allowlist(self) -> None:
        """Say into the journal that the work runs on the default list.

    Once per process. Running silently on the default list is forbidden: the human
    reading the journal must see which rule confirmed its commands.
    """
        if self._default_list_named:
            return
        self._default_list_named = True
        from composer import DEFAULT_ALLOW_PATTERNS
        self.store.append_transcript(
            "pilot_default_allowlist", "pairpilot",
            patterns=len(DEFAULT_ALLOW_PATTERNS),
            file=str(permissions_path(self.state_dir)),
            note="permissions.json not found, running on the default list; "
                 "\u00a712 bans hold regardless of it")
        log("permissions.json not found — running on the default list "
            f"({len(DEFAULT_ALLOW_PATTERNS)} patterns). \u00a712 bans always hold.")

    def unblock(self, state: dict) -> None:
        """The agent stands at [y/N]. Till morning that looks like a hang, though
        a single Enter would settle it.

        But "a single Enter" is also "y" to "rm -rf?". So only allowlisted
        things confirm, and by default it is reads. A refusal is not an error
        but a result: the pane stays blocked, and the human must learn it."""
        if self.tmux is None or autonomy(state) == "observe":
            return
        allow = self.allow
        for role, info in (state.get("roles") or {}).items():
            pane = info.get("pane")
            if not pane or role in self.skip or not pane_alive(self.tmux, pane):
                continue
            try:
                result = resolve_permission_prompt(self.tmux, pane, allow=allow)
            except Exception:  # noqa: BLE001 - the supervisor must not fall over a pane
                continue
            prompt = result.get("prompt") or ""
            if result.get("approved"):
                if self.remember(f"unblock-{role}-{stable_tag(prompt)}"):
                    self.store.append_transcript("pilot_unblock", "pairpilot", target=role,
                                                 prompt=prompt[:120], matched=result.get("matched"))
                    log(f"{role}: confirmed the permission request — {prompt[:60]}")
            elif result.get("verdict") == "refuse":
                if self.remember(f"unblock-refused-{role}-{stable_tag(prompt)}"):
                    self.store.append_transcript("pilot_unblock_refused", "pairpilot", target=role,
                                                 prompt=prompt[:120], why=result.get("why"))
                    log(f"{role}: did NOT confirm “{prompt[:50]}» — {result.get('why')}. A human is needed.")

    # ---------------------------------------------------------------- report

    def checkpoint(self, state: dict) -> None:
        """The human needs a digest, not a question from the void.

        In autonomy=semi a round cannot close without `bin/pairctl ok`. So if
        that word is missing while the round reached checks, the human must get
        everything the decision needs, plus the command that decides it. Otherwise
        "semi-auto" is the ability to stop and wait, saying nothing.
        """
        if autonomy(state) != "semi" or state.get("phase") != "verify":
            return
        round_number = state.get("round")
        if not self.remember(f"checkpoint-{round_number}"):
            return
        blockers = _done_blockers(state)
        if not blockers:
            return
        path = self.outbox / f"checkpoint-{round_number}.md"
        lines = [
            f"# Round checkpoint {round_number}",
            "",
            f"- task: {state.get('task') or 'NOT SET'}",
            f"- writer: {state.get('writer') or 'UNASSIGNED'}",
            f"- round mode: {state.get('mode')}   autonomy: semi",
            "",
            "## What blocks the round close",
            "",
        ]
        lines += [f"- {item}" for item in blockers]
        lines += [
            "",
            "## What to do",
            "",
            "Read this and answer with one word:",
            "",
            f"    bin/pairctl ok",
            "",
            "Or, if the work must run on without you till morning:",
            "",
            "    bin/pairctl autonomy auto",
            "",
        ]
        path.write_text("\n".join(lines), encoding="utf-8")
        self.store.append_transcript("pilot_checkpoint", "pairpilot", round=round_number,
                                     path=str(path), blockers=len(blockers))
        log(f"round {round_number} waits for one human word: {path}")

    def report_once(self, state: dict) -> None:
        """The human must get the result, not silence. Write the report to a file
        when the round closes; print the path to the console."""
        if state.get("phase") != "done" or not state.get("closed_at"):
            return
        key = f"report-{state.get('round')}"
        if not self.remember(key):
            return
        path = write_report(self.state_dir, state)
        # The session journal is written next to the report: the round is closed, so the human
        # will return and want to see at a glance what was ordered, what was done,
        # and what stays behind the open tasks.
        journal = write_tasks_md(self.state_dir, state)
        self.store.append_transcript("pilot_report", "pairpilot", path=str(path),
                                     journal=str(journal))
        log(f"round {state.get('round')} closed, report: {path}, journal: {journal}")

    # ------------------------------------------------------------------ tick

    def tick(self) -> dict:
        state = self.state()
        # Roles sitting on a shared pane are indistinguishable: never poke them.
        self.skip = {role for names in self.shared_panes(state).values() for role in names}
        # Never touch our own pane: human input lives there.
        if self.own_pane:
            own_key = self.pane_key(self.own_pane)
            for role, info in (state.get("roles") or {}).items():
                # Our own pane arrives from the environment as `%N`, but the role is recorded
                # as a session address. String comparison stops working, and the supervisor
                # starts typing messages into the human pane.
                if self.pane_key(info.get("pane")) == own_key:
                    self.skip.add(role)
                    if self.remember(f"ownpane-{role}-{self.own_pane}"):
                        log(f"{role} sits in my own pane {self.own_pane} — leaving it alone")
                        self.store.append_transcript("pilot_own_pane", "pairpilot",
                                                     target=role, pane=self.own_pane)
        self.ambiguous(state)
        self.gone_roles(state)
        self.unblock(state)
        self.restart_agent(state)
        self.dead_pane(state)
        self.unread_peers(state)
        # Polling runs BEFORE raising new wake-ups and before printing: whoever already
        # woke has its wake-up dropped silently, and nothing lands in the print queue.
        # If polling ran after flush_outbox, the tick where the role just woke would
        # still print into its composer.
        self.poll_wakes(state)
        self.pending_answers(state)
        self.stalled_patches(state)
        self.check_stalled_busy(state)
        self.stale_writer(state)
        self.idle_roles(state)
        self.drop_stale_outbox(state)
        self.flush_outbox(state)
        self.preventive_compact(state)
        self.check_server_freshness(state)
        self.checkpoint(state)
        self.report_once(state)
        return state


def _done_blockers(state: dict) -> list[str]:
    """What blocks the round close — with the same code as the server.

    The rule belongs to the server, and a second copy would sooner or later drift
    from the first: the human would get an "all good" report from one side and
    a refusal from the other. So the supervisor never rewrites the rule but asks
    whoever applies it.
    """
    return done_blockers(state)


def write_report(state_dir: Path, state: dict) -> Path:
    """One screen for the human: what is done, what proves it, and what is NOT covered."""
    transcript = state_dir / "transcript.jsonl"
    events: list[dict] = []
    if transcript.exists():
        for raw in transcript.read_text(encoding="utf-8", errors="replace").splitlines():
            if raw.strip():
                try:
                    events.append(json.loads(raw))
                except json.JSONDecodeError:
                    pass
    kinds: dict[str, int] = {}
    for event in events:
        kinds[event.get("kind", "?")] = kinds.get(event.get("kind", "?"), 0) + 1
    refused = sum(v for k, v in kinds.items() if k in ("refuse", "refused", "deliver_busy"))
    denied = kinds.get("pilot_unblock_refused", 0) + kinds.get("unblock_refused", 0)
    restarted = kinds.get("pilot_restart", 0)
    dropped = [event for event in events if event.get("kind") == "patch_dropped"]
    restarts_blocked = [event for event in events if event.get("kind") == "pilot_restart_impossible"]
    evidence = [item for item in (state.get("evidence") or [])
                if item.get("round") == int(state.get("round", 0))]
    stalled = [path for path, record in (state.get("patches") or {}).items()
               if record.get("sealed") and not record.get("applied")]

    notes = []
    notes_dir = state_dir / "notes"
    if notes_dir.exists():
        for path in sorted(notes_dir.glob("*.md"), key=lambda p: p.stat().st_mtime)[-12:]:
            head = next((ln.strip("# ").strip() for ln in
                         path.read_text(encoding="utf-8", errors="replace").splitlines()
                         if ln.startswith("#")), path.stem)
            notes.append(f"- {path.stem}: {head}")

    lines = [
        f"# Round report {state.get('round')}",
        "",
        f"- task: {state.get('task') or 'NOT SET'}",
        f"- phase: {state.get('phase')}   mode: {state.get('mode')}   autonomy: {autonomy(state)}",
        f"- writer: {state.get('writer') or 'UNASSIGNED'}",
        "",
        "## Tasks: done / not done",
        "",
    ]
    task_items = tasks_of(state)
    if task_items:
        marks = {"open": "NOT DONE", "done": "done", "dropped": "dropped"}
        for item in task_items:
            line = f"- #{item.get('id')} {marks.get(item.get('status'), '?')}: " \
                   f"{str(item.get('text'))[:90]}"
            if item.get("status") == "dropped" and item.get("reason"):
                line += f" — {str(item.get('reason'))[:60]}"
            lines.append(line)
        unclosed = [i["id"] for i in task_items if i.get("status") == "open"]
        if unclosed:
            lines += ["", f"ROUND OPEN: open tasks {', '.join(f'#{i}' for i in unclosed)}"]
    else:
        lines.append("- no tasks filed")
    lines += [
        "",
        "## This round’s evidence",
        "",
    ]
    if evidence:
        for item in evidence:
            mark = "OK " if item.get("ok") else "FAIL"
            lines.append(f"- {mark} {item.get('kind')} [{item.get('role')}] {item.get('value')}")
    else:
        lines.append("- NONE. The round closed without a single machine fact.")
    lines += [
        "",
        "## In the transcript",
        "",
    ]
    for kind, count in sorted(kinds.items(), key=lambda kv: -kv[1]):
        lines.append(f"- {kind}: {count}")
    lines += [
        "",
        f"Refusals and lost deliveries: {refused}.",
        f"Permissions NOT self-confirmed: {denied}.",
        f"Restarted fallen agents: {restarted}.",
        "",
        "## What this report does NOT prove",
        "",
        "- that the code is right: tests prove it, not notes;",
        "- that all the task is done: the supervisor sees events, not work meaning.",
        "",
        "## NOT COVERED",
        "",
    ]
    if stalled:
        lines.append("Sealed patches with no apply and no reject:")
        lines += [f"- {path}" for path in stalled]
    else:
        lines.append("- no unapplied sealed patches.")
    if dropped:
        lines.append(f"Rejected patches (deliberately dropped): {len(dropped)}")
    if restarts_blocked:
        lines.append("Restart never happened, a human is needed:")
        lines += [f"- {event.get('target')}: {event.get('why')}" for event in restarts_blocked]
    if denied:
        lines.append("Permission requests left to the human:")
        lines += [f"- {event.get('target')}: {event.get('why')}"
                  for event in events if event.get("kind") in ("pilot_unblock_refused", "unblock_refused")]
    if state.get("phase") != "done":
        blockers = _done_blockers(state)
        lines.append("What blocks the round close:")
        lines += [f"- {item}" for item in blockers] or ["- nothing"]
    lines += [
        "",
        "## Latest notes",
        "",
    ]
    lines += notes or ["- none"]
    lines += [""]
    out = state_dir / "REPORT.md"
    out.write_text("\n".join(lines), encoding="utf-8")
    return out


def main() -> int:
    parser = argparse.ArgumentParser(description="Pair-work supervisor")
    parser.add_argument("--state", default=os.environ.get("PAIR_STATE", ".pair"))
    parser.add_argument("--interval", type=float, default=DEFAULT_INTERVAL)
    parser.add_argument("--silence", type=float, default=DEFAULT_SILENCE)
    parser.add_argument("--outbox-ttl", type=float, default=DEFAULT_OUTBOX_TTL,
                        help="how many seconds a queued nudge may wait for the composer")
    parser.add_argument("--reply-grace", type=float, default=DEFAULT_REPLY_GRACE,
                        help="seconds before the recipient of a request is poked")
    parser.add_argument("--reply-hard", type=float, default=DEFAULT_REPLY_HARD,
                        help="seconds before the author of a request is told it went unanswered")
    parser.add_argument("--reply-repeat", type=float, default=DEFAULT_REPLY_REPEAT,
                        help="seconds between repeated nudges while a request stays unanswered")
    parser.add_argument("--patch-grace", type=float, default=DEFAULT_PATCH_GRACE,
                        help="seconds before a sealed patch nobody applied becomes a defect")
    parser.add_argument("--restart-limit", type=int, default=DEFAULT_RESTART_LIMIT,
                        help="max restarts per role per window, whatever the pid. A launch "
                             "command that is known but wrong otherwise loops forever.")
    parser.add_argument("--restart-window", type=float, default=DEFAULT_RESTART_WINDOW,
                        help="seconds the restart limit applies over")
    parser.add_argument("--launch", action="append", default=[], metavar="ROLE=CMD",
                        help="how to start a role if its process dies, e.g. --launch agy=agy. "
                             "Repeatable. Also PAIR_LAUNCH_<ROLE>, or .pair/restart.json.")
    parser.add_argument("--allow", default=os.environ.get("PAIR_PERMISSIONS"),
                        help="permission allowlist: a file of patterns, or a comma-separated "
                             "list. Empty means confirm nothing.")
    parser.add_argument("--stall-timeout", type=float, default=DEFAULT_STALL_TIMEOUT,
                        help="seconds an agent may stay busy with identical screen before auto-compact")
    parser.add_argument("--once", action="store_true", help="single pass and exit")
    args = parser.parse_args()

    launch: dict[str, str] = {}
    for item in args.launch:
        role, _, command = item.partition("=")
        if role.strip() and command.strip():
            launch[role.strip()] = command.strip()
        else:
            print(f"pairpilot: --launch expects ROLE=CMD, got {item!r}", file=sys.stderr)
            return 2
    allow = load_allow_patterns(args.allow)[0] if args.allow else None

    state_dir = Path(args.state).resolve()
    pilot = Pilot(state_dir, silence=args.silence, interval=args.interval,
                  reply_grace=args.reply_grace, reply_hard=args.reply_hard,
                  reply_repeat=args.reply_repeat,
                  patch_grace=args.patch_grace, launch=launch, allow=allow,
                  restart_limit=args.restart_limit, restart_window=args.restart_window,
                  outbox_ttl=args.outbox_ttl, stall_timeout=args.stall_timeout)

    if args.once:
        state = pilot.tick()
        log(f"pass done: phase={state.get('phase')} writer={state.get('writer')}")
        return 0

    log(f"supervisor on {state_dir}, silence threshold {int(args.silence)} s, Ctrl-C exits")
    try:
        while True:
            pilot.tick()
            time.sleep(args.interval)
    except KeyboardInterrupt:
        log("exit")
    return 0


if __name__ == "__main__":
    sys.exit(main())
