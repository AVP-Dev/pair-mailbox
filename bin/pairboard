#!/usr/bin/env python3
"""The pair dashboard: builds one static HTML, optionally keeping it fresh.

Run:

    bin/pairboard                     build board.html once into the root, printing the path
    bin/pairboard --watch 5           rebuild every 5 seconds
    bin/pairboard --out /tmp/x.html   build elsewhere
    bin/pairboard --print-json        print the snapshot to stdout, writing no HTML

Why no server. The round task is watching with no localhost. A page opened over
`file://` cannot read `.pair/` alone: the browser bans `fetch()` of local files.
So freshness serves from this side: the generator rewrites the file, while the open
page reloads over `<meta http-equiv="refresh">`. The only honest scheme with no web
server, also explaining why `--watch` is no decor but a way to a live picture.

Modules live in `mcp/pair_mailbox/` because pair state reads there too, and
duplicating `.pair/` reads here would start a second arithmetic drifting from the
first on the very first format change.

Nothing writes into `.pair/`: the showcase lives at the repo root, the only source
is `.pair/`. An observer changing the state it watches is the worst kind of watching
tool.
"""
from __future__ import annotations

import argparse
import json
import signal
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "mcp" / "pair_mailbox"))

from board_render import AssetError, write_page  # noqa: E402
from board_snapshot import DEFAULT_EVENTS, DEFAULT_STALE_AFTER, build_snapshot  # noqa: E402

DEFAULT_OUT = "board.html"
MIN_WATCH = 1
MAX_WATCH = 3600
# How many seconds to sleep at once between stop-flag checks. Short means
# fast Ctrl-C answers, long means never waking the process too often.
SLEEP_SLICE = 0.25


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="pairboard",
        description="Static HTML dashboard of pair state (no web server).")
    parser.add_argument("--state", default=".pair", help="pair state directory (default .pair)")
    parser.add_argument("--out", default=DEFAULT_OUT, help=f"where to write HTML (default {DEFAULT_OUT})")
    parser.add_argument("--watch", type=float, default=0, metavar="N",
                        help="rebuild every N seconds and embed auto-refresh in the page")
    parser.add_argument("--limit", type=int, default=DEFAULT_EVENTS,
                        help=f"how many recent log events to show (default {DEFAULT_EVENTS})")
    parser.add_argument("--stale-after", type=int, default=DEFAULT_STALE_AFTER,
                        help="after how many seconds a snapshot counts as stale")
    parser.add_argument("--print-json", action="store_true", help="print snapshot and exit, do not write HTML")
    return parser.parse_args(argv)


def resolve_state(raw: str) -> Path:
    """The state path: relative means from the project root, not the current dir.

    From the current dir comes exactly what the human never expects: launching
    from a subdir, taking "pair not found" plus a blank page. The project root stands
    one, and `.pair` lives exactly there.
    """
    candidate = Path(raw).expanduser()
    if candidate.is_absolute():
        return candidate
    return (ROOT / candidate).resolve()


def build_once(state_dir: Path, out: Path, *, limit: int, stale_after: int,
               refresh: int) -> Path:
    """One pass: snapshot -> page -> file."""
    snapshot = build_snapshot(state_dir, limit=limit, stale_after=stale_after)
    snapshot["watch"] = refresh > 0
    return write_page(out, snapshot, refresh_seconds=refresh)


def run_watch(state_dir: Path, out: Path, *, interval: float, limit: int,
              stale_after: int, once: bool = False) -> int:
    """Rebuilding till stopped. Ctrl-C ends the work with code 0.

    The signal catches explicit, never over the default exception: with no it the very
    first Ctrl-C would leave a `board.html.tmp` temp file in `.pair/`, silently returning
    code 130, which the gate reads as a fall.
    """
    stopping = {"now": False}

    def stop(_signum, _frame):
        stopping["now"] = True

    previous = signal.signal(signal.SIGINT, stop)
    previous_term = signal.signal(signal.SIGTERM, stop)
    seconds = max(MIN_WATCH, min(MAX_WATCH, float(interval)))
    try:
        written = build_once(state_dir, out, limit=limit, stale_after=stale_after,
                             refresh=int(seconds))
        print(f"dashboard: {written} (refresh every {seconds:g} s, Ctrl-C to exit)")
        if once:
            return 0
        while not stopping["now"]:
            _sleep_until(seconds, stopping)
            if stopping["now"]:
                break
            try:
                build_once(state_dir, out, limit=limit, stale_after=stale_after,
                           refresh=int(seconds))
            except (OSError, AssetError) as error:
                # One fallen pass must never kill watching: the on-disk file stays the prior
                # stale one, and the page says so.
                print(f"dashboard: pass failed: {error}", file=sys.stderr)
        print("dashboard: stopped")
        return 0
    finally:
        signal.signal(signal.SIGINT, previous)
        signal.signal(signal.SIGTERM, previous_term)


def _sleep_until(seconds: float, stopping: dict) -> None:
    """Sleeping, but never past `SLEEP_SLICE`, exiting on the stop flag.

    Why not one-line `time.sleep(seconds)`. Past the Python signal handler firing (PEP
    475) the broken `sleep` resumes for the remaining time, never interrupting. With
    `--watch 3600` that means one thing: Ctrl-C never stops the dashboard for an hour,
    and the human decides it broke. Slicing into short chunks answers instant, needing
    neither threads nor signalling.
    """
    waited = 0.0
    while waited < seconds and not stopping["now"]:
        nap = min(SLEEP_SLICE, seconds - waited)
        time.sleep(nap)
        waited += nap


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    state_dir = resolve_state(args.state)
    if not (state_dir / "state.json").exists() and not args.print_json:
        print(f"dashboard: no state.json in {state_dir} — not a pair state. "
              f"Pass --state if the directory is different.", file=sys.stderr)
        return 2

    if args.print_json:
        snapshot = build_snapshot(state_dir, limit=args.limit, stale_after=args.stale_after)
        json.dump(snapshot, sys.stdout, ensure_ascii=False, indent=2)
        sys.stdout.write("\n")
        return 0

    out = Path(args.out).expanduser()
    if not out.is_absolute():
        out = ROOT / out

    try:
        if args.watch > 0:
            return run_watch(state_dir, out, interval=args.watch, limit=args.limit,
                             stale_after=args.stale_after)
        written = build_once(state_dir, out, limit=args.limit, stale_after=args.stale_after,
                             refresh=0)
        print(f"dashboard: {written}")
        print(f"open: file://{written}")
        print("page does not refresh itself; for live mode: bin/pairboard --watch 5")
        return 0
    except AssetError as error:
        print(f"dashboard: {error}", file=sys.stderr)
        return 2
    except OSError as error:
        print(f"dashboard: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())