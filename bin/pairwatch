#!/usr/bin/env python3
"""Следит за парой и замечает зависшего агента. Сам не убивает, если не --kill."""
import json, os, sys, time
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "mcp" / "pair_mailbox"))
try:
    from composer import _tmux, resolve_permission_prompt
    # Store живёт в server.py, а не в storage.py: модуля storage не существует,
    # импорт падал молча, и --unblock не писал в транскрипт.
    from server import Store
except Exception as error:  # noqa: BLE001 - причина должна быть видна
    print(f"pairwatch: {error}", file=sys.stderr)
    resolve_permission_prompt = None
    Store = None

state_dir = Path(os.environ.get("PAIR_STATE") or ".pair").resolve()
# root у Store — это сам каталог состояния (.pair), а не его родитель.
store = Store(state_dir) if Store else None
limit = 300
if "--limit" in sys.argv:
    limit = int(sys.argv[sys.argv.index("--limit") + 1])
kill = "--kill" in sys.argv
auto_unblock = "--unblock" in sys.argv
last_unblock: dict[str, float] = {}

def load():
    try:
        return json.loads((state_dir / "state.json").read_text())
    except Exception:
        return {}

def last_event():
    tr = state_dir / "transcript.jsonl"
    if not tr.exists():
        return None, None
    last = None
    for raw in tr.read_text(errors="replace").splitlines():
        if raw.strip():
            try:
                last = json.loads(raw)
            except Exception:
                pass
    if not last:
        return None, None
    try:
        return datetime.fromisoformat(last.get("ts")), last
    except Exception:
        return None, last

def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except Exception:
        return False

print(f"смотрю {state_dir}, порог {limit // 60} мин, Ctrl-C выход")
try:
    while True:
        st = load()
        roles = st.get("roles", {})
        if auto_unblock and resolve_permission_prompt:
            for name, info in roles.items():
                pane = info.get("pane")
                now = time.monotonic()
                if pane and (now - last_unblock.get(pane, 0.0) >= 30.0):
                    try:
                        tmux = _tmux()
                        matched = resolve_permission_prompt(tmux, pane)
                        if matched:
                            last_unblock[pane] = now
                            if store:
                                store.append_transcript("unblock", "pairwatch", target=name, pane=pane, prompt=matched)
                            print(f"\n\033[32m[авторазблокировка]\033[0m подтверждён запрос разрешения для {name} в панели {pane}: {matched}")
                    except Exception:
                        pass
        t_last, ev = last_event()
        age = (datetime.now(timezone.utc) - t_last).total_seconds() if t_last else None
        if age is not None and age > limit:
            print(f"\n\033[31mЗАВИСАНИЕ: тишина {int(age // 60)} мин\033[0m")
            print(f"  последнее: {ev.get('kind')} от {ev.get('role')}")
            for name, info in roles.items():
                pid = info.get("pid")
                who = "ПИСАТЕЛЬ" if st.get("writer") == name else "критик"
                mark = "жив" if pid and alive(pid) else "мёртв"
                print(f"  {name:10} {who:9} pid={pid} {mark}")
            if kill:
                for name, info in roles.items():
                    pid = info.get("pid")
                    if pid and alive(pid):
                        os.kill(int(pid), 15)
                        print(f"  убит {name} pid={pid}")
            else:
                print("  убить: bin/pairwatch --kill")
        time.sleep(20)
except KeyboardInterrupt:
    print("\nвыход")
