#!/usr/bin/env python3
"""Watches the pair, noticing a hung agent. Never kills unless --kill."""
import json, os, sys, time
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "mcp" / "pair_mailbox"))
try:
    from composer import _tmux, load_allow_patterns, resolve_permission_prompt
    # Store lives in server.py, not storage.py: no storage module exists,
    # the import fell silent, and --unblock never wrote into the transcript.
    from server import Store, load_allowlist
except Exception as error:  # noqa: BLE001 - the reason must show
    print(f"pairwatch: {error}", file=sys.stderr)
    resolve_permission_prompt = None
    Store = None

state_dir = Path(os.environ.get("PAIR_STATE") or ".pair").resolve()
# The Store root is the state dir itself (.pair), not its parent.
store = Store(state_dir, allow_create=True) if Store else None  # round 115 S4: raised beside the pilot, may precede the server
limit = 300
if "--limit" in sys.argv:
    limit = int(sys.argv[sys.argv.index("--limit") + 1])
kill = "--kill" in sys.argv
auto_unblock = "--unblock" in sys.argv
last_unblock: dict[str, float] = {}

def load():
    try:
        return json.loads((state_dir / "state.json").read_text())
    except Exception:
        return {}

def last_event():
    tr = state_dir / "transcript.jsonl"
    if not tr.exists():
        return None, None
    last = None
    for raw in tr.read_text(errors="replace").splitlines():
        if raw.strip():
            try:
                last = json.loads(raw)
            except Exception:
                pass
    if not last:
        return None, None
    try:
        return datetime.fromisoformat(last.get("ts")), last
    except Exception:
        return None, last

def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except Exception:
        return False

print(f"watching {state_dir}, threshold {limit // 60} min, Ctrl-C exits")
try:
    while True:
        st = load()
        roles = st.get("roles", {})
        if auto_unblock and resolve_permission_prompt:
            allow = load_allowlist(state_dir)
            for name, info in roles.items():
                pane = info.get("pane")
                now = time.monotonic()
                if pane and (now - last_unblock.get(pane, 0.0) >= 30.0):
                    try:
                        tmux = _tmux()
                        result = resolve_permission_prompt(tmux, pane, allow=allow or None)
                        # It used to stand `if matched:` with the function returning a line. Now it
                        # returns a verdict, and any non-empty structure would pass as confirmed — the
                        # unblock report printing every 30 seconds on empty ground, while truly nobody
                        # pressed anything.
                        #
                        prompt = result.get("prompt") or ""
                        if result.get("approved"):
                            last_unblock[pane] = now
                            if store:
                                store.append_transcript("unblock", "pairwatch", target=name,
                                                        pane=pane, prompt=prompt)
                            print(f"\n\033[32m[auto-unblock]\033[0m permission request confirmed for {name} in pane {pane}: {prompt}")
                        elif result.get("verdict") == "refuse":
                            last_unblock[pane] = now
                            if store:
                                store.append_transcript("unblock_refused", "pairwatch", target=name,
                                                        pane=pane, prompt=prompt,
                                                        why=result.get("why"))
                            print(f"\n\033[33m[refused]\033[0m {name} in pane {pane} awaits the human: "
                                  f"{result.get('why')} — {prompt}")
                    except Exception:
                        pass
        t_last, ev = last_event()
        age = (datetime.now(timezone.utc) - t_last).total_seconds() if t_last else None
        if age is not None and age > limit:
            print(f"\n\033[31mHANG: silence {int(age // 60)} min\033[0m")
            print(f"  last: {ev.get('kind')} from {ev.get('role')}")
            for name, info in roles.items():
                pid = info.get("pid")
                who = "WRITER" if st.get("writer") == name else "critic"
                mark = "alive" if pid and alive(pid) else "dead"
                print(f"  {name:10} {who:9} pid={pid} {mark}")
            if kill:
                for name, info in roles.items():
                    pid = info.get("pid")
                    if pid and alive(pid):
                        os.kill(int(pid), 15)
                        print(f"  killed {name} pid={pid}")
            else:
                print("  kill: bin/pairwatch --kill")
        time.sleep(20)
except KeyboardInterrupt:
    print("\nexit")
