#!/usr/bin/env python3
"""pairrestart — one command: show what is stale, confirm, do it.

The MCP server holds modules in memory: a file on disk does nothing while the
process lives. Two kinds of process go stale, and they fail differently:
a stale pilot mis-types and mis-gates, a stale role server lies to its own
agent about state.

    pairrestart [--state DIR] [--dry-run] [--yes]

Diagnose (pid/start/code-freshness per role and pilot) -> print the plan with
the cost named -> one explicit `yes` -> kill only the stale -> relaunch the
pilot -> verify. A role's server is only KILLED, never relaunched: the owning
session reconnects its MCP for fresh code to load. Never touches a fresh
server, never force-pushes/merges (§12 untouched).
"""
from __future__ import annotations

import argparse
import os
import json
import signal
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def resolve_state(explicit: str | None) -> Path:
    if explicit:
        return Path(explicit).expanduser().resolve()
    env = os.environ.get("PAIR_STATE")
    if env:
        return Path(env).expanduser().resolve()
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                         capture_output=True, text=True).stdout.strip()
    if top:
        d = Path.cwd().resolve()
        for _ in range(12):
            if (d / ".pair" / "state.json").exists():
                return d / ".pair"
            if str(d) == top:
                break
            if d.parent == d:
                break
            d = d.parent
    return Path.cwd().resolve() / ".pair"


def newest_source_mtime(paths: list[Path]) -> float | None:
    newest = None
    for path in paths:
        try:
            mtime = path.stat().st_mtime
        except OSError:
            continue
        if newest is None or mtime > newest:
            newest = mtime
    return newest


def runtime_code_mtime(project_root: Path = ROOT) -> float | None:
    """Newest mtime among RUNTIME sources — never test files (round 106 slice A, rider b).

    Measured root cause of the 24h outage pattern: a mtime helper that took the
    newest mtime across ALL `mcp/pair_mailbox/*.py`, tests included, so every
    commit touching a test file made EVERY role's server stale, and `--yes` then
    killed the peer's server too. One agent's hygiene became the other's outage.

    A test commit must not invalidate a runtime server. True when nothing runtime
    changed at all: then the newest runtime mtime is older than any server start
    and every server reads FRESH.
    """
    pkg = project_root / "mcp" / "pair_mailbox"
    if not pkg.is_dir():
        return None
    runtime = [p for p in pkg.glob("*.py")
               if not p.name.startswith("test_")
               and p.name != "serve.sh"
               and p.is_file()]
    return newest_source_mtime(runtime)


def scope_rows(rows: list[dict], role: str = "", state_dir: Path | None = None,
               room: bool = False, env: dict | None = None) -> list[dict]:
    """Which servers this restart is allowed to kill (round 106 slice A).

    The defect being fixed: `pairrestart` used to plan every STALE server in the
    state dir, so a writer-side restart killed the peer's server — measured as
    four of twelve restarts in 24h, each taking the neighbour's pair tools down.

    Rules, in order, all fail-closed:
    - `room=True` (an explicit room-wide request) selects every stale role row.
    - otherwise only the NAMED role's rows: `role` if given, else the caller's own
      role as derived by `caller_role()`.
    - a role that has no row yields [] — never a silent fall back to everything.
    - FRESH rows are never in scope, not even room-wide: a fresh server is not
      mine to disturb.
    """
    stale = [r for r in rows if r.get("kind") == "role"
             and r.get("verdict") == "STALE" and r.get("pid")]
    if room:
        return stale
    target = (role or "").strip() or caller_role(state_dir, env)
    if not target:
        return []
    return [r for r in stale if r.get("name") == target]


def caller_role(state_dir: Path | None = None, env: dict | None = None) -> str:
    """The role this invocation belongs to — fail-closed, never guessed.

    Chain, per the peer's ruling (seq 1613): PAIR_ROLE from the environment;
    then TMUX_PANE resolved against the roster's pane fields. Outside any pane
    and with no env, the answer is EMPTY and the caller must be told to name a
    role — the state's writer is a ROLE, not necessarily the caller, and
    defaulting to it is exactly the guess that turns one agent's restart into
    another agent's outage.
    """
    import os
    environ = env if env is not None else os.environ
    env_role = (environ.get("PAIR_ROLE") or "").strip()
    if env_role:
        return env_role
    pane = (environ.get("TMUX_PANE") or "").strip()
    if pane and state_dir is not None:
        try:
            state = json.loads((state_dir / "state.json").read_text(encoding="utf-8")) \
                if (state_dir / "state.json").exists() else {}
        except (OSError, ValueError):
            state = {}
        for name, info in (state.get("roles") or {}).items():
            if not isinstance(info, dict):
                continue
            for field in ("pane", "pane_provisional"):
                value = str(info.get(field) or "")
                if value and value in (pane, "%" + pane.lstrip("%")):
                    return name
    return ""


def pilot_code_mtime() -> float | None:
    try:
        return (ROOT / "bin" / "pairpilot").stat().st_mtime
    except OSError:
        return None


def fmt_ts(ts: float | None) -> str:
    if ts is None:
        return "unknown"
    return datetime.fromtimestamp(ts).astimezone().strftime("%m-%d %H:%M")


def live_servers(state_dir: Path) -> list[dict]:
    """Every pair server of THIS state dir: pid, role, start time.

    ps-sourced, no imports. The `--state` argument decides membership, exactly
    like `pilot_procs` filters pilots below: without it a second project's
    server for the same role answers to this repo's name. That is proven live
    (round 104, peer seq 1536): a galatour `--role omp` server was inventoried
    as this repo's FRESH omp while the real one went stale, and a `--yes` run
    under that inventory kills another project's server.

    `--state dir` and `--state=dir` both parse; a server with no `--state` runs
    on its cwd and is not ours to claim.
    """
    out = subprocess.run(["ps", "-eo", "pid,lstart,etimes,args"],
                         capture_output=True, text=True).stdout or ""
    want = str(state_dir)
    found = []
    for line in out.splitlines():
        if "server.py" not in line or "--role" not in line:
            continue
        parts = line.split()
        if len(parts) < 7:
            continue
        try:
            pid = int(parts[0])
        except ValueError:
            continue
        try:
            role = parts[parts.index("--role") + 1]
        except (ValueError, IndexError):
            continue
        # Both spellings: `--state DIR` as two tokens, `--state=DIR` as one.
        # ps output collapses nothing, so an =form hides in a single part and
        # index-based reading of it picks the NEXT argument instead.
        state = ""
        for i, part in enumerate(parts):
            if part == "--state" and i + 1 < len(parts):
                state = parts[i + 1]
                break
            if part.startswith("--state="):
                state = part[len("--state="):]
                break
        if state != want:
            continue
        start = " ".join(parts[1:6])
        found.append({"pid": pid, "role": role, "start": start})
    return found


def pilot_procs(state_dir: Path) -> list[dict]:
    out = subprocess.run(["ps", "-eo", "pid,lstart,args"],
                         capture_output=True, text=True).stdout or ""
    found = []
    for line in out.splitlines():
        if "pairpilot" not in line or str(state_dir) not in line:
            continue
        parts = line.split()
        if len(parts) < 7:
            continue
        try:
            pid = int(parts[0])
        except ValueError:
            continue
        found.append({"pid": pid, "start": " ".join(parts[1:6])})
    return found


def proc_start_ts(pid: int) -> float | None:
    try:
        return Path(f"/proc/{pid}").stat().st_mtime
    except (OSError, ValueError):
        return None


def diagnose(state_dir: Path) -> list[dict]:
    """One row per checked thing: kind, name, pid, started, code, verdict."""
    rows: list[dict] = []
    # Rider (b), round 106 slice A: staleness is judged on RUNTIME sources only.
    # The old rule took the newest mtime across ALL pair_mailbox/*.py, tests
    # included, so a test commit made every role's server stale and a single
    # `--yes` killed them all — four of twelve restarts in 24 hours, each taking
    # the neighbour's pair tools down.
    code_server = runtime_code_mtime()
    code_pilot = pilot_code_mtime()
    # All servers of this state, grouped by role: one row each, never a
    # dict-by-role that silently keeps only the last line and hides the rest.
    servers: dict[str, list[dict]] = {}
    for srv in live_servers(state_dir):
        servers.setdefault(srv["role"], []).append(srv)
    try:
        import json as _json
        state = _json.loads((state_dir / "state.json").read_text(encoding="utf-8"))
        roles = [r for r in (state.get("roles") or {}) if r in ("omp", "opencode", "agy", "claude", "pi", "codex")]
    except Exception:
        roles = ["omp", "opencode"]
    for role in roles:
        role_servers = servers.get(role) or []
        if not role_servers:
            rows.append({"kind": "role", "name": role, "pid": None,
                         "verdict": "ABSENT",
                         "detail": "no live server — reconnect its MCP when done"})
            continue
        for srv in role_servers:
            started = proc_start_ts(srv["pid"]) or time.time()
            stale = code_server is not None and code_server > started
            rows.append({"kind": "role", "name": role, "pid": srv["pid"],
                         "started": fmt_ts(started), "code": fmt_ts(code_server),
                         "verdict": "STALE" if stale else "FRESH",
                         "detail": "kill, session reconnects" if stale else "leave alone"})
    pilots = pilot_procs(state_dir)
    if not pilots:
        rows.append({"kind": "pilot", "name": "pilot", "pid": None,
                     "verdict": "ABSENT", "detail": "relaunch via pairup"})
    else:
        for proc in pilots:
            started = proc_start_ts(proc["pid"]) or time.time()
            stale = code_pilot is not None and code_pilot > started
            rows.append({"kind": "pilot", "name": "pilot", "pid": proc["pid"],
                         "started": fmt_ts(started), "code": fmt_ts(code_pilot),
                         "verdict": "STALE" if stale else "FRESH",
                         "detail": "kill, then relaunch" if stale else "leave alone"})
    return rows


def print_plan(rows: list[dict]) -> int:
    stale = [r for r in rows if r["verdict"] == "STALE" and r["pid"]]
    print(f"pairrestart — {len(rows)} things checked")
    print()
    for row in rows:
        pid = str(row["pid"]) if row["pid"] else "—"
        extra = f"started {row.get('started')} code {row.get('code')}" if row.get("started") else ""
        print(f"[{row['verdict']:<6}] {row['kind']:<5} {row['name']:<8} pid {pid:<7} {extra} → {row['detail']}")
    print()
    if not stale:
        print("Nothing stale. Changes nothing.")
        return 0
    doomed_roles = [r["name"] for r in stale if r["kind"] == "role"]
    if doomed_roles:
        print("Note: killing a role's server drops that session's pair tools until it")
        print("reconnects its MCP (/mcp, or restart the CLI).")
        print(f"Killing {', '.join(doomed_roles)}'s server is in this plan — confirm it is yours to disturb.")
    print(f"Will kill {len(stale)} process(es). Fresh servers are NOT in this plan.")
    return len(stale)


def ask(explicit_yes: bool) -> bool:
    if explicit_yes:
        return True
    try:
        answer = input("Type 'yes' to continue [y/N]: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    return answer == "yes"


def record_restart(rows: list[dict], state_dir: Path, why: str = "pairrestart") -> None:
    """Leave one durable line the killed role reads on reconnect.

    Written BEFORE the kill: the killed writer must not die before its own
    record lands (a kill that eats its own trace is the round-101 channel-dark
    period). One JSON line per restart, .pair/restarts.jsonl, {ts, why, roles}
    — the newest line is what pair_state surfaces as restarts_last.
    """
    roles = [{"role": r["name"], "pid": r["pid"], "action": "kill"}
             for r in rows if r["verdict"] == "STALE" and r["pid"]]
    if not roles:
        return
    line = json.dumps({"ts": datetime.now(timezone.utc).isoformat(),
                       "why": why, "roles": roles}, ensure_ascii=False)
    try:
        with open(state_dir / "restarts.jsonl", "a", encoding="utf-8") as handle:
            handle.write(line + "\n")
    except OSError as exc:
        print(f"could not record restart trace: {exc}", file=sys.stderr)


def act(rows: list[dict], state_dir: Path) -> None:
    record_restart(rows, state_dir)
    for row in [r for r in rows if r["verdict"] == "STALE" and r["pid"]]:
        pid = row["pid"]
        try:
            os.kill(pid, signal.SIGTERM)
            print(f"killed {row['kind']} {row['name']} pid {pid} (SIGTERM)")
        except (OSError, ProcessLookupError) as exc:
            print(f"could not kill pid {pid}: {exc}")
    waited = 0.0
    while waited < 5.0:
        alive = [r for r in [row for row in rows if row["verdict"] == "STALE" and row["pid"]]
                 if _pid_alive(r["pid"])]
        if not alive:
            break
        time.sleep(0.5)
        waited += 0.5
    if any(r["kind"] == "pilot" for r in rows if r["verdict"] == "STALE"):
        log = state_dir / "pairpilot.log"
        try:
            with open(log, "a") as handle:
                proc = subprocess.Popen([sys.executable, str(ROOT / "bin" / "pairpilot"),
                                         "--state", str(state_dir)],
                                        stdout=handle, stderr=subprocess.STDOUT,
                                        start_new_session=True, cwd=str(ROOT))
            (state_dir / "pilot.pid").write_text(str(proc.pid), encoding="utf-8")
            print(f"pilot relaunched, pid {proc.pid}, log {log}")
        except OSError as exc:
            print(f"pilot relaunch failed: {exc}")


def _pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ProcessLookupError):
        return False


def verify(state_dir: Path) -> int:
    print()
    print("— verify —")
    doctor = ROOT / "bin" / "pairdoctor"
    result = subprocess.run([sys.executable, str(doctor), "--project"],
                            capture_output=True, text=True, cwd=str(ROOT))
    tail = (result.stdout or "").strip().splitlines()[-3:]
    print("\n".join(tail) if tail else "(no doctor output)")
    absent = [r["name"] for r in diagnose(state_dir)
              if r["kind"] == "role" and r["verdict"] == "ABSENT"]
    for role in absent:
        print(f"role {role} has no live server — reconnect its MCP (/mcp, or restart the CLI).")
    return result.returncode


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Restart pair servers that run stale code — per role by default.")
    parser.add_argument("--state", default=None, help="explicit state dir")
    parser.add_argument("--dry-run", action="store_true", help="plan only, change nothing")
    parser.add_argument("--yes", action="store_true", help="skip the question (unattended)")
    parser.add_argument("--role", default="", help="this role only (default: the caller's own)")
    parser.add_argument("--room", action="store_true",
                        help="every stale role — MUST print them all before any kill")
    args = parser.parse_args(argv)
    state_dir = resolve_state(args.state)
    if not (state_dir / "state.json").exists():
        print(f"pairrestart: no state.json in {state_dir} — cd into a project first", file=sys.stderr)
        return 2
    rows = diagnose(state_dir)
    # Round 108 slice 2: a stale role record (a `.server-<role>.pid` whose process
    # is dead) wedges nothing at the kernel level but reads as "held" to every
    # naive tool and to a human reading `ls`. Reap it BEFORE planning, so the
    # row this restart would show is what the system actually is. A LIVE holder's
    # record is kept by construction.
    try:
        sys.path.insert(0, str(ROOT / "mcp" / "pair_mailbox"))
        import lock_reaper as _reaper
        reaped = _reaper.reap(state_dir)
        for name in reaped:
            print(f"pairrestart: reaped a stale lock record for role {name} "
                  f"(its process is gone; the role is free again)")
    except Exception as exc:  # noqa: BLE001 - a reaper failure never blocks the restart
        print(f"pairrestart: lock reaper skipped ({exc})", file=sys.stderr)
    scope = scope_rows(rows, role=args.role, state_dir=state_dir, room=args.room)
    # Fail-closed (round 106 slice A): `pairrestart --yes` used to mean "kill
    # every stale server in the room", which is how my restart became your
    # outage four times in 24 hours. Without a resolvable caller and without
    # --room, the honest answer is a REFUSAL naming what to pass — never a
    # silent fall back to the whole room.
    if not args.room and not (args.role or "").strip():
        if not scope:
            print("pairrestart: no role resolved for this invocation.", file=sys.stderr)
            print("pairrestart: name it — pairrestart --role <omp|opencode|agy|claude|pi|codex>",
                  file=sys.stderr)
            print("pairrestart: or run it inside the role's pane (PAIR_ROLE/TMUX_PANE),",
                  file=sys.stderr)
            print("pairrestart: or --room to restart every stale role, listed before any kill.",
                  file=sys.stderr)
            return 2
    killable = print_plan(rows, only=scope)
    if args.dry_run:
        print("(dry-run: changed nothing)")
        return 0
    if killable == 0:
        return 0
    if not ask_room(args, scope, state_dir):
        print("Aborted. Changed nothing.")
        return 0
    act(scope, state_dir)
    return verify(state_dir)


def ask_room(args, scope: list[dict], state_dir: Path) -> bool:
    """Confirm a restart, with the room's roles named before any kill.

    `--yes` on a SCOPED restart still asks — a single-role kill is cheap and
    reversible, so it waits for the word. `--yes` with `--room` requires the
    list: every role it will disturb is printed FIRST, never after.
    """
    if args.room and args.yes:
        names = ", ".join(r["name"] for r in scope) or "(none stale)"
        print(f"Room-wide restart confirmed by --yes; roles that may be disturbed: {names}")
        return True
    return ask(args.yes)


def print_plan(rows: list[dict], only: list[dict] | None = None) -> int:
    """The plan, and how many rows it will kill. With `only`, the caller sees
    WHICH of the stale room's rows are in scope — a scoped restart must not print
    a room-wide plan and kill a scoped subset (the two truths diverge)."""
    shown = rows if only is None else [r for r in rows if r in only]
    stale = [r for r in shown if r["verdict"] == "STALE" and r.get("pid")]
    print(f"pairrestart — {len(shown)} things checked")
    print()
    for row in shown:
        pid = str(row["pid"]) if row.get("pid") else "—"
        extra = f"started {row.get('started')} code {row.get('code')}" if row.get("started") else ""
        print(f"[{row['verdict']:<6}] {row['kind']:<5} {row['name']:<8} pid {pid:<7} {extra} → {row['detail']}")
    print()
    if only is not None and rows:
        out_of_scope = [r["name"] for r in rows
                       if r.get("kind") == "role" and r not in only
                       and r["verdict"] == "STALE" and r.get("pid")]
        if out_of_scope:
            print(f"Left out of scope (not yours to disturb): {', '.join(out_of_scope)}")
            print("A scoped restart never touches a peer's server — it reconnects on its own schedule.")
            print()
    if not stale:
        print("Nothing stale in scope. Changes nothing.")
        return 0
    doomed_roles = [r["name"] for r in stale if r["kind"] == "role"]
    if doomed_roles:
        print("Note: killing a role's server drops that session's pair tools until it")
        print("reconnects its MCP (/mcp, or restart the CLI).")
        print(f"Killing {', '.join(doomed_roles)}'s server is in this plan — confirm it is yours to disturb.")
    print(f"Will kill {len(stale)} process(es). Fresh servers are NOT in this plan.")
    return len(stale)


if __name__ == "__main__":
    sys.exit(main())
