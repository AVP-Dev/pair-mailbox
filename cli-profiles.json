{
  "_readme": "Форматы MCP и навыков по CLI. Роль сервера = имя CLI. Добавить свой CLI = добавить сюда объект и запустить ./install.sh <имя>. Поле launch — команда, которой bin/pairpilot поднимает роль, если её процесс умер (см. PROTOCOL.md §13). Поле timeout в записи mcp — это терпение клиента, и оно обязано быть больше MAX_READ_WAIT_SECONDS (60с) с запасом: pair_read умеет ждать до минуты, и клиент, рвущий вызов раньше, обрывает живое ожидание пополам (docs/backlog/read-wait-exceeds-client-timeout.md).",

  "opencode": {
    "launch": "opencode --standalone --auto",
    "label": "OpenCode",
    "mcp": {
      "path": "~/.config/opencode/opencode.jsonc",
      "format": "json",
      "root_key": "mcp",
      "entry": { "type": "local", "command": [], "enabled": true, "timeout": 65000 }
    },
    "skills_dir": "~/.config/opencode/skills",
    "instructions": "~/.config/opencode/AGENTS.md"
  },

  "agy": {
    "launch": "agy",
    "label": "Antigravity CLI",
    "mcp": {
      "path": "~/.gemini/config/mcp_config.json",
      "format": "json",
      "root_key": "mcpServers",
      "entry": { "command": "", "args": [], "timeout": 65000 }
    },
    "skills_dir": "~/.gemini/config/skills",
    "instructions": "~/.gemini/AGENTS.md"
  },

  "codex": {
    "launch": "codex",
    "label": "Codex CLI",
    "mcp": {
      "path": "~/.codex/config.toml",
      "format": "toml",
      "entry": { "command": "", "args": [], "timeout": 65000 }
    },
    "skills_dir": "~/.codex/skills",
    "instructions": "~/.codex/AGENTS.md"
  },

  "claude": {
    "launch": "claude",
    "label": "Claude Code",
    "mcp": {
      "path": "~/.claude.json",
      "format": "json",
      "root_key": "mcpServers",
      "entry": { "command": "", "args": [], "timeout": 65000 }
    },
    "skills_dir": "~/.claude/skills",
    "instructions": "~/.claude/CLAUDE.md"
  },
  "pi": {
    "launch": "pi",
    "label": "Pi Coding Agent",
    "mcp": {
      "path": "~/.pi/agent/mcp.json",
      "format": "json",
      "root_key": "mcpServers",
      "entry": { "command": "sh", "args": [], "timeout": 65000 }
    },
    "skills_dir": "~/.pi/agent/skills",
    "instructions": "~/.pi/agent/AGENTS.md"
  },
  "omp": {
    "launch": "omp",
    "label": "OMP Coding Agent",
    "binary": "omp",
    "mcp": {
      "path": "~/.pi/agent/mcp.json",
      "format": "json",
      "root_key": "mcpServers",
      "server_key": "pair-omp",
      "entry": { "command": "sh", "args": [], "timeout": 65000 }
    },
    "skills_dir": "~/.pi/agent/skills",
    "instructions": "~/.pi/agent/AGENTS.md"
  }
}
