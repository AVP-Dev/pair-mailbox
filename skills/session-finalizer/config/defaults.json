{
  "marker": ".session/finalized",
  "protected_branches": ["main", "master", "develop", "dev", "trunk", "staging"],
  "protected_patterns": ["main*", "master", "develop*", "dev", "dev/*", "trunk", "release/*", "hotfix/*", "staging", "staging/*"],
  "temp_patterns": ["*.tmp", "*.bak", "*~", ".DS_Store", "*.swp", "*.orig", "*.rej"],
  "temp_dirs": ["/tmp/opencode"],
  "agents_config_overrides": {},
  "hosting": {
    "providers": ["gh", "glab"],
    "fallback": "UNKNOWN"
  },
  "close_order": ["critic", "explorer", "writer"],
  "todos_markers": ["TODO", "FIXME", "XXX", "HACK"],
  "checks_slots": ["test", "lint", "build", "typecheck"],
  "session_config": ".session/finalizer.json",
  "marker_exempt": [".session/finalized"],
  "secrets_guards": ["*secret*", "*.pem", "*.key", ".env", "*credential*"]
}
